@@ -0,0 +1,375 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Fixed-mode goyawifi LCD/DSI host initialization and CMA scanout. */
+#include <linux/aperture.h>
+#include <linux/backlight.h>
+#include <linux/t110-board.h>
