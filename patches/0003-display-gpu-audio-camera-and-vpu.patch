@@ -0,0 +1,520 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T110 VX5B3D panel supplies, MIPI initialization and backlight control. */
+#include <linux/backlight.h>
+#include <linux/t110-board.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/gpio/consumer.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+
+#define PWM_PERIOD 0x160
+#define PWM_DUTY 0x164
+#define PWM_ENABLE 0x15c
+#define LVDS_ENABLE 0x604
+#define PWM_PIN 0x138
+#define MAX_DUTY 2032
+
+struct t110_bl {
+	struct i2c_client *client;
+	struct mutex lock;
+	u32 period, pin, lvds;
+	u32 duty;
+	bool blank;
+	struct gpio_desc *panel_en,*led_en,*bridge_en,*reset;
+	struct device *pmic_dev;
+	struct regmap *power;
+	void __iomem *dsi;
+	u32 dsi_ctrl,dsi_clock,dsi_lanes,dsi_cmd1;
+	struct regulator *core,*io;
+	bool powered,core_on,io_on;
+	unsigned int power_cycles;
+ unsigned int cold_starts;
+ unsigned int last_off_enable;
+ bool sleep_powercut,resume_programmed;
+ unsigned int suspend_offs,suspend_resumes;
+};
+static bool cold_init=true;
+module_param(cold_init,bool,0444);
+static void release_device(void *data){put_device(data);}
+
+static int vx_read(struct t110_bl *t, u16 reg, u32 *value)
+{
+ u8 addr[]={0x09,0x29,0x05,0x01,0x41,reg&0xff,reg>>8,4,0};
+ u8 request[]={0x09,0x24,0x05,0x01},data[4];
+ struct i2c_msg msgs[]={
+  {.addr=t->client->addr,.len=sizeof(addr),.buf=addr},
+  {.addr=t->client->addr,.len=sizeof(request),.buf=request},
+  {.addr=t->client->addr,.flags=I2C_M_RD,.len=sizeof(data),.buf=data},
+ };
+ int ret=0,i;
+ i2c_lock_bus(t->client->adapter,I2C_LOCK_SEGMENT);
+ /* Separate transfers preserve the vendor's STOP boundaries. */
+ for(i=0;i<ARRAY_SIZE(msgs);i++){
+  ret=__i2c_transfer(t->client->adapter,&msgs[i],1);
+  if(ret!=1)break;
+ }
+ i2c_unlock_bus(t->client->adapter,I2C_LOCK_SEGMENT);
+ if(ret!=1){
+  dev_err_ratelimited(&t->client->dev,"CSR read %03x phase %d failed %d\n",reg,i,ret);
+  return ret<0?ret:-EIO;
+ }
+ *value=(u32)data[0]|(u32)data[1]<<8|(u32)data[2]<<16|(u32)data[3]<<24;
+ return 0;
+}
+
+static u8 dsi_ecc(const u8 *data)
+{
+ static const u32 masks[]={0xf12cb7,0xf2555b,0x749a6d,0xb8e38e,0xdf03f0,0xeffc00};
+ u32 bits=data[0]|data[1]<<8|data[2]<<16;u8 ecc=0;
+ for(int i=0;i<6;i++)ecc|=(hweight32(bits&masks[i])&1)<<i;
+ return ecc;
+}
+static int __maybe_unused vx_release(struct t110_bl *t)
+{
+ u8 release=0;int ret=i2c_master_send(t->client,&release,1);
+ return ret==1?0:ret<0?ret:-EIO;
+}
+static int vx_mipi_write(struct t110_bl *t,u16 reg,u32 value)
+{
+ u8 data[]={0x29,9,0,0,5,1,0x40,reg&255,reg>>8,value&255,value>>8,value>>16,value>>24,0,0};
+ u16 crc=0xffff;u32 status;int ret;
+ data[3]=dsi_ecc(data);
+ for(int i=4;i<13;i++)for(int b=0;b<8;b++)crc=((crc^(data[i]>>b))&1)?(crc>>1)^0x8408:crc>>1;
+ data[13]=crc&255;data[14]=crc>>8;
+ for(int i=0;i<sizeof(data);i+=4) {
+  u32 word=0;for(int b=0;b<4&&i+b<sizeof(data);b++)word|=(u32)data[i+b]<<(b*8);
+  writel(word,t->dsi+0x30);writel(BIT(31)|BIT(30)|(i<<16),t->dsi+0x2c);
+  ret=readl_poll_timeout(t->dsi+0x2c,status,!(status&BIT(31)),1,50000);if(ret)return ret;
+
+ }
+ writel(BIT(31)|BIT(27)|sizeof(data),t->dsi+0x20);
+ ret=readl_poll_timeout(t->dsi+0x20,status,!(status&BIT(31)),1,50000);
+ if(ret)dev_err(&t->client->dev,"MIPI write %03x timed out: %08x\n",reg,status);
+ udelay(1);return ret;
+}
+static int vx_write(struct t110_bl *t, u16 reg, u32 value)
+{
+	u8 msg[] = {0x09, 0x29, 0x05, 0x01, 0x40, reg & 0xff, reg >> 8,
+		value & 0xff, value >> 8, value >> 16, value >> 24};
+	int ret;
+	ret = i2c_master_send(t->client, msg, sizeof(msg));
+	return ret == sizeof(msg) ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static int panel_off(struct t110_bl *t);
+static int panel_on(struct t110_bl *t,int target);
+static int t110_bl_update(struct backlight_device *bl)
+{
+	struct t110_bl *t = bl_get_data(bl);
+	u32 target = backlight_get_brightness(bl), check, lvds;
+	int ret;
+
+	mutex_lock(&t->lock);
+	if(!target) {
+		ret=t->powered?panel_off(t):0;
+		if(!ret){t->duty=0;t->blank=true;}
+		goto out;
+	}
+	if(!t->powered) {
+		ret=panel_on(t,target);
+		if(!ret){t->duty=target;t->blank=false;}
+		goto out;
+	}
+	ret = vx_read(t, LVDS_ENABLE, &lvds);
+	if (ret)
+		goto out;
+	if (lvds != t->lvds) {
+		ret = -EIO;
+		goto out;
+	}
+	ret = vx_write(t, PWM_DUTY, target);
+	if (ret)goto out;
+	ret = vx_write(t, PWM_ENABLE, 5);
+	if (ret)goto out;
+	ret = vx_read(t, PWM_DUTY, &check);
+	if (!ret && check != target)
+		ret = -EIO;
+	if (!ret) ret = vx_read(t, PWM_ENABLE, &check);
+	if (!ret && check != (target ? 5 : 0)) ret = -EIO;
+	if (!ret) ret = vx_read(t, LVDS_ENABLE, &check);
+	if (!ret && check != (target ? t->lvds : 0x3fffffff)) ret = -EIO;
+	if (!ret) {
+		t->duty = target;
+		t->blank = !target;
+	}
+out:
+	mutex_unlock(&t->lock);
+	return ret;
+}
+
+static int t110_bl_get(struct backlight_device *bl)
+{
+	struct t110_bl *t = bl_get_data(bl);
+	u32 duty, enable;
+	int ret;
+	mutex_lock(&t->lock);
+	if(!t->powered){mutex_unlock(&t->lock);return 0;}
+	ret = vx_read(t, PWM_DUTY, &duty);
+	if (!ret)
+		ret = vx_read(t, PWM_ENABLE, &enable);
+	mutex_unlock(&t->lock);
+	return ret ? ret : enable == 5 ? duty : 0;
+}
+
+static const struct backlight_ops t110_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = t110_bl_update,
+	.get_brightness = t110_bl_get,
+};
+struct vx_reg {u16 reg;u32 value;};
+/* Samsung GOYA 48.05MHz sequence, matching every programmable field
+ * captured on this board. PWM/LVDS stay disabled until final restore. */
+static const struct vx_reg init_pll[]={
+ {0x700,0x6c900040},{0x704,0x3040a},{0x70c,0x4604},{0x710,0x054d000b},
+ {0x714,0x20},{0x718,0x102},{0x71c,0xa8002f},{0x720,0},
+ {0x154,0},{0x154,0x80000000}
+};
+static const struct vx_reg init_video[]={
+ {0x37c,0x1063},{0x380,0x82a86030},{0x384,0x2861408b},{0x388,0x130285},
+ {0x38c,0x10630009},{0x394,0x400b82a8},{0x600,0x016cc78c},
+ {0x604,0x3fffffff},{0x608,0xd8c},{0x154,0},{0x154,0x80000000},
+ {0x120,5},{0x124,0x1892c400},{0x128,0x102806},{0x12c,0x62},
+ {0x130,0x3c18},{0x134,0x15},{0x138,0xff8000},{0x13c,0},
+ {0x114,0xc6302},{0x140,0x10000},{0x174,0},{0x404,0x55550822},
+ {0x418,0x555502ff},{0x410,0x05e50300},{0x20c,0x124},{0x21c,0},
+ {0x224,7},{0x228,0x50001},{0x22c,0xff03},{0x230,1},{0x234,0xca033e10},
+ {0x238,0x60},{0x23c,0x82e86030},{0x244,0x1e0285},{0x258,0x60062},
+ {0x400,0},{0x160,2040},{0x164,0},{0x15c,0},{0x158,0},{0x158,1}
+};
+static int vx_table(struct t110_bl *t,const struct vx_reg *regs,int count)
+{
+ for(int i=0;i<count;i++){int ret=vx_mipi_write(t,regs[i].reg,regs[i].value);if(ret)return ret;}
+ return 0;
+}
+static int vx_initialize(struct t110_bl *t)
+{
+ int ret=vx_table(t,init_pll,ARRAY_SIZE(init_pll));if(ret)return ret;
+ usleep_range(1000,2000);
+ ret=vx_mipi_write(t,0x700,0x6c900840);if(ret)return ret;
+ ret=vx_mipi_write(t,0x70c,0x5e56);if(ret)return ret;
+ ret=vx_mipi_write(t,0x718,0x202);if(ret)return ret;
+ ret=vx_mipi_write(t,0x154,0);if(ret)return ret;
+ ret=vx_mipi_write(t,0x154,0x80000000);if(ret)return ret;
+ usleep_range(1000,2000);
+ ret=vx_table(t,init_video,ARRAY_SIZE(init_video));if(ret)return ret;
+ msleep(10);return 0;
+}
+/* Called only while I2C1 is parked/locked and touch is quiescent. All
+ * register programming here uses DSI; regulator accesses use PMIC I2C2. */
+static int bridge_cold_action(void *data)
+{
+ struct t110_bl *t=data;unsigned int enabled;int ret,saved_error=0;
+ gpiod_set_value_cansleep(t->led_en,0);gpiod_set_value_cansleep(t->panel_en,0);
+ gpiod_set_value_cansleep(t->reset,0);udelay(20);
+ gpiod_set_value_cansleep(t->bridge_en,0);
+ if(t->io_on){ret=regulator_disable(t->io);if(ret){saved_error=ret;goto restore_power;}t->io_on=false;}
+ if(t->core_on){ret=regulator_disable(t->core);if(ret){saved_error=ret;goto restore_power;}t->core_on=false;}
+ ret=regmap_read(t->power,0x52,&enabled);if(ret){saved_error=ret;goto restore_power;}
+ t->last_off_enable=enabled;
+ dev_info(&t->client->dev,"T110_BRIDGE: cold rails off enable52=%02x bridge=%d reset=%d\n",
+          enabled,gpiod_get_value_cansleep(t->bridge_en),gpiod_get_value_cansleep(t->reset));
+ if(enabled&0x09){saved_error=-EBUSY;goto restore_power;}
+ msleep(350);
+restore_power:
+ /* Restore supplies and reset/program the bridge even if the off-state
+  * check failed; do not reconnect a deliberately unpowered I2C slave. */
+ if(!t->core_on){ret=regulator_enable(t->core);if(ret)return ret;t->core_on=true;}
+ if(!t->io_on){ret=regulator_enable(t->io);if(ret)return ret;t->io_on=true;}
+ gpiod_set_value_cansleep(t->bridge_en,1);msleep(10);
+ gpiod_set_value_cansleep(t->reset,0);udelay(20);
+ gpiod_set_value_cansleep(t->reset,1);usleep_range(1000,2000);
+ msleep(32);ret=vx_initialize(t);
+ return ret?ret:saved_error;
+}
+static int bridge_touch_transaction(void *data)
+{
+ struct t110_bl *t=data;struct device *dev;int ret;
+ dev=bus_find_device_by_name(&i2c_bus_type,NULL,"1-0020");
+ if(!dev)return -EPROBE_DEFER;
+ ret=zinitix_goya_bridge_bootstrap(to_i2c_client(dev),bridge_cold_action,t);
+ put_device(dev);return ret;
+}
+static int bridge_cold_start(struct t110_bl *t)
+{
+ u32 check;int ret;
+ /* No I2C bridge transaction is required before power/reset. DSI and DRM
+  * are serialized and the I2C provider restores pins on every exit. */
+ ret=t110_display_bootstrap(bridge_touch_transaction,t);
+ if(ret)return ret;
+ ret=vx_read(t,0x704,&check);if(ret)return ret;
+ if(check!=0x3040a)return -EIO;
+ ret=vx_read(t,0x124,&check);if(ret)return ret;
+ if(check!=0x1892c400)return -EIO;
+ ret=vx_read(t,PWM_PERIOD,&check);if(ret)return ret;
+ if(check!=2040)return -EIO;
+ ret=vx_read(t,LVDS_ENABLE,&check);if(ret)return ret;
+ if(check!=0x3fffffff)return -EIO;
+ t->powered=false;t->cold_starts++;
+ dev_info(&t->client->dev,"T110_BRIDGE: cold initialization/readback passed, starts=%u\n",t->cold_starts);
+ return 0;
+}
+static void panel_cut_power(struct t110_bl *t)
+{
+ gpiod_set_value_cansleep(t->led_en,0);gpiod_set_value_cansleep(t->panel_en,0);
+ writel(0,t->dsi);readl(t->dsi);writel(t->dsi_lanes&~0xf0,t->dsi+0x88);writel(0,t->dsi+0x84);
+ gpiod_set_value_cansleep(t->reset,0);udelay(20);
+ gpiod_set_value_cansleep(t->bridge_en,0);
+ if(t->io_on&&!regulator_disable(t->io))t->io_on=false;
+ if(t->core_on&&!regulator_disable(t->core))t->core_on=false;
+ t->powered=false;
+}
+static int panel_off(struct t110_bl *t)
+{
+ int ret;
+ ret=vx_write(t,PWM_DUTY,0);if(ret)return ret;
+ ret=vx_write(t,PWM_ENABLE,0);if(ret)return ret;
+ msleep(100);ret=vx_write(t,LVDS_ENABLE,0x3fffffff);if(ret)return ret;
+ msleep(30);
+ i2c_lock_bus(t->client->adapter,I2C_LOCK_SEGMENT);
+ /* Touch remains active for tap-to-wake on this shared bus. Vendor full
+  * power-off parks I2C pins and suspends touch; do not remove bridge rails
+  * in this runtime screen-off path. */
+ gpiod_set_value_cansleep(t->led_en,0);gpiod_set_value_cansleep(t->panel_en,0);
+
+ t->powered=false;
+ i2c_unlock_bus(t->client->adapter,I2C_LOCK_SEGMENT);
+ dev_info(&t->client->dev,"panel off: panel/LED/LVDS off; bridge and DSI retained for DRM/touch\n");
+ return 0;
+}
+static int panel_on(struct t110_bl *t,int target)
+{
+ int ret;u32 check;unsigned int enabled;
+ /* Runtime wake retains bridge state until touch/I2C suspend is coordinated. */
+
+ t->powered=true;
+ ret=vx_read(t,0x704,&check);if(ret||check!=0x3040a){ret=ret?:-EIO;goto cut;}
+ ret=vx_read(t,0x124,&check);if(ret||check!=0x1892c400){ret=ret?:-EIO;goto cut;}
+ gpiod_set_value_cansleep(t->panel_en,1);gpiod_set_value_cansleep(t->led_en,1);msleep(5);
+ ret=vx_write(t,LVDS_ENABLE,t->lvds);if(ret)goto cut;
+ msleep(110);ret=vx_write(t,PWM_PIN,t->pin);if(ret)goto cut;
+ ret=vx_write(t,PWM_DUTY,target);if(ret)goto cut;
+ ret=vx_write(t,PWM_ENABLE,target?5:0);if(ret)goto cut;
+ ret=vx_read(t,PWM_DUTY,&check);if(ret||check!=target){ret=ret?:-EIO;goto cut;}
+ ret=vx_read(t,PWM_ENABLE,&check);if(ret||check!=5){ret=ret?:-EIO;goto cut;}
+ ret=vx_read(t,LVDS_ENABLE,&check);if(ret||check!=t->lvds){ret=ret?:-EIO;goto cut;}
+ ret=regmap_read(t->power,0x52,&enabled);if(ret)goto cut;
+ if((enabled&0x09)!=0x09){ret=-EIO;goto cut;}
+ t->power_cycles++;dev_info(&t->client->dev,"panel on: retained bridge/readback passed, cycle=%u\n",t->power_cycles);
+ return 0;
+cut:
+ i2c_lock_bus(t->client->adapter,I2C_LOCK_SEGMENT);
+ panel_cut_power(t);i2c_unlock_bus(t->client->adapter,I2C_LOCK_SEGMENT);
+ dev_err(&t->client->dev,"panel power-on failed: %d\n",ret);return ret;
+}
+static int bridge_pm_cut(void *data)
+{
+ struct t110_bl *t=data;unsigned int enabled;int ret;
+ gpiod_set_value_cansleep(t->led_en,0);gpiod_set_value_cansleep(t->panel_en,0);
+ gpiod_set_value_cansleep(t->reset,0);udelay(20);
+ gpiod_set_value_cansleep(t->bridge_en,0);
+ if(t->io_on){ret=regulator_disable(t->io);if(ret)return ret;t->io_on=false;}
+ if(t->core_on){ret=regulator_disable(t->core);if(ret)return ret;t->core_on=false;}
+ ret=regmap_read(t->power,0x52,&enabled);if(ret)return ret;
+ t->last_off_enable=enabled;
+ if(enabled&0x09)return -EBUSY;
+ t->powered=false;t->resume_programmed=false;t->suspend_offs++;
+ msleep(350);
+ dev_info(&t->client->dev,"T110_BRIDGE_PM: rails off for suspend enable52=%02x bridge=%d reset=%d count=%u\n",
+          enabled,gpiod_get_value_cansleep(t->bridge_en),gpiod_get_value_cansleep(t->reset),t->suspend_offs);
+ return 0;
+}
+static int bridge_pm_program(void *data)
+{
+ struct t110_bl *t=data;int ret;
+ if(!t->core_on){ret=regulator_enable(t->core);if(ret)return ret;t->core_on=true;}
+ if(!t->io_on){ret=regulator_enable(t->io);if(ret)return ret;t->io_on=true;}
+ gpiod_set_value_cansleep(t->bridge_en,1);msleep(10);
+ gpiod_set_value_cansleep(t->reset,0);udelay(20);
+ gpiod_set_value_cansleep(t->reset,1);usleep_range(1000,2000);
+ msleep(32);ret=vx_initialize(t);
+ if(!ret){t->powered=false;t->resume_programmed=true;}
+ return ret;
+}
+static int bridge_pm_bootstrap(void *data)
+{return t110_display_resume_bridge(bridge_pm_program,data);}
+static int bridge_suspend_late(struct device *dev)
+{
+ struct backlight_device *bl=dev_get_drvdata(dev);struct t110_bl *t=bl_get_data(bl);int ret;
+ if(!cold_init)return 0;
+ mutex_lock(&t->lock);
+ if(t->powered){ret=-EBUSY;goto out;}
+ ret=i2c_pxa_goya_bridge_suspend(t->client->adapter,bridge_pm_cut,
+                               bridge_pm_bootstrap,t,THIS_MODULE);
+ if(!ret)t->sleep_powercut=true;
+out:
+ mutex_unlock(&t->lock);return ret;
+}
+static int bridge_resume_early(struct device *dev)
+{
+ struct backlight_device *bl=dev_get_drvdata(dev);struct t110_bl *t=bl_get_data(bl);u32 check;int ret=0;
+ mutex_lock(&t->lock);
+ if(!t->sleep_powercut)goto out;
+ if(!t->resume_programmed){ret=-EIO;goto out;}
+ ret=vx_read(t,0x704,&check);if(ret)goto out;
+ if(check!=0x3040a){ret=-EIO;goto out;}
+ ret=vx_read(t,0x124,&check);if(ret)goto out;
+ if(check!=0x1892c400){ret=-EIO;goto out;}
+ ret=vx_read(t,PWM_PERIOD,&check);if(ret)goto out;
+ if(check!=2040){ret=-EIO;goto out;}
+ ret=vx_read(t,LVDS_ENABLE,&check);if(ret)goto out;
+ if(check!=0x3fffffff){ret=-EIO;goto out;}
+ t->sleep_powercut=false;t->resume_programmed=false;
+ t->cold_starts++;t->suspend_resumes++;
+ dev_info(dev,"T110_BRIDGE_PM: resume register check passed count=%u\n",t->suspend_resumes);
+out:
+ mutex_unlock(&t->lock);return ret;
+}
+static const struct dev_pm_ops bridge_pm_ops={
+ .suspend_late=bridge_suspend_late,.resume_early=bridge_resume_early,
+};
