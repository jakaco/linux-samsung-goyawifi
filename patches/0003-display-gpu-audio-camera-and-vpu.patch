diff --git a/drivers/gpu/drm/etnaviv/etnaviv_t110.c b/drivers/gpu/drm/etnaviv/etnaviv_t110.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/etnaviv/etnaviv_t110.c
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0
+/* Board-scoped SM-T110 GC1000 devfreq. Busy time is the union of queued
+ * hardware-job intervals through fence IRQ completion, not CPU load.
+ */
+#include <linux/clk.h>
+#include <linux/devfreq.h>
+#include <linux/moduleparam.h>
+#include <linux/of.h>
+#include <linux/pm_opp.h>
+#include <linux/pm_qos.h>
+#include <linux/pm_runtime.h>
+#include <linux/spinlock.h>
+#include <linux/ktime.h>
+#include "etnaviv_gpu.h"
+#include "etnaviv_t110.h"
+
+static bool t110_auto;
+module_param(t110_auto,bool,0444);
+struct etnaviv_t110 {
+	struct etnaviv_gpu *gpu;
+	struct devfreq *df;
+	struct devfreq_dev_profile profile;
+	struct devfreq_simple_ondemand_data governor;
+	struct dev_pm_qos_request thermal_qos;
+	spinlock_t lock;
+	u64 last,sample,busy_ns;
+	u64 submitted,completed;
+	unsigned int jobs,util,transitions;
+};
+static const unsigned long rates[]={156000000,312000000,416000000,624000000};
+static void account(struct etnaviv_t110 *d,u64 t)
+{
+	if(d->jobs)d->busy_ns+=t-d->last;
+	d->last=t;
+}
+void etnaviv_t110_busy(struct etnaviv_gpu *gpu,int delta)
+{
+	struct etnaviv_t110 *d=READ_ONCE(gpu->t110);
+	unsigned long flags;
+	if(!d)return;
+	spin_lock_irqsave(&d->lock,flags);account(d,ktime_get_ns());
+	if(delta>0){d->jobs++;d->submitted++;}
+	else if(d->jobs){d->jobs--;d->completed++;}
+	spin_unlock_irqrestore(&d->lock,flags);
+}
+void etnaviv_t110_reset(struct etnaviv_gpu *gpu)
+{
+	struct etnaviv_t110 *d=gpu->t110;
+	unsigned long flags;
+	if(!d)return;
+	spin_lock_irqsave(&d->lock,flags);account(d,ktime_get_ns());d->jobs=0;
+	spin_unlock_irqrestore(&d->lock,flags);
+}
+static int target(struct device *dev,unsigned long *freq,u32 flags)
+{
+	struct etnaviv_gpu *gpu=dev_get_drvdata(dev);
+	struct dev_pm_opp *opp;
+	unsigned long before;
+	int ret,active;
+	opp=devfreq_recommended_opp(dev,freq,flags);
+	if(IS_ERR(opp))return PTR_ERR(opp);
+	dev_pm_opp_put(opp);
+	/* Taking an existing runtime reference prevents suspend during a live
+ * transition. A suspended GPU only updates the provider's resume target.
+ */
+	active=pm_runtime_get_if_in_use(dev);if(active<0)return active;
+	mutex_lock(&gpu->lock);
+	before=clk_get_rate(gpu->clk_core);
+	ret=clk_set_rate(gpu->clk_core,*freq);
+	*freq=clk_get_rate(gpu->clk_core);
+	if(!ret){
+		gpu->fe_waitcycles=clamp(*freq>>15,200UL,0xffffUL);
+		if(before!=*freq)gpu->t110->transitions++;
+	}
+	mutex_unlock(&gpu->lock);
+	if(active)pm_runtime_put_autosuspend(dev);
+	return ret;
+}
+static int status(struct device *dev,struct devfreq_dev_status *s)
+{
+	struct etnaviv_gpu *gpu=dev_get_drvdata(dev);
+	struct etnaviv_t110 *d=gpu->t110;
+	u64 t=ktime_get_ns(),total,busy;
+	unsigned long flags;
+	spin_lock_irqsave(&d->lock,flags);account(d,t);
+	total=t-d->sample;busy=min(d->busy_ns,total);
+	d->sample=t;d->busy_ns=0;d->util=total?div64_u64(busy*100,total):0;
+	spin_unlock_irqrestore(&d->lock,flags);
+	s->current_frequency=clk_get_rate(gpu->clk_core);
+	s->total_time=min_t(u64,div_u64(total,1000),ULONG_MAX);
+	s->busy_time=min_t(u64,div_u64(busy,1000),ULONG_MAX);
+	return 0;
+}
+static int get_current_freq(struct device *dev,unsigned long *freq)
+{
+	struct etnaviv_gpu *gpu=dev_get_drvdata(dev);
+	*freq=clk_get_rate(gpu->clk_core);return 0;
+}
+static ssize_t gpu_load_show(struct device *dev,struct device_attribute *attr,char *buf)
+{
+	struct etnaviv_gpu *gpu=dev_get_drvdata(dev);
+	struct etnaviv_t110 *d=gpu->t110;
+	unsigned long flags;
+	int n;
+	spin_lock_irqsave(&d->lock,flags);
+	n=sysfs_emit(buf,"utilization_pct=%u active_jobs=%u submitted=%llu completed=%llu transitions=%u thermal_state=%u\n",d->util,d->jobs,d->submitted,d->completed,d->transitions,gpu->freq_scale);
+	spin_unlock_irqrestore(&d->lock,flags);return n;
+}
+static DEVICE_ATTR_RO(gpu_load);
+int etnaviv_t110_cooling(struct etnaviv_gpu *gpu,unsigned long state)
+{
+	int ret=0;
+	if(state>3)return -EINVAL;
+	if(gpu->t110)ret=dev_pm_qos_update_request(&gpu->t110->thermal_qos,rates[3-state]/1000);
+	if(ret<0)return ret;
+	gpu->freq_scale=state;return 0;
+}
+int etnaviv_t110_init(struct etnaviv_gpu *gpu)
+{
+	struct etnaviv_t110 *d;
+	int i,ret;
+	if(!of_machine_is_compatible("samsung,goyawifi") ||
+	   !of_property_read_bool(gpu->dev->of_node,"samsung,t110-gpu-scaling"))return 0;
+	if(gpu->identity.model!=0x1000 || gpu->identity.revision!=0x5037)return -ENODEV;
+	d=kzalloc(sizeof(*d),GFP_KERNEL);if(!d)return -ENOMEM;
+	d->gpu=gpu;spin_lock_init(&d->lock);d->last=d->sample=ktime_get_ns();
+	for(i=0;i<ARRAY_SIZE(rates);i++){
+		ret=dev_pm_opp_add(gpu->dev,rates[i],1175000);if(ret)goto opp_fail;
+	}
+	ret=dev_pm_qos_add_request(gpu->dev,&d->thermal_qos,DEV_PM_QOS_MAX_FREQUENCY,rates[3-gpu->freq_scale]/1000);
+	if(ret<0)goto opp_fail;
+	d->profile=(struct devfreq_dev_profile){.initial_freq=156000000,.polling_ms=100,.target=target,.get_dev_status=status,.get_cur_freq=get_current_freq};
+	d->governor=(struct devfreq_simple_ondemand_data){.upthreshold=40,.downdifferential=20};
+	WRITE_ONCE(gpu->t110,d);
+	d->df=devfreq_add_device(gpu->dev,&d->profile,t110_auto?DEVFREQ_GOV_SIMPLE_ONDEMAND:DEVFREQ_GOV_USERSPACE,&d->governor);
+	if(IS_ERR(d->df)){ret=PTR_ERR(d->df);goto qos_fail;}
+	ret=device_create_file(gpu->dev,&dev_attr_gpu_load);
+	if(ret){devfreq_remove_device(d->df);goto qos_fail;}
+	dev_info(gpu->dev,"T110_GPU_U: 156/312/416/624MHz devfreq, shared VL2 floor; auto=%u\n",t110_auto);
+	return 0;
+qos_fail:
+	WRITE_ONCE(gpu->t110,NULL);dev_pm_qos_remove_request(&d->thermal_qos);
+opp_fail:
+	while(i--)dev_pm_opp_remove(gpu->dev,rates[i]);
+	kfree(d);return ret;
+}
+void etnaviv_t110_fini(struct etnaviv_gpu *gpu)
+{
+	struct etnaviv_t110 *d=gpu->t110;
+	int i;
+	if(!d)return;
+	device_remove_file(gpu->dev,&dev_attr_gpu_load);devfreq_remove_device(d->df);
+	dev_pm_qos_remove_request(&d->thermal_qos);
+	WRITE_ONCE(gpu->t110,NULL);
+	/* Unbind already requires no new submissions. Drain its IRQ readers. */
+	synchronize_irq(gpu->irq);
+	for(i=0;i<ARRAY_SIZE(rates);i++)dev_pm_opp_remove(gpu->dev,rates[i]);
+	kfree(d);
+}
