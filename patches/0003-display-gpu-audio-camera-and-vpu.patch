+#include <drm/drm_managed.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_modeset_helper.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+
+#define GRA_ADDR 0x0f4
+#define GRA_PITCH 0x0fc
+#define GRA_SIZE 0x104
+#define DMA_CTRL 0x190
+#define IRQ_ENA 0x1c0
+#define IRQ_ISR 0x1c4
+#define VSYNC BIT(23)
+
+struct t110_drm {
+ struct drm_device drm;
+ struct drm_simple_display_pipe pipe;
+ struct drm_connector connector;
+ struct drm_display_mode mode;
+ void __iomem *regs;
+ void __iomem *dsi,*lcd_clk,*dsi_clk;
+ struct device_link *panel_link;
+ int irq;
+ unsigned int host_starts;
+ struct mutex bootstrap_lock;
+ bool system_suspended,bridge_host_ready;
+ spinlock_t irq_lock;
+ u32 boot_addr, boot_pitch;
+ u32 sleep_dma;
+};
+static struct t110_drm *bootstrap_host;
+static bool linux_init=true;
+module_param(linux_init,bool,0444);
+MODULE_PARM_DESC(linux_init,"Initialize fixed LCD/DSI host instead of retaining bootloader state");
+static inline struct t110_drm *to_t110(struct drm_device *d)
+{ return container_of(d,struct t110_drm,drm); }
+
+static void t110_start_host(struct t110_drm *t,u32 addr,u32 pitch)
+{
+ t110_host_program(t->regs,t->dsi,t->lcd_clk,t->dsi_clk,addr,pitch);
+ t->host_starts++;
+ dev_info(t->drm.dev,"T110_HOST: initialized LCD/DSI start=%u LCD=%08x DSI=%08x\n",
+          t->host_starts,readl(t->lcd_clk),readl(t->dsi_clk));
+}
+static void t110_start_command_host(struct t110_drm *t)
+{
+ t110_host_program_mode(t->regs,t->dsi,t->lcd_clk,t->dsi_clk,
+                        t->boot_addr,t->boot_pitch,false);
+ t->host_starts++;
+ dev_info(t->drm.dev,"T110_HOST: command-only initialization start=%u DMA=%08x\n",
+          t->host_starts,readl(t->regs+DMA_CTRL));
+}
+static ssize_t host_state_show(struct device *dev,struct device_attribute *a,char *buf)
+{
+ struct t110_drm *t=dev_get_drvdata(dev);
+ return sysfs_emit(buf,"linux_init=%d starts=%u lcd_clock=%08x dsi_clock=%08x\n",
+                   linux_init,t->host_starts,readl(t->lcd_clk),readl(t->dsi_clk));
+}
+static DEVICE_ATTR_RO(host_state);
+static void t110_delete_panel_link(void *data){device_link_del(data);}
+static int t110_modes(struct drm_connector *connector)
+{
+ struct drm_display_mode *mode=drm_mode_duplicate(connector->dev,&to_t110(connector->dev)->mode);
+ if(!mode)return -ENOMEM;
+ mode->type=DRM_MODE_TYPE_DRIVER|DRM_MODE_TYPE_PREFERRED;
+ drm_mode_probed_add(connector,mode);
+ connector->display_info.width_mm=154;connector->display_info.height_mm=90;
+ return 1;
+}
+static const struct drm_connector_helper_funcs t110_connector_helper={.get_modes=t110_modes};
+static const struct drm_connector_funcs t110_connector_funcs={
+ .fill_modes=drm_helper_probe_single_connector_modes,
+ .destroy=drm_connector_cleanup,.reset=drm_atomic_helper_connector_reset,
+ .atomic_duplicate_state=drm_atomic_helper_connector_duplicate_state,
+ .atomic_destroy_state=drm_atomic_helper_connector_destroy_state,
+};
+static enum drm_mode_status t110_mode_valid(struct drm_simple_display_pipe *pipe,const struct drm_display_mode *mode)
+{
+ return drm_mode_equal(mode,&to_t110(pipe->crtc.dev)->mode)?MODE_OK:MODE_BAD;
+}
+static int t110_check(struct drm_simple_display_pipe *pipe,struct drm_plane_state *ps,struct drm_crtc_state *cs)
+{
+ if(ps->fb && (ps->fb->pitches[0]!=4096 || ps->src_x || ps->src_y))return -EINVAL;
+ return 0;
+}
+static void t110_scanout(struct drm_simple_display_pipe *pipe)
+{
+ struct t110_drm *t=to_t110(pipe->crtc.dev);
+ struct drm_plane_state *ps=pipe->plane.state;
+ struct drm_framebuffer *fb=ps->fb;
+ dma_addr_t addr;
+ if(!fb)return;
+ addr=drm_fb_dma_get_gem_addr(fb,ps,0);
+ /* All allocations/imports use the 32-bit DMA API and contiguous backing. */
+ dma_wmb();
+ writel((readl(t->regs+GRA_PITCH)&0xffff0000)|fb->pitches[0],t->regs+GRA_PITCH);
+ writel(lower_32_bits(addr),t->regs+GRA_ADDR);
+ readl(t->regs+GRA_ADDR);
+}
+/* The bridge needs this host to initialize before registering its backlight.
+ * Resolve the existing board backlight at modeset time, without introducing a
+ * reciprocal probe dependency. Use the backlight core's normal power state so
+ * compositor DPMS and system PM share the same restore rules.
+ */
+static void t110_backlight(struct t110_drm *t, bool enable)
+{
+ struct backlight_device *bl=backlight_device_get_by_name("t110-backlight");
+ int ret;
+ if(!bl)return;
+ ret=enable?backlight_enable(bl):backlight_disable(bl);
+ if(ret)dev_err_ratelimited(t->drm.dev,"backlight power %u failed: %d\n",enable,ret);
+ put_device(&bl->dev);
+}
+static void t110_enable(struct drm_simple_display_pipe *pipe,struct drm_crtc_state *cs,struct drm_plane_state *ps)
+{
+ t110_scanout(pipe);
+ drm_crtc_vblank_on(&pipe->crtc);
+ t110_backlight(to_t110(pipe->crtc.dev),true);
+}
+static void t110_disable(struct drm_simple_display_pipe *pipe)
+{
+ struct t110_drm *t=to_t110(pipe->crtc.dev);
+ t110_backlight(t,false);
+ drm_crtc_vblank_off(&pipe->crtc);
+ /* Keep the already initialized panel alive; restore reserved boot memory. */
+ writel(t->boot_pitch,t->regs+GRA_PITCH);writel(t->boot_addr,t->regs+GRA_ADDR);
+}
+static void t110_update(struct drm_simple_display_pipe *pipe,struct drm_plane_state *old)
+{
+ struct drm_crtc *crtc=&pipe->crtc;
+ struct drm_pending_vblank_event *event=crtc->state->event;
+ t110_scanout(pipe);
+ if(event) {
+  crtc->state->event=NULL;
+  spin_lock_irq(&crtc->dev->event_lock);
+  if(crtc->state->active && !drm_crtc_vblank_get(crtc))drm_crtc_arm_vblank_event(crtc,event);
+  else drm_crtc_send_vblank_event(crtc,event);
+  spin_unlock_irq(&crtc->dev->event_lock);
+ }
+}
+static int t110_vblank_enable(struct drm_simple_display_pipe *pipe)
+{
+ struct t110_drm *t=to_t110(pipe->crtc.dev);unsigned long flags;
+ spin_lock_irqsave(&t->irq_lock,flags);
+ writel(~VSYNC,t->regs+IRQ_ISR);writel(VSYNC,t->regs+IRQ_ENA);
+ spin_unlock_irqrestore(&t->irq_lock,flags);return 0;
+}
+static void t110_vblank_disable(struct drm_simple_display_pipe *pipe)
+{
+ struct t110_drm *t=to_t110(pipe->crtc.dev);unsigned long flags;
+ spin_lock_irqsave(&t->irq_lock,flags);writel(0,t->regs+IRQ_ENA);spin_unlock_irqrestore(&t->irq_lock,flags);
+}
+static irqreturn_t t110_irq(int irq,void *data)
+{
+ struct t110_drm *t=data;u32 status=readl(t->regs+IRQ_ISR);
+ if(!(status & readl(t->regs+IRQ_ENA) & VSYNC))return IRQ_NONE;
+ writel(~VSYNC,t->regs+IRQ_ISR);
+ drm_crtc_handle_vblank(&t->pipe.crtc);return IRQ_HANDLED;
+}
+static const struct drm_simple_display_pipe_funcs t110_pipe_funcs={
+ .mode_valid=t110_mode_valid,.check=t110_check,.enable=t110_enable,
+ .disable=t110_disable,.update=t110_update,
+ .enable_vblank=t110_vblank_enable,.disable_vblank=t110_vblank_disable,
+};
+static const struct drm_mode_config_funcs t110_mode_funcs={
+ .fb_create=drm_gem_fb_create,.atomic_check=drm_atomic_helper_check,.atomic_commit=drm_atomic_helper_commit,
+};
+DEFINE_DRM_GEM_DMA_FOPS(t110_fops);
+static const struct drm_driver t110_driver={
+ .driver_features=DRIVER_GEM|DRIVER_MODESET|DRIVER_ATOMIC,
+ .name="t110-drm",.desc="SM-T110 fixed-panel LCD",.major=1,.minor=0,
+ .fops=&t110_fops,DRM_GEM_DMA_DRIVER_OPS,DRM_FBDEV_DMA_DRIVER_OPS,
+};
+static int t110_probe(struct platform_device *pdev)
+{
+ struct device *dev=&pdev->dev;struct t110_drm *t;struct drm_device *drm;
+ static const u32 formats[]={DRM_FORMAT_XRGB8888};
+ static const u64 modifiers[]={DRM_FORMAT_MOD_LINEAR,DRM_FORMAT_MOD_INVALID};
+ u32 ctrl,total,hp,vp;int ret,irq;
+ if(!of_machine_is_compatible("samsung,goyawifi"))return -ENODEV;
+ t=devm_drm_dev_alloc(dev,&t110_driver,struct t110_drm,drm);
+ if(IS_ERR(t))return PTR_ERR(t);
+ drm=&t->drm;spin_lock_init(&t->irq_lock);mutex_init(&t->bootstrap_lock);
+ t->regs=devm_platform_ioremap_resource(pdev,0);if(IS_ERR(t->regs))return PTR_ERR(t->regs);
+ t->dsi=devm_ioremap(dev,0xd420b800,0x200);
+ t->lcd_clk=devm_ioremap(dev,0xd428284c,4);
+ t->dsi_clk=devm_ioremap(dev,0xd4282844,4);
+ if(!t->dsi||!t->lcd_clk||!t->dsi_clk)return -ENOMEM;
+ if(linux_init) {
+  /* Reserved scanout is a safe temporary address until GEM/fbdev takes over.
+   * No bootloader timing, format or address readback is required. */
+  t->boot_addr=0x17000000;t->boot_pitch=4096;
+  t110_host_bus_enable(t->lcd_clk);
+  writel(0x0000fff0,t->regs+0x1dc);readl(t->regs+0x1dc);
+  writel(0,t->regs+IRQ_ENA);
+  t110_host_stop(t->regs,t->dsi,t->lcd_clk,t->dsi_clk);
+  t110_start_host(t,t->boot_addr,t->boot_pitch);
+  /* LCD counters run at 78MHz; physical panel is 1367x633 at ~60.1Hz. */
+  t->mode=(struct drm_display_mode){.clock=78000,.hdisplay=1024,
+   .hsync_start=1720,.hsync_end=1900,.htotal=2050,.vdisplay=600,
+   .vsync_start=613,.vsync_end=623,.vtotal=633,
+   .flags=DRM_MODE_FLAG_PHSYNC|DRM_MODE_FLAG_PVSYNC};
+ }else {
+ t->boot_addr=readl(t->regs+GRA_ADDR);t->boot_pitch=readl(t->regs+GRA_PITCH);
+ ctrl=readl(t->regs+DMA_CTRL);
+ if(t->boot_addr!=0x17000000 || (t->boot_pitch&0xffff)!=4096 ||
+    readl(t->regs+GRA_SIZE)!=0x02580400 || (ctrl&0x000f0000)!=0x00040000 ||
+    !(ctrl&BIT(8)) || !(ctrl&BIT(12)) || (ctrl&(BIT(15)|BIT(9))))return -EINVAL;
+ total=readl(t->regs+0x114);hp=readl(t->regs+0x11c);vp=readl(t->regs+0x120);
+ t->mode=(struct drm_display_mode){.hdisplay=1024,.vdisplay=600,
+  .htotal=total&0xffff,.vtotal=total>>16,
+  .hsync_start=1024+(hp&0xffff),.hsync_end=(total&0xffff)-(hp>>16),
+  .vsync_start=600+(vp&0xffff),.vsync_end=(total>>16)-(vp>>16),
+  .flags=DRM_MODE_FLAG_PHSYNC|DRM_MODE_FLAG_PVSYNC};
+ if(t->mode.htotal<1024 || t->mode.vtotal<600 ||
+    t->mode.hsync_end<t->mode.hsync_start || t->mode.vsync_end<t->mode.vsync_start)return -EINVAL;
+ t->mode.clock=DIV_ROUND_CLOSEST(t->mode.htotal*t->mode.vtotal*60,1000);
+ }
+ drm_mode_set_name(&t->mode);
+ ret=dma_set_mask_and_coherent(dev,DMA_BIT_MASK(32));if(ret)return ret;
+ ret=drmm_mode_config_init(drm);if(ret)return ret;
+ drm->mode_config.min_width=1024;drm->mode_config.max_width=1024;
+ drm->mode_config.min_height=600;drm->mode_config.max_height=600;
+ drm->mode_config.funcs=&t110_mode_funcs;
+ ret=drm_connector_init(drm,&t->connector,&t110_connector_funcs,DRM_MODE_CONNECTOR_DSI);if(ret)return ret;
+ drm_connector_helper_add(&t->connector,&t110_connector_helper);
+ ret=drm_simple_display_pipe_init(drm,&t->pipe,&t110_pipe_funcs,formats,ARRAY_SIZE(formats),modifiers,&t->connector);if(ret)return ret;
+ ret=drm_plane_create_blend_mode_property(&t->pipe.plane,BIT(DRM_MODE_BLEND_PIXEL_NONE)|BIT(DRM_MODE_BLEND_PREMULTI));if(ret)return ret;
+ ret=drm_vblank_init(drm,1);if(ret)return ret;
+ irq=platform_get_irq(pdev,0);if(irq<0)return irq;t->irq=irq;
+ writel(0,t->regs+IRQ_ENA);writel(~VSYNC,t->regs+IRQ_ISR);
+ ret=devm_request_irq(dev,irq,t110_irq,0,dev_name(dev),t);if(ret)return ret;
+ ret=aperture_remove_conflicting_devices(t->boot_addr,4096*600,"t110-drm");if(ret)return ret;
+ drm_mode_config_reset(drm);platform_set_drvdata(pdev,t);
+ /* Panel/I2C work suspends before host clocks stop and resumes after the
+  * host has been reconstructed. The shared touch/bridge rails stay owned
+  * by their existing drivers. */
+ {
+  struct device *panel=bus_find_device_by_name(&i2c_bus_type,NULL,"1-0064");
+  if(!panel)return -EPROBE_DEFER;
+  t->panel_link=device_link_add(panel,dev,DL_FLAG_STATELESS);
+  put_device(panel);
+  if(!t->panel_link)return -EINVAL;
+  ret=devm_add_action_or_reset(dev,t110_delete_panel_link,t->panel_link);if(ret)return ret;
+ }
+ ret=device_create_file(dev,&dev_attr_host_state);if(ret)return ret;
+ ret=drm_dev_register(drm,0);if(ret){device_remove_file(dev,&dev_attr_host_state);return ret;}
+ drm_client_setup_with_fourcc(drm,DRM_FORMAT_XRGB8888);
+ WRITE_ONCE(bootstrap_host,t);
+ dev_info(dev,"T110_KMS_S: %dx%d totals %dx%d fixed panel, CMA scanout, IRQ %d\n",1024,600,t->mode.htotal,t->mode.vtotal,irq);
+ return 0;
+}
+/* Reuse DRM's saved atomic state so no live compositor scans buffers while
+ * the bridge is reset. Every exit rebuilds the host and restores scanout. */
+int t110_display_bootstrap(int (*action)(void *),void *data)
+{
+ struct t110_drm *t=READ_ONCE(bootstrap_host);int ret,restore;
+ if(!t)return -EPROBE_DEFER;
+ if(!linux_init || !action)return -EOPNOTSUPP;
+ mutex_lock(&t->bootstrap_lock);
+ ret=drm_mode_config_helper_suspend(&t->drm);if(ret)goto out;
+ disable_irq(t->irq);
+ t110_host_stop(t->regs,t->dsi,t->lcd_clk,t->dsi_clk);
+ t110_start_command_host(t);
+ /* One-lane LP command mode, fresh CPU packet FIFO after full host reset. */
+ writel(0,t->dsi);readl(t->dsi);
+ writel(1,t->dsi+0x84);writel(0x10,t->dsi+0x88);
+ writel(BIT(20),t->dsi+0x24);msleep(32);
+ ret=action(data);
+ t110_start_host(t,t->boot_addr,t->boot_pitch);
+ enable_irq(t->irq);
+ restore=drm_mode_config_helper_resume(&t->drm);if(restore)ret=restore;
+out:
+ mutex_unlock(&t->bootstrap_lock);return ret;
+}
+EXPORT_SYMBOL_GPL(t110_display_bootstrap);
+
+/* Early system resume: I2C pins are still parked, userspace frozen and
+ * DRM atomic state already suspended. Do not nest the normal PM helpers. */
+int t110_display_resume_bridge(int (*action)(void *),void *data)
+{
+ struct t110_drm *t=READ_ONCE(bootstrap_host);int ret;
+ if(!t || !t->system_suspended || !linux_init || !action)return -EINVAL;
+ mutex_lock(&t->bootstrap_lock);
+ t110_host_bus_enable(t->lcd_clk);
+ t110_start_command_host(t);
+ writel(0,t->dsi);readl(t->dsi);
+ writel(1,t->dsi+0x84);writel(0x10,t->dsi+0x88);
+ writel(BIT(20),t->dsi+0x24);msleep(32);
+ ret=action(data);
+ /* Complete the normal four-lane host setup BEFORE I2C reconnects. Keep
+  * its clocks stable after bridge I2C access starts; regular DRM resume
+  * restores only scanout/IRQ rather than resetting the host a second time. */
+ if(!ret){
+  t110_start_host(t,t->boot_addr,t->boot_pitch);
+  writel(readl(t->regs+DMA_CTRL)&~(BIT(0)|BIT(8)),t->regs+DMA_CTRL);
+  readl(t->regs+DMA_CTRL);t->bridge_host_ready=true;
+ }else{
+  t110_host_stop(t->regs,t->dsi,t->lcd_clk,t->dsi_clk);
+  t->bridge_host_ready=false;
+ }
+ dev_info(t->drm.dev,"T110_BRIDGE_PM: early DSI bootstrap result=%d\n",ret);
+ mutex_unlock(&t->bootstrap_lock);return ret;
+}
+EXPORT_SYMBOL_GPL(t110_display_resume_bridge);
+
+static void t110_remove(struct platform_device *pdev)
+{
+ struct t110_drm *t=platform_get_drvdata(pdev);
+ WRITE_ONCE(bootstrap_host,NULL);
+ device_remove_file(&pdev->dev,&dev_attr_host_state);
+ drm_dev_unregister(&t->drm);drm_atomic_helper_shutdown(&t->drm);
+}
+static void t110_shutdown(struct platform_device *pdev)
+{ struct t110_drm *t=platform_get_drvdata(pdev);drm_atomic_helper_shutdown(&t->drm); }
+static int t110_drm_suspend(struct device *dev)
+{
+ struct t110_drm *t=dev_get_drvdata(dev);int ret;
+ ret=drm_mode_config_helper_suspend(&t->drm);if(ret)return ret;
+ t->sleep_dma=readl(t->regs+DMA_CTRL);
+ writel(t->sleep_dma & ~(BIT(0)|BIT(8)),t->regs+DMA_CTRL);
+ readl(t->regs+DMA_CTRL);
+ /* Drain the last graphics fetch while preserving LCD/DSI timings. */
+ msleep(20);
+ if(linux_init){disable_irq(t->irq);t110_host_stop(t->regs,t->dsi,t->lcd_clk,t->dsi_clk);}
+ t->system_suspended=true;t->bridge_host_ready=false;
+ dev_info(dev,"T110_HOST: suspend functional clocks LCD=%08x DSI=%08x\n",readl(t->lcd_clk),readl(t->dsi_clk));
+ return 0;
+}
+static int t110_drm_resume(struct device *dev)
+{
+ struct t110_drm *t=dev_get_drvdata(dev);
+ if(linux_init){
+  if(!t->bridge_host_ready)t110_start_host(t,t->boot_addr,t->boot_pitch);
+  t->bridge_host_ready=false;enable_irq(t->irq);
+ }
+ writel(t->sleep_dma,t->regs+DMA_CTRL);readl(t->regs+DMA_CTRL);
+ t->system_suspended=false;
+ return drm_mode_config_helper_resume(&t->drm);
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(t110_drm_pm,t110_drm_suspend,t110_drm_resume);
+static const struct of_device_id t110_of_match[]={{.compatible="samsung,t110-lcd-handoff"},{}};
+MODULE_DEVICE_TABLE(of,t110_of_match);
+static struct platform_driver t110_platform_driver={.probe=t110_probe,.remove=t110_remove,.shutdown=t110_shutdown,
+ .driver={.name="t110-drm",.of_match_table=t110_of_match,.pm=pm_sleep_ptr(&t110_drm_pm)}};
+module_platform_driver(t110_platform_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("SM-T110 fixed LCD/DSI host initialization and KMS scanout");
diff --git a/drivers/gpu/drm/tiny/t110-host.h b/drivers/gpu/drm/tiny/t110-host.h
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/tiny/t110-host.h
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* goyawifi fixed RGB888/four-lane host setup. Vendor pxa688_phy.c and
+ * board-goya-display.c, verified against this board's working register set.
+ * The VX5B3D bridge and its rails are managed separately. */
+struct t110_reg {u16 offset;u32 value;};
+static void t110_host_bus_enable(void __iomem *lcd_clk)
+{
+ /* Retain the shared AXI source/divider policy, but explicitly own the
+  * required gate/reset release. Camera uses these same bus domains. */
+ writel(readl(lcd_clk)|BIT(16)|BIT(3)|BIT(5)|BIT(2),lcd_clk);
+ readl(lcd_clk);udelay(10);
+}
+static const struct t110_reg t110_dsi_config[]={
+ /* FIFO allocation, timeout counters and four-lane LP command mask. */
+ {0x14,0},{0x24,0x00f00000},{0x8c,0},
+ /* Board D-PHY timings, 52MHz escape clock, 312MHz lane bit clock. */
+ {0xc0,0x06070603},{0xc4,0x0e0bcd98},{0xc8,0x06040c02},{0xcc,0x0000023c},
+ {0xe0,0x00066666},{0xe4,0xffffffff},{0xe8,0xffffffff},{0xec,0xffffffff},
+ {0x100,0x00402010},
+ /* RGB888 sync-event video, HBP packet, VSYNC reset. */
+ {0x104,BIT(31)|BIT(18)|(1<<2)|3},
+ /* 1024x600, HFP123/HBP100/HS120, VFP13/VBP10/VS10.
+  * Horizontal counters use bytes/lane with each interval truncated. */
+ {0x110,((1024*3/4)<<16)|(1024*3/4+123*3/4+100*3/4+120*3/4)},
+ {0x114,((120*3/4)<<16)|(100*3/4)},
+ {0x118,(600<<16)|633},{0x11c,(10<<16)|10},
+ {0x120,((120*3+100*3-4-6)<<16)},
+ {0x124,((123*3-12)<<16)|(1024*3)},
+ {0x128,(1367*3-4-6)},
+ {0x4,0xe4},
+};
+static void t110_dsi_program_mode(void __iomem *dsi,bool video)
+{
+ int i;
+ writel(0,dsi);readl(dsi);
+ /* Full DSI module + register reset, not just TX enable toggling. */
+ writel(BIT(31)|BIT(30),dsi);readl(dsi);usleep_range(1000,2000);
+ writel(0,dsi+0x84);writel(0,dsi);readl(dsi);usleep_range(1000,2000);
+ pr_info("T110_HOST: reset DSI video timing=%08x ctrl=%08x\n",readl(dsi+0x110),readl(dsi));
+ writel(readl(dsi+0xb0)|BIT(9),dsi+0xb0);
+ for(i=0;i<ARRAY_SIZE(t110_dsi_config);i++)
+  writel(t110_dsi_config[i].value,dsi+t110_dsi_config[i].offset);
+ writel(1,dsi+0x84);writel(0,dsi+0x88);udelay(10);
+ writel(video?0xf0:0x10,dsi+0x88);
+ if(!video)writel(BIT(20),dsi+0x24);
+ usleep_range(1000,2000);
+ writel(video?(BIT(8)|BIT(0)):0,dsi);readl(dsi);
+}
+
+static void t110_host_stop(void __iomem *lcd,void __iomem *dsi,
+                           void __iomem *lcd_clk,void __iomem *dsi_clk)
+{
+ writel(readl(lcd+0x190)&~(BIT(0)|BIT(8)),lcd+0x190);readl(lcd+0x190);
+ msleep(20); /* drain the last LCD fetch before stopping its clock */
+ writel(0,dsi);readl(dsi);writel(0,dsi+0x88);writel(0,dsi+0x84);
+ writel(0,lcd+0x1b8);
+ writel(readl(lcd+0x1a8)|BIT(28),lcd+0x1a8);readl(lcd+0x1a8);
+ /* LCD functional and DSI PHY gates only. Never reset/gate the shared
+  * LCD/CCIC/ISP AXI or HCLK domains here. */
+ writel(readl(dsi_clk)&~(BIT(2)|BIT(5)),dsi_clk);readl(dsi_clk);
+ writel(readl(lcd_clk)&~BIT(4),lcd_clk);readl(lcd_clk);
+}
+static void t110_host_program_mode(void __iomem *lcd,void __iomem *dsi,
+                              void __iomem *lcd_clk,void __iomem *dsi_clk,
+                              u32 address,u32 pitch,bool video)
+{
+ u32 value;
+ /* PLL1_624, no LCD post division. Shared AXI/HCLK fields preserved. */
+ value=readl(lcd_clk)&~(BIT(6)|(31<<10));
+ writel(value|BIT(4)|BIT(1)|BIT(0),lcd_clk);readl(lcd_clk);
+ /* Vendor requires the global LCD arbitration setup before other LCD
+  * register access. Keep CMU/TV routing disabled for this panel-only pipe. */
+ writel(0x0000fff0,lcd+0x1dc);readl(lcd+0x1dc);
+ /* PXA986 escape clock: 52MHz, slow-clock preroll26; release PHY reset. */
+ value=(readl(dsi_clk)&~((31<<6)|3))|(26<<6)|BIT(2)|BIT(5);
+ writel(value,dsi_clk);udelay(10);
