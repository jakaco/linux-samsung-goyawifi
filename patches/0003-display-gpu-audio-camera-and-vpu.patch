diff --git a/sound/arm/t110-audio.c b/sound/arm/t110-audio.c
new file mode 100644
--- /dev/null
+++ b/sound/arm/t110-audio.c
@@ -0,0 +1,588 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T110 duplex audio: SSP1/SQU, PM805, PM822 class D and microphone bias.
+ * Register sequencing derives from the owner's stock audio configuration
+ * and Samsung/Marvell's goyawifi kernel. External rail selectors are retained.
+ */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/i2c.h>
+#include <linux/regmap.h>
+#include <linux/dmaengine.h>
+#include <linux/genalloc.h>
+#include <linux/delay.h>
+#include <linux/workqueue.h>
+#include <linux/spinlock.h>
+#include <sound/core.h>
+#include <sound/pcm.h>
+#include <sound/pcm_params.h>
+#include <sound/control.h>
+#include <sound/tlv.h>
+#include <sound/dmaengine_pcm.h>
+#include <sound/jack.h>
+
+#define SSCR0 0
+#define SSCR1 4
+#define SSSR 8
+#define SSPSP 0x2c
+#define SSE BIT(7)
+#define BUFFER 16384
+extern int t110_audio_clock_source(void);
+struct t110_stream {
+	struct dma_chan *chan;
+	struct gen_pool *pool;
+	void *buffer;
+	dma_addr_t buffer_addr;
+	bool opened,prepared;
+};
+struct t110_audio {
+	struct device *dev,*codec_dev,*pmic_dev;
+	struct regmap *codec,*pmic,*power;
+	struct i2c_client *client;
+	struct snd_card *card;
+	struct t110_stream stream[2];
+	struct gen_pool *pool;
+	void __iomem *ssp,*apbc,*isccr,*squ_gate,*fccr,*pins,*dma_debug;
+	struct mutex lock;
+	spinlock_t reg_lock;
+	unsigned int running_mask;
+	struct work_struct amp_work;
+	struct delayed_work jack_work;
+	struct snd_jack *jack;
+	bool powered,switch_on,headphones,stopping,hp_on,bias_on;
+	unsigned int volume,hp_volume,mic_source,mic_gain;
+};
+static int mic_bias(struct t110_audio *a,bool preparing)
+{
+	/* Vendor jack detection keeps bias on for an attached headset.
+	 * Here the explicit Headset Mic selection identifies that accessory. */
+	bool on=!a->stopping&&a->mic_source==2&&
+		(a->headphones||preparing||a->stream[1].prepared);
+	int ret=regmap_update_bits(a->power,0x52,BIT(5),on?BIT(5):0);
+	if(!ret)a->bias_on=on;
+	return ret;
+}
+static void clock_idle(struct t110_audio *a)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&a->reg_lock,flags);
+	if(!a->running_mask&&!READ_ONCE(a->stream[1].prepared))
+		writel(readl(a->ssp+SSCR0)&~SSE,a->ssp+SSCR0);
+	spin_unlock_irqrestore(&a->reg_lock,flags);
+}
+static int hp_gain(struct t110_audio *a,unsigned int value)
+{
+	int ret=regmap_write(a->codec,0x56,value);
+	return ret?:regmap_write(a->codec,0x57,value);
+}
+static int hp_sequence(struct t110_audio *a,bool enable)
+{
+	unsigned int status;int ret;
+	if(a->hp_on==enable)return 0;
+	/* Minimum documented gain (-91dB), then allow the existing ramp to settle. */
+	ret=hp_gain(a,1);if(ret)return ret;
+	msleep(20);
+	ret=regmap_update_bits(a->codec,0x26,0xff,enable?0x1d:0);if(ret)return ret;
+	a->hp_on=enable;
+	/* Allow the stock route's 100ms headphone settling time while attenuated. */
+	if(enable)msleep(100);
+	for(int i=0;i<20;i++){
+		ret=regmap_read(a->codec,0x0b,&status);if(ret)return ret;
+		if((status&(enable?0x50:0xa0))==(enable?0x50:0xa0))return 0;
+		msleep(10);
+	}
+	dev_err(a->dev,"headphone sequence %s timeout, status=%02x\n",enable?"up":"down",status);
+	return -ETIMEDOUT;
+}
+static int amp(struct t110_audio *a)
+{
+	bool prepared=a->stream[SNDRV_PCM_STREAM_PLAYBACK].prepared;
+	bool active=prepared && (READ_ONCE(a->running_mask)&BIT(0)) && a->switch_on;
+	int ret;
+	if(!active||a->headphones){
+		ret=regmap_write(a->codec,0x58,1);if(ret)return ret;
+	}
+	ret=regmap_update_bits(a->pmic,0x48,2,(active&&!a->headphones)?2:0);
+	if(ret)return ret;
+	ret=hp_sequence(a,prepared&&a->headphones&&a->switch_on);if(ret)return ret;
+	if(a->hp_on)return hp_gain(a,active?a->hp_volume+92:1);
+	if(active&&!a->headphones)return regmap_write(a->codec,0x58,a->volume+92);
+	return 0;
+}
+static void jack_poll(struct work_struct *w)
+{
+	struct t110_audio *a=container_of(to_delayed_work(w),struct t110_audio,jack_work);
+	unsigned int value;bool changed=false;int ret;
+	mutex_lock(&a->lock);
+	ret=regmap_read(a->pmic,0x39,&value);
+	if(!ret && a->headphones!=!!(value&BIT(7))){
+		a->headphones=!!(value&BIT(7));changed=true;
+		ret=mic_bias(a,false);
+		if(a->stream[SNDRV_PCM_STREAM_PLAYBACK].prepared)ret=amp(a);
+	}
+	mutex_unlock(&a->lock);
+	if(changed)snd_jack_report(a->jack,a->headphones?SND_JACK_HEADPHONE:0);
+	if(ret)dev_err_ratelimited(a->dev,"jack poll/route failed: %d\n",ret);
+	if(!READ_ONCE(a->stopping))schedule_delayed_work(&a->jack_work,msecs_to_jiffies(250));
+}
+static void amp_work(struct work_struct *w)
+{
+	struct t110_audio *a=container_of(w,struct t110_audio,amp_work);
+	int ret;
+	mutex_lock(&a->lock);ret=amp(a);mutex_unlock(&a->lock);
+	if(ret)dev_err(a->dev,"speaker switch failed: %d\n",ret);
+}
+static int off(struct t110_audio *a)
+{
+	unsigned long flags;int ret;
+	WRITE_ONCE(a->stream[0].prepared,false);WRITE_ONCE(a->stream[1].prepared,false);
+	hp_sequence(a,false);
+	a->powered=false;
+	ret=regmap_update_bits(a->pmic,0x48,2,0);
+	regmap_update_bits(a->codec,0x26,0xff,0);
+	regmap_update_bits(a->codec,0x90,0x7f,0);
+	regmap_update_bits(a->codec,0x16,0x7f,0);
+	regmap_update_bits(a->codec,0x94,7,2);
+	mic_bias(a,false);
+	regmap_update_bits(a->codec,0x20,0xc7,0);
+	regmap_update_bits(a->codec,0x21,0x7f,0);
+	regmap_update_bits(a->codec,0x51,0x15,0);
+	regmap_update_bits(a->codec,0x50,0x1f,0);
+	regmap_update_bits(a->codec,0x30,1,0);
+	regmap_update_bits(a->codec,1,1,0);
+	spin_lock_irqsave(&a->reg_lock,flags);
+	WRITE_ONCE(a->running_mask,0);
+	writel(0x00801dc0,a->ssp+SSCR1);
+	writel(readl(a->ssp+SSCR0)&~SSE,a->ssp+SSCR0);
+	writel(readl(a->isccr)&~(BIT(31)|BIT(29)),a->isccr);
+	spin_unlock_irqrestore(&a->reg_lock,flags);
+	return ret;
+}
+static int coef(struct t110_audio *a,const u8 *data,size_t len)
+{
+	/* The codec's coefficient-memory port consumes a byte stream. */
+	return regmap_raw_write(a->codec,0x5c,data,len);
+}
+/* Only these digital blocks are shared by the two codec routes. */
+static int sync_blocks(struct t110_audio *a)
+{
+	bool p=a->stream[SNDRV_PCM_STREAM_PLAYBACK].prepared;
+	bool c=a->stream[SNDRV_PCM_STREAM_CAPTURE].prepared;
+	unsigned int digital=(p||c)?0x0c:0;
+	unsigned int sai=(p||c)?1:0;int ret;
+	if(p){digital|=1;sai|=4;}
+	if(c){digital|=2;sai|=0x10;}
+	ret=regmap_update_bits(a->codec,0x50,0x1f,digital);if(ret)return ret;
+	return regmap_update_bits(a->codec,0x51,0x15,sai);
+}
+static void drop_route(struct t110_audio *a,int direction)
+{
+	WRITE_ONCE(a->stream[direction].prepared,false);
+	if(direction==SNDRV_PCM_STREAM_PLAYBACK){
+		amp(a);
+		regmap_update_bits(a->codec,0x20,0xc7,0);
+		regmap_update_bits(a->codec,0x21,0x7f,0);
+	}else{
+		regmap_update_bits(a->codec,0x16,0x7f,0);
+		regmap_update_bits(a->codec,0x94,7,2);
+		mic_bias(a,false);
+	}
+	if(!a->stream[0].prepared&&!a->stream[1].prepared)off(a);
+	else if(sync_blocks(a))dev_err(a->dev,"failed to retain active codec blocks\n");
+	clock_idle(a);
+}
+static int pm822_audio_clocks(struct regmap *pmic)
+{
+ int ret=regmap_update_bits(pmic,0x50,BIT(1),0);if(ret)return ret;
+ ret=regmap_update_bits(pmic,0x55,BIT(1),0);if(ret)return ret;
+ msleep(20);
+ ret=regmap_update_bits(pmic,0x21,0x30,0x30);if(ret)return ret;
+ msleep(2);return 0;
+}
+static int prepare(struct snd_pcm_substream *s)
+{
+	struct t110_audio *a=snd_pcm_substream_chip(s);
+	static const u8 c1[]={4,0x80,0},c2[]={13,0x80,0};
+	static const u8 c3[]={16,0x80,0,0x80,0,0,0,0,0,0x40,0,0x40,0,0x40,0,0x40,0,0,0,0,0,0x80,0,0x80,0,0x80,0,0x80,0,0x80,0,0x80,0};
+	int d=s->stream,ret;unsigned int ready=0;
+	flush_work(&a->amp_work);mutex_lock(&a->lock);
+	/* Reprepare only this direction; leave the peer's clock and route alone. */
+	if(a->stream[d].prepared)drop_route(a,d);
+#define U(map,r,m,v) do{ret=regmap_update_bits(map,r,m,v);if(ret){dev_err(a->dev,"setup register %02x mask %02x value %02x failed %d\n",(unsigned int)(r),(unsigned int)(m),(unsigned int)(v),ret);goto fail;}}while(0)
+	if(!a->powered){
+	/* Goya's vendor PM822 setup locks both oscillators to 32kHz.
+	 * Match that documented clock configuration before codec power-up.
+	 * Only the documented oscillator-mode bits are changed, not rail levels.
+	 */
+	ret=pm822_audio_clocks(a->pmic);if(ret)goto fail;
+	/* board-goya.c enables internal PMIC DVC and the low-jitter 32k
+	 * clock in LOW_POWER2. Preserve other bits and rail selectors. */
+	/* Enable the vendor SSP1 APB/functional clock, release reset. */
+	writel(7,a->apbc);udelay(10);writel(3,a->apbc);udelay(10);
+	ret=t110_audio_clock_source();if(ret)goto fail;
+	writel(0xea948be2,a->isccr);
+	/* GPIO21..24: AF1. Preserve other pin state; only I2S pins are touched. */
+	for(int i=0;i<4;i++)writel((readl(a->pins+i*4)&~7U)|1,a->pins+i*4);
+	writel(0x41d0003f,a->ssp+SSCR0);
+	writel(0x00801dc0,a->ssp+SSCR1); /* continuous clock, DMA directions selected at trigger */
+	writel(0x02100004,a->ssp+SSPSP);
+	writel(3,a->ssp+0x30);writel(3,a->ssp+0x34);
+	writel(readl(a->ssp+SSSR),a->ssp+SSSR);
+	U(a->codec,1,1,1);
+	msleep(2);
+	/* Vendor ACM restores the digital enable register during power-up,
+	 * before configuring individual routes. */
+	U(a->codec,0x50,0x1d,0x0d);
+	for(int i=0;i<100;i++){
+		ret=regmap_read(a->codec,0x0b,&ready);if(ret)goto fail;
+		if(ready&1)break;
+		msleep(10);
+	}
+	if(!(ready&1)){
+		unsigned int power=0,digital=0;
+		regmap_read(a->codec,1,&power);regmap_read(a->codec,0x50,&digital);
+		dev_err(a->dev,"codec not ready: power=%02x digital=%02x sequence=%02x\n",power,digital,ready);
+		ret=-ETIMEDOUT;goto fail;
+	}
+	U(a->codec,0x30,0x3f,0x0e); /* codec slave, I2S, 16-bit */
+	U(a->codec,0x31,0xff,0x49); /* 44.1kHz, vendor bitclock ratio */
+	U(a->codec,0x32,0x2f,4);
+	/* Keep the reference group stable for the whole shared power session. */
+	U(a->codec,0x90,0x7f,0x7e);
+	a->powered=true;
+	}
+	if(d==SNDRV_PCM_STREAM_CAPTURE){
+		/* Vendor Mic1, Mic2 or external headset ADC route. */
+		if(a->mic_source==2){
+			/* LDO14 is exclusively v_micbias; retain its voltage selector. */
+			ret=mic_bias(a,true);if(ret)goto fail;msleep(100);
+		}
+		U(a->codec,0x11,0x0f,a->mic_source==2?1:0);
+		U(a->codec,0x16,0x7f,a->mic_source==1?0x10:(a->mic_source==2?9:1));
+		U(a->codec,0x10,0x1f,0x14);
+		U(a->codec,0x92,0xff,0x56);U(a->codec,0x94,0x0f,a->mic_source==2?1:3);
+		/* PGA register codes descend as gain increases; default about 18dB. */
+		U(a->codec,a->mic_source==1?0x13:0x12,0x1f,31-a->mic_gain);
+		U(a->codec,0x3c,0xff,a->mic_source==1?0x11:0);
+		WRITE_ONCE(a->stream[d].prepared,true);
+		ret=sync_blocks(a);if(ret)goto fail;
+		/* Clock the ADC/SRC while its initial samples are still discarded.
+		 * Waiting without frame clocks left the startup DC step in the WAV. */
+		{unsigned long flags;spin_lock_irqsave(&a->reg_lock,flags);
+		writel(readl(a->ssp+SSCR0)|SSE,a->ssp+SSCR0);
+		spin_unlock_irqrestore(&a->reg_lock,flags);}
+		mutex_unlock(&a->lock);
+		/* The input settles independently; do not delay peer mute/close work. */
+		msleep(500);return 0;
+	}
+	/* Prepare both output chains; jack polling selects the active amplifier. */
+	U(a->codec,0x52,0xff,0xee);
+	ret=hp_gain(a,1);if(ret)goto fail;
+	U(a->codec,0x53,0xf0,0xf0);
+	U(a->codec,0x5b,0x1f,1);
+	ret=coef(a,c1,sizeof(c1));if(ret)goto fail;
+	ret=coef(a,c2,sizeof(c2));if(ret)goto fail;
+	ret=coef(a,c3,sizeof(c3));if(ret)goto fail;
+	U(a->codec,0x55,0xf0,0x20);
+	U(a->codec,0x21,0x7f,0x41);U(a->codec,0x20,0xc7,0xc1);
+	ret=regmap_write(a->codec,0x58,1);if(ret)goto fail;
+	U(a->pmic,0x61,0x0c,0x0c);U(a->pmic,0x62,0x60,0x20);
+	/* Match vendor delay/polarity but keep the class-D enable clear. */
+	U(a->pmic,0x48,0xf6,0xf0);msleep(20);
+	WRITE_ONCE(a->stream[d].prepared,true);ret=sync_blocks(a);if(ret)goto fail;
+	/* Precharge the analog headphone path while digitally attenuated,
+	 * before ALSA starts consuming any playback samples. */
+	ret=amp(a);if(ret)goto fail;
+	mutex_unlock(&a->lock);return 0;
+fail:
+	dev_err(a->dev,"prepare failed %d\n",ret);
+	drop_route(a,d);mutex_unlock(&a->lock);return ret;
+#undef U
+}
+static const struct snd_pcm_hardware hardware={
+	.info=SNDRV_PCM_INFO_INTERLEAVED,
+	.formats=SNDRV_PCM_FMTBIT_S16_LE,.rates=SNDRV_PCM_RATE_44100,
+	.rate_min=44100,.rate_max=44100,.channels_min=2,.channels_max=2,
+	.buffer_bytes_max=BUFFER,.period_bytes_min=1024,.period_bytes_max=4096,
+	.periods_min=2,.periods_max=16,.fifo_size=32,
+};
+static int pcm_open(struct snd_pcm_substream *s)
+{
+	struct t110_audio *a=snd_pcm_substream_chip(s);
+	int ret;
+	mutex_lock(&a->lock);
+	if(a->stream[s->stream].opened){mutex_unlock(&a->lock);return -EBUSY;}
+	a->stream[s->stream].opened=true;mutex_unlock(&a->lock);
+	s->runtime->hw=hardware;
+	snd_pcm_hw_constraint_integer(s->runtime,SNDRV_PCM_HW_PARAM_PERIODS);
+	ret=snd_dmaengine_pcm_open(s,a->stream[s->stream].chan);
+	if(ret){mutex_lock(&a->lock);a->stream[s->stream].opened=false;mutex_unlock(&a->lock);}
+	return ret;
+}
+static int pcm_close(struct snd_pcm_substream *s)
+{
+	struct t110_audio *a=snd_pcm_substream_chip(s);
+	int ret;
+	flush_work(&a->amp_work);
+	mutex_lock(&a->lock);drop_route(a,s->stream);mutex_unlock(&a->lock);
+	ret=snd_dmaengine_pcm_close(s);
+	mutex_lock(&a->lock);a->stream[s->stream].opened=false;mutex_unlock(&a->lock);return ret;
+}
+static int hw_params(struct snd_pcm_substream *s,struct snd_pcm_hw_params *p)
+{
+	struct t110_audio *a=snd_pcm_substream_chip(s);
