+ dma_wmb();writel(video?0x08045140:0x08045040,lcd+0x190);readl(lcd+0x190);
+}
+static void t110_host_program(void __iomem *lcd,void __iomem *dsi,
+                              void __iomem *lcd_clk,void __iomem *dsi_clk,
+                              u32 address,u32 pitch)
+{t110_host_program_mode(lcd,dsi,lcd_clk,dsi_clk,address,pitch,true);}
