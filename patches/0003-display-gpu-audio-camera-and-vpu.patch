+static int sr_power(struct v4l2_subdev *sd,int on){struct sr200 *s=to_sr(sd);int ret=0;mutex_lock(&s->lock);if(on)ret=power_on(s);else power_off(s);mutex_unlock(&s->lock);return ret;}
