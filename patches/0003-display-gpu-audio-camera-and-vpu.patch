+ s->pad.flags=MEDIA_PAD_FL_SOURCE;s->sd.entity.function=MEDIA_ENT_F_CAM_SENSOR;
+ ret=media_entity_pads_init(&s->sd.entity,1,&s->pad);if(ret)goto err;
+ ret=v4l2_async_register_subdev(&s->sd);if(ret){media_entity_cleanup(&s->sd.entity);goto err;}
+ dev_info(&c->dev,"SR200PC20M IDb4 verified; VGA UYVY CSI-2 one lane\n");return 0;
