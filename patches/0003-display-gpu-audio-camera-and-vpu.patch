+static int t110_bl_probe(struct i2c_client *client)
+{
+	struct backlight_properties props = {.type = BACKLIGHT_RAW,
+		.max_brightness = MAX_DUTY, .scale = BACKLIGHT_SCALE_LINEAR};
+	struct t110_bl *t;
+	struct backlight_device *bl;
+	u32 enable, mode;
+	int ret;
+
+	if (!of_machine_is_compatible("samsung,goyawifi") ||
+	    client->adapter->nr != 1 || client->addr != 0x64)
+		return -ENODEV;
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_I2C))
+		return -EOPNOTSUPP;
+	t = devm_kzalloc(&client->dev, sizeof(*t), GFP_KERNEL);
+	if (!t)
+		return -ENOMEM;
+	t->client = client;
+	mutex_init(&t->lock);
+	t->panel_en=devm_gpiod_get(&client->dev,"panel-enable",GPIOD_ASIS);if(IS_ERR(t->panel_en))return PTR_ERR(t->panel_en);
+	t->led_en=devm_gpiod_get(&client->dev,"led-enable",GPIOD_ASIS);if(IS_ERR(t->led_en))return PTR_ERR(t->led_en);
+	t->bridge_en=devm_gpiod_get(&client->dev,"bridge-enable",GPIOD_ASIS);if(IS_ERR(t->bridge_en))return PTR_ERR(t->bridge_en);
+	t->reset=devm_gpiod_get(&client->dev,"bridge-reset",GPIOD_ASIS);if(IS_ERR(t->reset))return PTR_ERR(t->reset);
+	t->pmic_dev=bus_find_device_by_name(&i2c_bus_type,NULL,"2-0031");if(!t->pmic_dev)return -EPROBE_DEFER;
+	ret=devm_add_action_or_reset(&client->dev,release_device,t->pmic_dev);if(ret)return ret;
+	t->power=dev_get_regmap(t->pmic_dev,NULL);if(!t->power)return -EPROBE_DEFER;
+	t->core=devm_regulator_get(&client->dev,"bridge-core");if(IS_ERR(t->core))return dev_err_probe(&client->dev,PTR_ERR(t->core),"bridge core supply\n");
+	t->io=devm_regulator_get(&client->dev,"bridge-io");if(IS_ERR(t->io))return dev_err_probe(&client->dev,PTR_ERR(t->io),"bridge IO supply\n");
+	t->dsi=devm_ioremap(&client->dev,0xd420b800,0x200);if(!t->dsi)return -ENOMEM;
+ if(cold_init) {
+  /* Own all bridge supplies before cycling them; never set rail voltages. */
+  ret=gpiod_direction_output(t->panel_en,0);if(ret)return ret;
+  ret=gpiod_direction_output(t->led_en,0);if(ret)return ret;
+  ret=gpiod_direction_output(t->bridge_en,1);if(ret)return ret;
+  ret=gpiod_direction_output(t->reset,1);if(ret)return ret;
+  ret=regulator_enable(t->core);if(ret)return ret;t->core_on=true;
+  ret=regulator_enable(t->io);if(ret)return ret;t->io_on=true;
+  t->period=2040;t->pin=0x3fff0030;t->lvds=0x3fffffe0;
+  t->duty=MAX_DUTY/2;props.brightness=t->duty;props.power=BACKLIGHT_POWER_ON;
+  ret=bridge_cold_start(t);if(ret)return dev_err_probe(&client->dev,ret,"cold bridge initialization\n");
+  ret=panel_on(t,t->duty);if(ret)return ret;
+ }else {
+	t->dsi_ctrl=readl(t->dsi);t->dsi_clock=readl(t->dsi+0x84);t->dsi_lanes=readl(t->dsi+0x88);
+	t->dsi_cmd1=readl(t->dsi+0x24);
+	if(t->dsi_ctrl!=0x101||t->dsi_clock!=1||t->dsi_lanes!=0xf0)return -EINVAL;
+	if(gpiod_get_value_cansleep(t->panel_en)!=1||gpiod_get_value_cansleep(t->led_en)!=1||gpiod_get_value_cansleep(t->bridge_en)!=1||gpiod_get_value_cansleep(t->reset)!=1)return -EINVAL;
+	ret=gpiod_direction_output(t->panel_en,1);if(ret)return ret;
+	ret=gpiod_direction_output(t->led_en,1);if(ret)return ret;
+	ret=gpiod_direction_output(t->bridge_en,1);if(ret)return ret;
+	ret=gpiod_direction_output(t->reset,1);if(ret)return ret;
+	ret = vx_read(t, PWM_PERIOD, &t->period);
+	if (!ret) ret = vx_read(t, PWM_DUTY, &t->duty);
+	if (!ret) ret = vx_read(t, PWM_ENABLE, &enable);
+	if (!ret) ret = vx_read(t, LVDS_ENABLE, &t->lvds);
+	if (!ret) ret = vx_read(t, PWM_PIN, &t->pin);
+	if (ret)
+		return dev_err_probe(&client->dev, ret, "bridge register read failed\n");
+	dev_info(&client->dev, "T110_DISPLAY_T: period=%08x duty=%08x enable=%08x lvds=%08x pin=%08x\n",
+		t->period, t->duty, enable, t->lvds, t->pin);
+	/* Initial handoff is restricted to the verified board mode. Resume uses the full vendor initialization. */
+	if (t->period != 2040 || t->duty > MAX_DUTY || enable != 5 ||
+	    t->lvds != 0x3fffffe0 || (t->pin != 0x3fff0000 && t->pin != 0x3fff0030))
+		return dev_err_probe(&client->dev, -EINVAL, "unexpected boot bridge state\n");
+	ret=vx_read(t,0x704,&mode);if(ret)return ret;
+ if(mode!=0x3040a)return -EINVAL;
+ ret=vx_read(t,0x124,&mode);if(ret)return ret;
+ if(mode!=0x1892c400)return -EINVAL;
+ props.brightness = t->duty;
+	props.power = BACKLIGHT_POWER_ON;
+	ret=regulator_enable(t->core);if(ret)return ret;t->core_on=true;
+	ret=regulator_enable(t->io);if(ret){regulator_disable(t->core);t->core_on=false;return ret;}t->io_on=true;
+	t->powered=true;
+ }
+	ret=devm_add_action_or_reset(&client->dev,panel_cleanup,t);if(ret)return ret;
+	bl = devm_backlight_device_register(&client->dev, "t110-backlight",
+		&client->dev, t, &t110_bl_ops, &props);
+	if (IS_ERR(bl))
+		return PTR_ERR(bl);
+	i2c_set_clientdata(client, bl);
+	ret=devm_device_add_group(&client->dev,&panel_group);if(ret)return ret;
+	return 0;
+}
+
+static const struct of_device_id t110_bl_match[] = {
+	{.compatible = "samsung,t110-vx5b3d-backlight"}, {}
+};
+MODULE_DEVICE_TABLE(of, t110_bl_match);
+static const struct i2c_device_id t110_bl_ids[] = {
+	{"t110-vx5b3d", 0}, {}
+};
+MODULE_DEVICE_TABLE(i2c, t110_bl_ids);
+static struct i2c_driver t110_bl_driver = {
+	.driver = {.name = "t110-vx5b3d", .of_match_table = t110_bl_match, .pm = pm_sleep_ptr(&bridge_pm_ops)},
+	.probe = t110_bl_probe,
+	.id_table = t110_bl_ids,
+};
+module_i2c_driver(t110_bl_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("SM-T110 VX5B3D panel power and MIPI initialization");
