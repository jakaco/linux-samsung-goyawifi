new file mode 100644
--- /dev/null
+++ b/drivers/media/i2c/sr200pc20m-t110.c
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* SM-T110 SR200PC20M V4L2 subdevice. Register tables from Samsung GPL driver. */
+#include <linux/module.h>
+#include <linux/i2c.h>
+#include <linux/clk.h>
+#include <linux/gpio/consumer.h>
+#include <linux/delay.h>
+#include <linux/mutex.h>
+#include <media/v4l2-subdev.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include "sr200pc20m-t110-regs.h"
+struct sr200 {struct v4l2_subdev sd;struct media_pad pad;struct v4l2_ctrl_handler ctrls;struct mutex lock;struct clk *clk;struct gpio_desc *io,*analog,*standby,*reset;unsigned int width,height;bool powered,initialized;};
+static struct sr200 *to_sr(struct v4l2_subdev *sd){return container_of(sd,struct sr200,sd);}
+static int wr(struct sr200 *s,u16 reg){struct i2c_client *c=v4l2_get_subdevdata(&s->sd);return i2c_smbus_write_byte_data(c,reg>>8,reg&255);}
+static int table(struct sr200 *s,const u16 *regs,size_t n){int ret;for(size_t i=0;i<n;i++){if((regs[i]>>8)==255){if(regs[i]&255)msleep((regs[i]&255)*10);continue;}ret=wr(s,regs[i]);if(ret<0)return ret;}return 0;}
+static void power_off(struct sr200 *s) {
+ if(!s->powered)return;
+ gpiod_set_value_cansleep(s->reset,1);msleep(1);clk_disable_unprepare(s->clk);msleep(5);
+ gpiod_set_value_cansleep(s->standby,0);gpiod_set_value_cansleep(s->analog,0);gpiod_set_value_cansleep(s->io,0);s->powered=s->initialized=false;
+}
+static int power_on(struct sr200 *s) {
+ int ret;
+ if(s->powered)return 0;
+ gpiod_set_value_cansleep(s->io,1);gpiod_set_value_cansleep(s->analog,1);msleep(5);
+ gpiod_set_value_cansleep(s->standby,1);msleep(1);
+ ret=clk_prepare_enable(s->clk);if(ret){gpiod_set_value_cansleep(s->standby,0);gpiod_set_value_cansleep(s->analog,0);gpiod_set_value_cansleep(s->io,0);return ret;}
+ s->powered=true;msleep(40);gpiod_set_value_cansleep(s->reset,1);msleep(2);gpiod_set_value_cansleep(s->reset,0);msleep(5);return 0;
