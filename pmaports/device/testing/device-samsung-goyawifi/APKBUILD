# Local overlay. Set a real maintainer before submitting upstream.
maintainer=""
pkgname=device-samsung-goyawifi
pkgdesc="Samsung Galaxy Tab 3 Lite SM-T110 (close-to-mainline)"
pkgver=5
pkgrel=6
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="postmarketos-base postmarketos-initramfs>=3.12.5-r2 linux-samsung-goyawifi goyawifi-mkbootimg alsa-ucm-conf mesa-dri-gallium"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf modules-initfs modules-load.conf modprobe.conf 90-goyawifi.rules T110Audio.conf HiFi.conf 20-goyawifi-modprobe.files"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"
build() { devicepkg_build "$startdir" "$pkgname"; }
package() {
 devicepkg_package "$startdir" "$pkgname"
 install -Dm644 "$srcdir/20-goyawifi-modprobe.files" "$pkgdir/usr/share/mkinitfs/files/20-goyawifi-modprobe.files"
 install -Dm644 "$srcdir/90-goyawifi.rules" "$pkgdir/usr/lib/udev/rules.d/90-goyawifi.rules"
 install -Dm644 "$srcdir/T110Audio.conf" "$pkgdir/usr/share/alsa/ucm2/T110Audio/T110Audio.conf"
 install -Dm644 "$srcdir/HiFi.conf" "$pkgdir/usr/share/alsa/ucm2/T110Audio/HiFi.conf"
 mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/t110-audio"
 ln -s ../../T110Audio/T110Audio.conf "$pkgdir/usr/share/alsa/ucm2/conf.d/t110-audio/t110-audio.conf"
 mkdir -p "$pkgdir/usr/lib/dri"
 ln -s libdril_dri.so "$pkgdir/usr/lib/dri/t110-drm_dri.so"
}
nonfree_firmware() {
 pkgdesc="SM-T110 optional SD8777 Wi-Fi/Bluetooth firmware"
 depends="firmware-samsung-goyawifi wireless-regdb"
 mkdir -p "$subpkgdir"
}

