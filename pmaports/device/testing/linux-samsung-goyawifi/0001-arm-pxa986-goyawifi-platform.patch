@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* PM822 counter/base and alarm layout verified against the pinned GOYA vendor driver. */
+#include <linux/rtc.h>
+#include <linux/interrupt.h>
+#include <linux/unaligned.h>
+#define T110_ONKEY_IRQ BIT(0)
+#define T110_RTC_IRQ BIT(4)
+#define T110_RTC_ACK (BIT(4) | BIT(5))
+static int t110_rtc_ctrl(struct t110_monitor *m, u8 set, u8 clear, u8 ack)
+{
+ unsigned int v; int ret=regmap_read(m->base,0xd0,&v);
+ if(ret)return ret;
+ return regmap_write(m->base,0xd0,((v & ~(T110_RTC_ACK | clear)) | set | ack));
+}
+static int t110_rtc_u32(struct t110_monitor *m, unsigned int reg, u32 *v)
+{
+ u8 b[4];int ret=regmap_bulk_read(m->base,reg,b,4);
+ if(!ret)
+  *v=get_unaligned_le32(b);
+ return ret;
+}
+static int t110_rtc_read_time(struct device *dev, struct rtc_time *tm)
+{
+ struct t110_monitor *m=dev_get_drvdata(dev);u32 base,count;int ret;
+ mutex_lock(&m->lock);
+ ret=t110_rtc_u32(m,0xea,&base);if(!ret)ret=t110_rtc_u32(m,0xd1,&count);
+ if(!ret)rtc_time64_to_tm((u32)(base+count),tm);
+ mutex_unlock(&m->lock);return ret;
+}
+static int t110_rtc_set_time(struct device *dev, struct rtc_time *tm)
+{
+ struct t110_monitor *m=dev_get_drvdata(dev);u32 count;u8 b[4];int ret;
+ mutex_lock(&m->lock);ret=t110_rtc_u32(m,0xd1,&count);
+ if(!ret){put_unaligned_le32((u32)rtc_tm_to_time64(tm)-count,b);ret=regmap_bulk_write(m->base,0xea,b,4);}
+ mutex_unlock(&m->lock);return ret;
+}
+static int t110_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *a)
+{
+ struct t110_monitor *m=dev_get_drvdata(dev);u32 base,alarm;unsigned int v;int ret;
+ mutex_lock(&m->lock);
+ ret=t110_rtc_u32(m,0xea,&base);if(!ret)ret=t110_rtc_u32(m,0xd5,&alarm);
+ if(!ret)ret=regmap_read(m->base,0xd0,&v);
+ if(!ret){rtc_time64_to_tm((u32)(base+alarm),&a->time);a->enabled=!!(v&1);a->pending=!!(v&T110_RTC_ACK);}
+ mutex_unlock(&m->lock);return ret;
+}
+static int t110_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *a)
+{
+ struct t110_monitor *m=dev_get_drvdata(dev);u32 base,count;u8 b[4];int ret;
+ time64_t when=rtc_tm_to_time64(&a->time);
+ mutex_lock(&m->lock);
+ ret=t110_rtc_u32(m,0xea,&base);if(!ret)ret=t110_rtc_u32(m,0xd1,&count);
+ if(!ret && a->enabled && when <= (u32)(base+count))ret=-ETIME;
+ if(!ret)ret=t110_rtc_ctrl(m,0,1,0);
+ if(!ret){put_unaligned_le32((u32)when-base,b);ret=regmap_bulk_write(m->base,0xd5,b,4);}
+ if(!ret)ret=regmap_write(m->base,5,T110_RTC_IRQ);
+ if(!ret)ret=t110_rtc_ctrl(m,a->enabled?1:0,1,T110_RTC_ACK);
+ mutex_unlock(&m->lock);return ret;
+}
+static int t110_rtc_alarm_enable(struct device *dev, unsigned int enable)
+{
+ struct t110_monitor *m=dev_get_drvdata(dev);int ret;
+ mutex_lock(&m->lock);ret=t110_rtc_ctrl(m,enable?1:0,1,0);mutex_unlock(&m->lock);return ret;
+}
+static const struct rtc_class_ops t110_rtc_ops={
+ .read_time=t110_rtc_read_time,.set_time=t110_rtc_set_time,
+ .read_alarm=t110_rtc_read_alarm,.set_alarm=t110_rtc_set_alarm,.alarm_irq_enable=t110_rtc_alarm_enable,
+};
+static irqreturn_t t110_pmic_irq(int irq, void *data)
+{
+ struct t110_monitor *m=data;unsigned int status;int ret;bool alarm=false;
+ mutex_lock(&m->lock);ret=regmap_read(m->base,5,&status);
+ if(!ret && (status&T110_RTC_IRQ)){
+  ret=t110_rtc_ctrl(m,0,1,T110_RTC_ACK);alarm=!ret;
+ }
+ if(!ret)ret=regmap_write(m->base,5,status&(T110_ONKEY_IRQ|T110_RTC_IRQ));
+ mutex_unlock(&m->lock);
+ if(ret){dev_err_ratelimited(m->rtc->dev.parent,"PM822 IRQ I/O failed: %d\n",ret);return IRQ_NONE;}
+ if(alarm){rtc_update_irq(m->rtc,1,RTC_IRQF|RTC_AF);pm_wakeup_event(m->rtc->dev.parent,0);}
+ return (status&(T110_ONKEY_IRQ|T110_RTC_IRQ))?IRQ_HANDLED:IRQ_NONE;
+}
+static void t110_rtc_cleanup(void *data)
+{
+ struct t110_monitor *m=data;
+ t110_rtc_ctrl(m,0,1,T110_RTC_ACK);
+ regmap_write(m->base,9,m->saved_int_en);
+ regmap_write(m->base,0x0e,m->saved_irq_cfg);
+ if(m->owns_wakeup)device_init_wakeup(m->rtc->dev.parent,false);
+}
+static int t110_rtc_setup(struct i2c_client *client, struct t110_monitor *m)
+{
+ struct device *dev=&client->dev;unsigned int en2,en3;int ret;
+ if(client->irq<=0)return -EINVAL;
+ ret=regmap_read(m->base,9,&m->saved_int_en);if(ret)return ret;
+ ret=regmap_read(m->base,10,&en2);if(ret)return ret;
+ ret=regmap_read(m->base,11,&en3);if(ret)return ret;
+ if((m->saved_int_en&~0x11)||en2||en3)return dev_err_probe(dev,-EBUSY,"Unexpected enabled PM822 IRQ clients\n");
+ ret=regmap_read(m->base,0x0e,&m->saved_irq_cfg);if(ret)return ret;
+ m->rtc=devm_rtc_allocate_device(dev);if(IS_ERR(m->rtc))return PTR_ERR(m->rtc);
+ m->rtc->ops=&t110_rtc_ops;m->rtc->range_min=0;m->rtc->range_max=U32_MAX;
+ m->irq=client->irq;
+ if(!device_can_wakeup(dev)){ret=device_init_wakeup(dev,true);if(ret)return ret;m->owns_wakeup=true;}
+ ret=devm_add_action_or_reset(dev,t110_rtc_cleanup,m);if(ret)return ret;
+ ret=devm_request_threaded_irq(dev,m->irq,NULL,t110_pmic_irq,IRQF_ONESHOT,"t110-pm822",m);if(ret)return ret;
+ /* Vendor mode: low-active pin, write-one-to-clear, masked status suppressed.
+  * Preserve watchdog configuration in the upper WAKEUP2 bits. */
+ ret=regmap_update_bits(m->base,0x0e,7,2);if(ret)return ret;
+ ret=regmap_write(m->base,5,0x11);if(ret)return ret;
+ ret=devm_rtc_register_device(m->rtc);if(ret)return ret;
+ ret=regmap_write(m->base,9,m->saved_int_en|0x11);if(ret)return ret;
+ dev_info(dev,"PM822 RTC and ONKEY wake on IRQ %d\n",m->irq);return 0;
+}
+static int t110_monitor_suspend(struct device *dev)
+{
+ struct t110_monitor *m=dev_get_drvdata(dev);int ret=0;
+ cancel_delayed_work_sync(&m->fuel_work);
+ if(device_may_wakeup(dev))ret=enable_irq_wake(m->irq);
+ if(ret)schedule_delayed_work(&m->fuel_work,5*HZ);
+ return ret;
+}
+static int t110_monitor_resume(struct device *dev)
+{
+ struct t110_monitor *m=dev_get_drvdata(dev);
+ if(device_may_wakeup(dev))disable_irq_wake(m->irq);
+ /* Consume a held wake press until release: do not immediately reblank. */
+ WRITE_ONCE(m->suppress_power,true);
+ schedule_delayed_work(&m->fuel_work,5*HZ);return 0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(t110_monitor_pm,t110_monitor_suspend,t110_monitor_resume);
diff --git a/arch/arm/mach-mmp/t110-sleep.S b/arch/arm/mach-mmp/t110-sleep.S
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/t110-sleep.S
@@ -0,0 +1,113 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+#include <asm/asm-offsets.h>
+#include <asm/hardware/cache-l2x0.h>
+.text
+.align 5
+ENTRY(t110_cpu_resume)
+ /* The warm vector is shared. An offline CPU1 must never restore CPU0's
+  * suspend context if a cluster wake releases it as well. */
+ mrc p15, 0, r0, c0, c0, 5
+ ands r0, r0, #15
+ beq 8f
+ ldr r1, =0x08140040
+ str r0, [r1]
+ dsb sy
+9: wfi
+ b 9b
+8:
+ ldr r1, =0x08140008
+ mov r2, #3
+ str r2, [r1]
+ dsb sy
+ mov r0, #0
+ mcr p15, 0, r0, c7, c5, 0
+ bl v7_invalidate_l1
+ /* A0 cluster C2 can reset the SCU controller and tags; L2 SRAM is retained. */
+ ldr r1, =0xd1dfe000
+ ldr r2, [r1]
+ ldr r3, =0x08140010
+ str r2, [r3]
+ tst r2, #1
+ bne 1f
+ orr r2, r2, #0x21
+ str r2, [r1]
+ mov r2, #0xff
+ str r2, [r1, #0xc]
+1:
+ /* Return CPU0's power status to NORMAL before context restore. */
+ ldr r1, =0xd1dfe008
+ ldrb r2, [r1]
+ bic r2, r2, #3
+ strb r2, [r1]
+ dsb sy
+ ldr r1, =0x08140008
+ mov r2, #4
+ str r2, [r1]
+ dsb sy
+ /* Restore a reset PL310 controller without invalidating retained dirty SRAM. */
+ ldr r1, =0xd1dfb000
+ ldr r2, [r1, #L2X0_CTRL]
+ ldr r3, =0x08140014
+ str r2, [r3]
+ tst r2, #1
+ bne 2f
+ /* Derive the physical symbol address from this running physical PC. */
+ adr r3, t110_cpu_resume
+ ldr r4, =t110_cpu_resume
+ sub r3, r3, r4
+ ldr r2, =l2x0_saved_regs
+ add r2, r2, r3
+ ldr r3, [r2, #L2X0_R_AUX_CTRL]
+ str r3, [r1, #L2X0_AUX_CTRL]
+ ldr r3, [r2, #L2X0_R_TAG_LATENCY]
+ str r3, [r1, #L310_TAG_LATENCY_CTRL]
+ ldr r3, [r2, #L2X0_R_DATA_LATENCY]
+ str r3, [r1, #L310_DATA_LATENCY_CTRL]
+ ldr r3, [r2, #L2X0_R_FILTER_END]
+ str r3, [r1, #L310_ADDR_FILTER_END]
+ ldr r3, [r2, #L2X0_R_FILTER_START]
+ str r3, [r1, #L310_ADDR_FILTER_START]
+ ldr r3, [r2, #L2X0_R_PREFETCH_CTRL]
+ str r3, [r1, #L310_PREFETCH_CTRL]
+ ldr r3, [r2, #L2X0_R_PWR_CTRL]
+ str r3, [r1, #L310_POWER_CTRL]
+ mov r3, #1
+ str r3, [r1, #L2X0_CTRL]
+ dsb sy
+2:
+ ldr r1, =0x08140008
+ mov r2, #5
+ str r2, [r1]
+ dsb sy
+ b cpu_resume
+ENDPROC(t110_cpu_resume)
+
+/* Relocatable, MMU-off SRAM probe: inspect ranks before the first DDR access.
+ * All literals and the initial result stores live in the copied SRAM blob. */
+.align 5
+.global t110_sram_probe, t110_sram_probe_end, t110_sram_target
+ t110_sram_probe:
+ ldr r0, 10f
+ ldr r1, [r0]
+ adr r2, 12f
+ str r1, [r2]
+ ldr r0, 11f
+ ldr r3, [r0]
+ str r3, [r2, #4]
+ dsb sy
+ /* Only after capturing do we touch reserved DDR for persistent logging. */
+ ldr r0, 13f
+ str r1, [r0]
+ str r3, [r0, #4]
+ mov r1, #1
+ str r1, [r0, #8]
+ dsb sy
+ ldr pc, t110_sram_target
+10: .word 0xc0100008
+11: .word 0xc0100004
+12: .word 0, 0
+13: .word 0x08140090
+t110_sram_target: .word 0
+t110_sram_probe_end:
diff --git a/arch/arm/mach-mmp/t110-sleep.h b/arch/arm/mach-mmp/t110-sleep.h
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/t110-sleep.h
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T110 A0 staged suspend: individual CPU power collapse, shared cache retained. */
+#include <linux/cpu_pm.h>
+#include <linux/suspend.h>
+#include <linux/cpu.h>
+#include <asm/suspend.h>
+#include <asm/cacheflush.h>
+#include <asm/cp15.h>
+#include <asm/proc-fns.h>
+#include <asm/outercache.h>
+#include <asm/hardware/cache-l2x0.h>
+extern void t110_cpu_resume(void);
+static unsigned int cpu0_resumes, cpu0_aborts,ddr_cycles,last_awucrs;
+static u32 ddr_idle_cycles,ddr_commands,ddr_no_util;
+static int t110_finish_sleep(unsigned long unused)
+{
+ v7_exit_coherency_flush(louis);
+ scu_power_mode(t110_scu, SCU_PM_POWEROFF);
+ /* Vendor pxa988_finish_suspend quiesces PL310 after L1/coherency exit.
+  * CPU1 is already offline and IRQs disabled, as outer_disable requires.
+  * Keep L2 SRAM power control unchanged; only clean/invalidate/disable. */
+ if(READ_ONCE(l2_quiesce))outer_disable();
+ writel(2,sleep_trace+8);dsb(sy);
+ cpu_do_idle();
+ /* No reset means entry was aborted; restore coherency before returning. */
+ if(READ_ONCE(l2_quiesce))outer_resume();
+ scu_power_mode(t110_scu, SCU_PM_NORMAL);
+ asm volatile("mrc p15, 0, %0, c1, c0, 1\n"
+              "orr %0, %0, #64\n"
+              "mcr p15, 0, %0, c1, c0, 1\n"
+              "isb\n"
+              "mrc p15, 0, %0, c1, c0, 0\n"
+              "orr %0, %0, #4\n"
+              "mcr p15, 0, %0, c1, c0, 0\n"
+              "isb" : "=&r" (unused) : : "memory");
+ return -EAGAIN;
+}
+static int t110_standby_enter(suspend_state_t state)
+{
+ u32 core, apcr, mask, vector,mp0,mp1,before,scu,timer,icu_pmic,icu_gpio,ciu_mc,bidle,bcmd,bno,cpcr,lcd_clock,dsi_clock;int ret;
+ if(state != PM_SUSPEND_STANDBY || num_online_cpus()!=1)return -EINVAL;
+ if(READ_ONCE(ddr_level)==3 && (!(readl(MPMU_REG(0x1020))&BIT(0)) || (readl(MPMU_REG(0x20))&0x2c)!=0x2c))return -EBUSY;
+ if(READ_ONCE(ddr_level) && (readl(MPMU_REG(0))&BIT(15))) {pr_err("t110-sleep: CP masks PMIC wake port 7; refusing DDR vote\n");return -EOPNOTSUPP;}
+ core=readl(APMU_REG(0x124));apcr=readl(MPMU_REG(0x1000));
+ mask=readl(MPMU_REG(0x104c));vector=readl(CIU_REG(0xd8));
+ mp0=readl(APMU_REG(0x120));mp1=readl(APMU_REG(0xe4));
+ scu=readl(t110_scu);timer=readl(APMU_REG(0x84));
+ ciu_mc=readl(CIU_REG(0x40));
+ cpcr=readl(MPMU_REG(0));
+ lcd_clock=readl(APMU_REG(0x4c));dsi_clock=readl(APMU_REG(0x44));
+ icu_pmic=readl(AXI_VIRT_BASE+0x82010);
+ icu_gpio=readl(AXI_VIRT_BASE+0x820c4);
+ ret=cpu_pm_enter();if(ret)return ret;
+ if(READ_ONCE(ddr_level)) {
+  ret=cpu_cluster_pm_enter();if(ret){cpu_pm_exit();return ret;}
+  /* The always-on ICU wake generator must mirror the PMIC GIC route.
+   * Vendor wakeupgen.c: SPI4, CPU0, IRQ, nonzero priority. Global ICU
+   * delivery remains masked; this is the wake path, not a second handler. */
+  writel((icu_pmic & ~((0xf<<6)|0xf))|BIT(6)|BIT(4)|1,AXI_VIRT_BASE+0x82010);
+  writel((icu_gpio & ~((0xf<<6)|0xf))|BIT(6)|BIT(4)|1,AXI_VIRT_BASE+0x820c4);
+  __cpuc_flush_dcache_area(&l2x0_saved_regs,sizeof(l2x0_saved_regs));
+  outer_clean_range(__pa_symbol(&l2x0_saved_regs),__pa_symbol(&l2x0_saved_regs)+sizeof(l2x0_saved_regs));
+ }
+ writel(READ_ONCE(sram_probe_enabled)?sram_probe_phys:__pa_symbol(t110_cpu_resume),CIU_REG(0xd8));
+ writel(0,sleep_trace+0x98);
+ /* PMIC line 7 plus the asynchronous/full-idle abort paths, no DDR votes. */
+ writel(mask|BIT(2)|BIT(7)|BIT(24)|BIT(25),MPMU_REG(0x104c));
+ writel(apcr & ~(BIT(13)|BIT(15)|BIT(21)),MPMU_REG(0x1000));
+ if(READ_ONCE(ddr_level)) {
+  /* Vendor A0 entry prerequisites: SCU idle handshake and 10us stability. */
+  writel(scu|BIT(5),t110_scu);writel(0x28207,APMU_REG(0x84));
+  /* Vendor A0 cluster C2, retaining L2 SRAM and its dirty cache contents. */
+  writel(mp0|BIT(0)|BIT(1)|BIT(3)|BIT(11),APMU_REG(0x120));writel(mp1|BIT(0)|BIT(1)|BIT(3)|BIT(11),APMU_REG(0xe4));
+  /* Board-only experiment: CP and MSA must both be held in reset. Match
+   * the domain sleep votes, without UDR or oscillator shutdown. */
+  if(READ_ONCE(ddr_level)==3)
+   writel((cpcr & ~BIT(13)) | BIT(30)|BIT(28)|BIT(25)|BIT(14)|BIT(31)|BIT(29)|BIT(27)|BIT(26),MPMU_REG(0));
+  /* PXA986 baseline differs from PXA988: vendor init sets DSPSD bit30
+   * only for cpu_is_pxa988(). TWRP on this A0 board reads APCR=12004000.
+   * Clear DSPSD explicitly so a stale PXA988 vote cannot survive. */
+  if(READ_ONCE(ddr_level)==1 || READ_ONCE(ddr_level)==3)
+   writel((apcr & ~(BIT(30)|BIT(13)|BIT(15)|BIT(21))) | BIT(28)|BIT(25)|BIT(14)|BIT(31)|BIT(29)|BIT(27)|BIT(26),MPMU_REG(0x1000));
+  /* Vendor POWER_MODE_UDR_VCTCXO differs from SYS_SLEEP by STBYEN.
+   * Keep oscillator on and L2 SRAM retained; this is an opt-in experiment. */
+  if(READ_ONCE(standby_request) && (READ_ONCE(ddr_level)==1 || READ_ONCE(ddr_level)==3))
+   writel(readl(MPMU_REG(0x1000))|BIT(13),MPMU_REG(0x1000));
+ }
+ before=readl(sleep_mc+0x450);
+ bidle=readl(sleep_mc+0x454);bcmd=readl(sleep_mc+0x458);bno=readl(sleep_mc+0x45c);
+ /* Vendor clock-pxa988.c A0 MCK4/AXI dynamic gating setup. The setting
+  * is restricted to this quiesced test and restored immediately on return. */
+ if(READ_ONCE(sleep_gating))
+  writel((ciu_mc & ~(BIT(16)|BIT(19))) | (0xff<<8) | BIT(17)|BIT(18)|BIT(20)|BIT(21)|BIT(26)|BIT(27),CIU_REG(0x40));
+ writel(ciu_mc,sleep_trace+0x80);writel(readl(CIU_REG(0x40)),sleep_trace+0x84);
+ writel(0x54313130,sleep_trace);writel(ddr_level,sleep_trace+4);writel(1,sleep_trace+8);
+ writel(0,sleep_trace+0x40);writel(0xffffffff,sleep_trace+0x10);writel(0xffffffff,sleep_trace+0x14);
+ writel(core|0x1f,APMU_REG(0x124));
+ writel(readl(AXI_VIRT_BASE+0x82010),sleep_trace+0x18);
+ writel(readl(AXI_VIRT_BASE+0x82114),sleep_trace+0x1c);
+ /* DRM has stopped all scanout fetches. Vendor clock-pxa988.c defines
+  * LCD AXI/HCLK/FCLK enables as bits3/5/4 and DSI PHY enables as bits2/5.
+  * Keep resets, PLL selection and dividers untouched. All device IRQs are
+  * suspended here; restore clocks before device resume touches LCD MMIO. */
+ if(READ_ONCE(display_gating)) {
+  writel(dsi_clock & ~(BIT(2)|BIT(5)),APMU_REG(0x44));
+  writel(lcd_clock & ~(BIT(3)|BIT(4)|BIT(5)),APMU_REG(0x4c));
+ }
+ writel(readl(APMU_REG(0x4c)),sleep_trace+0xa0);
+ writel(readl(APMU_REG(0x44)),sleep_trace+0xa4);
+ writel(readl(APMU_REG(0x5c)),sleep_trace+0xa8);
+ dsb(sy);
+ pr_info("t110-sleep: enter level=%u core=%08x mp=%08x/%08x apcr=%08x cpcr=%08x wake=%08x mc_sleep=%08x\n",ddr_level,readl(APMU_REG(0x124)),readl(APMU_REG(0x120)),readl(APMU_REG(0xe4)),readl(MPMU_REG(0x1000)),readl(MPMU_REG(0)),readl(MPMU_REG(0x104c)),readl(APMU_REG(0xb0)));
+ ret=cpu_suspend(0,t110_finish_sleep);
+ if(READ_ONCE(l2_quiesce))outer_resume();
+ if(READ_ONCE(display_gating)) {
+  writel(lcd_clock,APMU_REG(0x4c));readl(APMU_REG(0x4c));udelay(20);
+  writel(dsi_clock,APMU_REG(0x44));readl(APMU_REG(0x44));udelay(20);
+ }
+ writel(ciu_mc,CIU_REG(0x40));dsb(sy);
+ writel(cpcr,MPMU_REG(0));
+ writel(6,sleep_trace+8);dsb(sy);
+ ddr_cycles=readl(sleep_mc+0x450)-before;last_awucrs=readl(MPMU_REG(0x1048));
+ ddr_idle_cycles=readl(sleep_mc+0x454)-bidle;ddr_commands=readl(sleep_mc+0x458)-bcmd;ddr_no_util=readl(sleep_mc+0x45c)-bno;
+ writel(mp0,APMU_REG(0x120));writel(mp1,APMU_REG(0xe4));
+ writel(scu,t110_scu);writel(timer,APMU_REG(0x84));
+ writel(core,APMU_REG(0x124));
+ writel(apcr,MPMU_REG(0x1000));writel(mask,MPMU_REG(0x104c));
+ writel(vector,CIU_REG(0xd8));dsb(sy);
+ writel(icu_pmic,AXI_VIRT_BASE+0x82010);
+ writel(icu_gpio,AXI_VIRT_BASE+0x820c4);
+ if(READ_ONCE(ddr_level))cpu_cluster_pm_exit();
+ writel(7,sleep_trace+8);dsb(sy);
+ cpu_pm_exit();
+ if(!ret)cpu0_resumes++;else cpu0_aborts++;
+ pr_info("t110-sleep: CPU0 C2 ret=%d resumes=%u aborts=%u status=%08x\n",ret,cpu0_resumes,cpu0_aborts,readl(APMU_REG(0x90)));
+ return ret;
+}
+static int t110_standby_valid(suspend_state_t state)
+{
+ return state==PM_SUSPEND_STANDBY;
+}
+static const struct platform_suspend_ops t110_suspend_ops={
+ .valid=t110_standby_valid,
+ .enter=t110_standby_enter,
+};
diff --git a/arch/arm/mach-mmp/t110-vpu-probe.c b/arch/arm/mach-mmp/t110-vpu-probe.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/t110-vpu-probe.c
@@ -0,0 +1,203 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded SM-T110 CODA7542 firmware identification test. Root only. */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/miscdevice.h>
+#include <linux/fs.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/dma-mapping.h>
+#include <linux/firmware.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/unaligned.h>
+#include <linux/uaccess.h>
+#include <linux/suspend.h>
+#include <linux/dma-buf.h>
+#include <linux/scatterlist.h>
+#include <linux/file.h>
+static bool powered;
+static u32 savedclk;
+static int opened;
+#define MEMSIZE 0x1000000
+static struct platform_device *pdev;
+static void __iomem *apmu,*regs;
+static void *mem;
+static dma_addr_t dma;
+static DEFINE_MUTEX(lock);
+static unsigned int exports;
+static struct sg_table *probe_map(struct dma_buf_attachment *a,enum dma_data_direction dir)
+{
+ struct sg_table *sg=kzalloc(sizeof(*sg),GFP_KERNEL);int ret;
+ if(!sg)return ERR_PTR(-ENOMEM);
+ ret=dma_get_sgtable(&pdev->dev,sg,mem,dma,MEMSIZE);
+ if(ret){kfree(sg);return ERR_PTR(ret);}
+ ret=dma_map_sgtable(a->dev,sg,dir,0);
+ if(ret){sg_free_table(sg);kfree(sg);return ERR_PTR(ret);}
+ return sg;
+}
+static void probe_unmap(struct dma_buf_attachment *a,struct sg_table *sg,enum dma_data_direction dir)
+{dma_unmap_sgtable(a->dev,sg,dir,0);sg_free_table(sg);kfree(sg);}
+static void probe_dmabuf_release(struct dma_buf *buf)
+{
+ mutex_lock(&lock);exports--;
+ if(!exports&&!opened&&mem){dma_free_coherent(&pdev->dev,MEMSIZE,mem,dma);mem=NULL;}
+ mutex_unlock(&lock);
+}
+static int probe_dmabuf_mmap(struct dma_buf *buf,struct vm_area_struct *vma)
+{
+ if(vma->vm_pgoff || vma->vm_end-vma->vm_start!=MEMSIZE)return -EINVAL;
+ return dma_mmap_coherent(&pdev->dev,vma,mem,dma,MEMSIZE);
+}
+static const struct dma_buf_ops dma_ops={.map_dma_buf=probe_map,.unmap_dma_buf=probe_unmap,.release=probe_dmabuf_release,.mmap=probe_dmabuf_mmap};
+static int status_get(char *buf,const struct kernel_param *kp)
+{
+ int n;mutex_lock(&lock);
+ n=scnprintf(buf,PAGE_SIZE,"opened=%d powered=%d dma_allocated=%d exports=%u clock=%08x power=%08x busy=%08x pc=%08x\n",opened,powered,!!mem,exports,readl(apmu+0xa4),readl(apmu+0xf0),powered?readl(regs+0x160):0,powered?readl(regs+0x18):0);
+ mutex_unlock(&lock);return n;
+}
+static const struct kernel_param_ops status_ops={.get=status_get};
+module_param_cb(status,&status_ops,NULL,0400);
+static void regwrite(u32 off,u32 v){writel(v,regs+off);}
+static int test_firmware(void)
+{
+ const struct firmware *fw;u32 oldclk,oldpwr,v,ver=0;int ret,i;
+ ret=request_firmware(&fw,"t110-coda7542-stock.bin",&pdev->dev);
+ if(ret)return ret;
+ if(fw->size!=0x28000){release_firmware(fw);return -EINVAL;}
+ oldclk=readl(apmu+0xa4);oldpwr=readl(apmu+0xd8);
+ if(powered){ret=0;goto release;}
+ if(oldpwr&BIT(2)){ret=-EBUSY;goto release;}
+ savedclk=oldclk;
+ /* Vendor PXA986 automatic VPU power sequence. Other power bits retained. */
+ writel(oldclk|BIT(19),apmu+0xa4);
+ writel(0x20001fff,apmu+0xdc);
+ writel(readl(apmu+0xd8)|BIT(2),apmu+0xd8);
+ ret=readl_poll_timeout(apmu+0xf0,v,v&BIT(2),10,3000);
+ if(ret)goto poweroff;
+ /* PLL1_624 /4 =156 MHz for both AXI and functional clocks.
+  * Vendor DIV fields store divisor-minus-one. */
+ v=readl(apmu+0xa4);
+ v&=~((3<<6)|(7<<8)|(3<<11)|(7<<13));
+ v|=BIT(6)|BIT(11)|(3<<8)|(3<<13)|BIT(3)|BIT(4)|BIT(5)|BIT(19);
+ writel(v|BIT(20)|BIT(21),apmu+0xa4);
+ ret=readl_poll_timeout(apmu+0xa4,v,!(v&(BIT(20)|BIT(21))),10,3000);
+ if(ret)goto poweroff;
+ /* Release AXI, functional and AHB resets. */
+ writel(v|7,apmu+0xa4);udelay(10);
+ regwrite(0,0);
+ memset(mem,0,0x100000);
+ /* Same 64-bit memory order as original HAL: reverse each four u16s. */
+ for(i=0;i<fw->size/2;i++)
+  ((u16 *)mem)[i^3]=get_unaligned_le16(fw->data+2*i);
+ regwrite(0x100,dma);regwrite(0x104,dma+0x32000);
+ regwrite(0x108,dma+0xeb000);regwrite(0x10c,8);
+ regwrite(0x110,0);regwrite(0x170,0);
+ for(i=0;i<2048;i++)regwrite(4,(i<<16)|get_unaligned_le16(fw->data+i*2));
+ wmb();regwrite(0x160,1);regwrite(0,1);
+ ret=readl_poll_timeout(regs+0x160,v,!v,100,500000);
+ pr_info("T110_VPU: boot ret=%d PC=%08x busy=%08x clock=%08x\n",ret,readl(regs+0x18),v,readl(apmu+0xa4));
+ if(ret)goto stop;
+ regwrite(0x1c0,0);regwrite(0x160,1);
+ regwrite(0x168,0);regwrite(0x16c,0);regwrite(0x164,0xf);
+ ret=readl_poll_timeout(regs+0x160,v,!v,100,500000);
+ ver=readl(regs+0x1c0);
+ pr_info("T110_VPU: version ret=%d version=%08x PC=%08x\n",ret,ver,readl(regs+0x18));
+ if(!ret&&!ver)ret=-ENODEV;
+ if(!ret){powered=true;goto release;}
+stop:
+ regwrite(0x170,0);regwrite(0,0);regwrite(0xc,1);
+poweroff:
+ writel(readl(apmu+0xa4)&~0x3f,apmu+0xa4);
+ writel(readl(apmu+0xd8)&~BIT(2),apmu+0xd8);
+ if(readl_poll_timeout(apmu+0xf0,v,!(v&BIT(2)),10,3000))pr_err("T110_VPU: power-off timeout\n");
+ writel(oldclk,apmu+0xa4);
+release:
+ release_firmware(fw);return ret;
+}
+static long probe_ioctl(struct file *f,unsigned int cmd,unsigned long arg)
+{
+ int ret;
+ if(cmd==0x5604){
+  DEFINE_DMA_BUF_EXPORT_INFO(info);struct dma_buf *buf;
+  if(!capable(CAP_SYS_RAWIO))return -EPERM;
+  info.ops=&dma_ops;info.size=MEMSIZE;info.flags=O_RDWR;info.priv=&exports;
+  mutex_lock(&lock);exports++;mutex_unlock(&lock);
+  buf=dma_buf_export(&info);
+  if(IS_ERR(buf)){mutex_lock(&lock);exports--;mutex_unlock(&lock);return PTR_ERR(buf);}
+  ret=dma_buf_fd(buf,O_CLOEXEC);if(ret<0)dma_buf_put(buf);return ret;
+ }
+ if(cmd==0x5602)return put_user((u32)dma,(u32 __user *)arg);
+ if(cmd!=0x5601)return -ENOTTY;
+ if(!capable(CAP_SYS_RAWIO))return -EPERM;
+ if(!mutex_trylock(&lock))return -EBUSY;
+ ret=test_firmware();mutex_unlock(&lock);return ret;
+}
+static int probe_open(struct inode *ino,struct file *file)
+{
+ if(!capable(CAP_SYS_RAWIO))return -EPERM;
+ mutex_lock(&lock);
+ if(opened){mutex_unlock(&lock);return -EBUSY;}
+ if(!mem)mem=dma_alloc_coherent(&pdev->dev,MEMSIZE,&dma,GFP_KERNEL);
+ if(!mem){mutex_unlock(&lock);return -ENOMEM;}
+ opened=1;mutex_unlock(&lock);return 0;
+}
+static int probe_close(struct inode *ino,struct file *file)
+{
+ u32 v;mutex_lock(&lock);
+ if(powered){
+  regwrite(0x170,0);regwrite(0,0);regwrite(0xc,1);
+  writel(readl(apmu+0xa4)&~0x3f,apmu+0xa4);
+  writel(readl(apmu+0xd8)&~BIT(2),apmu+0xd8);
+  if(readl_poll_timeout(apmu+0xf0,v,!(v&BIT(2)),10,3000))pr_err("T110_VPU: close power-off timeout\n");
+  writel(savedclk,apmu+0xa4);powered=false;
+ }
+ opened=0;
+ if(!exports){dma_free_coherent(&pdev->dev,MEMSIZE,mem,dma);mem=NULL;}
+ mutex_unlock(&lock);return 0;
+}
+static int probe_mmap(struct file *file,struct vm_area_struct *vma)
+{
+ unsigned long size=vma->vm_end-vma->vm_start;
+ if(!capable(CAP_SYS_RAWIO))return -EPERM;
+ if(vma->vm_pgoff==0 && size==PAGE_SIZE){
+  vma->vm_page_prot=pgprot_noncached(vma->vm_page_prot);
+  return vm_iomap_memory(vma,0xd420d000,PAGE_SIZE);
+ }
+ if(vma->vm_pgoff!=1 || size!=MEMSIZE)return -EINVAL;
+ vma->vm_pgoff=0;
+ return dma_mmap_coherent(&pdev->dev,vma,mem,dma,MEMSIZE);
+}
+static const struct file_operations fops={.owner=THIS_MODULE,.unlocked_ioctl=probe_ioctl,.open=probe_open,.release=probe_close,.mmap=probe_mmap};
+static struct miscdevice misc={.minor=MISC_DYNAMIC_MINOR,.name="t110-vpu-probe",.fops=&fops,.mode=0600};
+static int probe_pm(struct notifier_block *nb,unsigned long action,void *unused)
+{
+ if(action==PM_SUSPEND_PREPARE && READ_ONCE(opened))return NOTIFY_BAD;
+ return NOTIFY_OK;
+}
+static struct notifier_block probe_pm_nb={.notifier_call=probe_pm};
+static int __init init_probe(void)
+{
+ int ret;
+ if(!of_machine_is_compatible("samsung,goyawifi"))return -ENODEV;
+ pdev=platform_device_register_simple("t110-vpu-probe",-1,NULL,0);
+ if(IS_ERR(pdev))return PTR_ERR(pdev);
+ ret=dma_coerce_mask_and_coherent(&pdev->dev,DMA_BIT_MASK(32));if(ret)goto device;
+ apmu=ioremap(0xd4282800,0x100);regs=ioremap(0xd420d000,0x1000);
+ if(!apmu||!regs){ret=-ENOMEM;goto maps;}
+ ret=misc_register(&misc);if(!ret){register_pm_notifier(&probe_pm_nb);return 0;}
+maps:
+ if(apmu)iounmap(apmu);
+ if(regs)iounmap(regs);
+device:
+ platform_device_unregister(pdev);return ret;
+}
+static void __exit exit_probe(void)
+{
+ unregister_pm_notifier(&probe_pm_nb);misc_deregister(&misc);
+ iounmap(regs);iounmap(apmu);platform_device_unregister(pdev);
+}
+module_init(init_probe);module_exit(exit_probe);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("SM-T110 bounded CODA7542 identification probe");
+MODULE_IMPORT_NS("DMA_BUF");
