+#include <asm/smp_scu.h>
+#include "addr-map.h"
+
+static void __iomem *t110_scu;
+static u32 core1_saved;
+static void __iomem *sleep_mc;
+static void __iomem *sleep_trace;
+static unsigned int ddr_level;
+static bool sleep_gating;
+static bool display_gating;
+static bool standby_request;
+static bool l2_quiesce;
+static bool sram_probe_enabled;
+static phys_addr_t sram_probe_phys;
+extern char t110_sram_probe[],t110_sram_probe_end[],t110_sram_target[];
+static bool core1_off;
+
+static void __init pxa98x_prepare_cpus(unsigned int max_cpus)
+{
+	void __iomem *scu = ioremap(0xd1dfe000, SZ_256);
+	if (!scu) panic("PXA98x: cannot map SCU");
+	pr_info("T110_SMP_C: SCU cores=%u control=%08x CC2_AP=%08x\n",
+		scu_get_core_count(scu), readl(scu), readl(APMU_REG(0x100)));
+	scu_enable(scu);
+	t110_scu = scu;
+}
+
+static int pxa98x_boot_secondary(unsigned int cpu, struct task_struct *idle)
+{
+	u32 reset, entry = __pa_symbol(secondary_startup);
+	if (cpu != 1) return -EINVAL;
+	if (core1_off) {
+		/* Restore the retained SCU CPU slot before the normal reset path. */
+		writeb(readb(t110_scu + 9) & ~3, t110_scu + 9);
+		writel(core1_saved, APMU_REG(0x128));
+		core1_off = false;
+		dsb(sy);
+	}
+	/* No TrustZone hypervisor on goyawifi. ROM reads this DDR entry. */
+	writel(entry, CIU_REG(0xd8));
+	readl(CIU_REG(0xd8));
+	dsb(sy);
+	reset = readl(APMU_REG(0x100));
+	pr_info("T110_SMP_C: CPU%u entry=%08x CC2_AP=%08x\n", cpu, entry, reset);
+	/* Reset CPU1 if the bootloader left it in an old holding pen. */
+	if (!(reset & BIT(20))) {
+		writel(reset | BIT(20), APMU_REG(0x100));
+		readl(APMU_REG(0x100));
+		udelay(10);
+	}
+	/* Vendor PXA988 core/debug/watchdog reset bits for CPU1. */
+	writel(reset & ~(BIT(20) | BIT(22) | BIT(23)), APMU_REG(0x100));
+	readl(APMU_REG(0x100));
+	writel(BIT(1), APMU_REG(0x12c));
+	dsb(sy);
+	return 0;
+}
+
+static void pxa98x_secondary_init(unsigned int cpu)
+{
+	pr_info("T110_SMP_C: CPU%u reached secondary init\n", cpu);
+}
+
+#ifdef CONFIG_HOTPLUG_CPU
+static int pxa98x_cpu_disable(unsigned int cpu)
+{
+	return cpu == 1 ? 0 : -EPERM;
+}
+static void pxa98x_cpu_die(unsigned int cpu)
+{
+	/* CPU0 and PL310 remain running. No MP/SCU or DDR shutdown here. */
+	core1_saved = readl(APMU_REG(0x128));
+	core1_off = true;
+	smp_wmb();
+	writel(core1_saved | 0x1f, APMU_REG(0x128));
+	/* Use the ARMv7 local-cache/coherency shutdown sequence. */
+	v7_exit_coherency_flush(louis);
+	scu_power_mode(t110_scu, SCU_PM_POWEROFF);
+	while (1)
+		cpu_do_idle();
+}
+static int pxa98x_cpu_kill(unsigned int cpu)
+{
+	u32 status;
+	int ret = readl_poll_timeout_atomic(APMU_REG(0x90), status,
+					  status & BIT(7), 10, 100000);
+	pr_info("t110-sleep: CPU1 off status=%08x rc=%d\n", status, ret);
+	return ret == 0;
+}
+#endif
+
+#include "t110-sleep.h"
+static ssize_t level_show(struct device *dev,struct device_attribute *a,char *buf)
+{ return sysfs_emit(buf,"%u\n",READ_ONCE(ddr_level)); }
