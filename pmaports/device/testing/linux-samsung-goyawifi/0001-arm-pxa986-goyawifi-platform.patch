diff --git a/arch/arm/mach-mmp/t110-fuel-model.h b/arch/arm/mach-mmp/t110-fuel-model.h
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/t110-fuel-model.h
@@ -0,0 +1,70 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* GOYA vendor two-RC software fuel model, rewritten with bounded 64-bit
+ * arithmetic. Current is inferred from the electrical model, NOT measured.
+ * 3600mAh design capacity, C1=1000F, C2=10000F, offset resistance32mOhm.
+ */
+#ifndef T110_FUEL_MODEL_H
+#define T110_FUEL_MODEL_H
+#ifdef __KERNEL__
+#include <linux/math64.h>
+static inline long long fg_div(long long n,int d){return div_s64(n,d);}
+#else
+static inline long long fg_div(long long n,int d){return n/d;}
+#endif
+#include "t110-ocv.h"
+#include "t110-fg-tables.h"
+struct t110_fuel_model {
+ long long soc; /* micro-percent,0..100000000 */
+ int v1_uv,v2_uv,rs_mohm,rp_mohm,current_ua;
+};
+static inline int fg_clamp(int value,int low,int high)
+{return value<low?low:value>high?high:value;}
+static inline int fg_lerp(int a,int b,int x,int x0,int x1)
+{return a+(b-a)*(x-x0)/(x1-x0);}
+static inline int fg_rtot(int charging,int current_ma,int temp_deci,int soc)
+{
+ int i,j,n=charging?4:6,nt=charging?4:5;
+ int t0=charging?-50:-200,a,b;
+ const int *bins=charging?chg_ib:dischg_ib;
+ int index=fg_clamp(soc,0,99);
+ current_ma=fg_clamp(current_ma,bins[0],bins[n-1]);
+ temp_deci=fg_clamp(temp_deci,t0,t0+(nt-1)*150);
+ for(i=1;i<n-1&&current_ma>bins[i];i++);
+ for(j=1;j<nt-1&&temp_deci>t0+j*150;j++);
+ if(charging) {
+  a=fg_lerp(chg_rtot[i-1][j-1][index],chg_rtot[i][j-1][index],current_ma,bins[i-1],bins[i]);
+  b=fg_lerp(chg_rtot[i-1][j][index],chg_rtot[i][j][index],current_ma,bins[i-1],bins[i]);
+ }else{
+  a=fg_lerp(dis_chg_rtot[i-1][j-1][index],dis_chg_rtot[i][j-1][index],current_ma,bins[i-1],bins[i]);
+  b=fg_lerp(dis_chg_rtot[i-1][j][index],dis_chg_rtot[i][j][index],current_ma,bins[i-1],bins[i]);
+ }
+ return fg_clamp(fg_lerp(a,b,temp_deci,t0+(j-1)*150,t0+j*150),30,6000);
+}
+static inline int fg_percent(const struct t110_fuel_model *m)
+{return fg_clamp(fg_div(m->soc+500000,1000000),0,100);}
+static inline void fg_seed(struct t110_fuel_model *m,int percent,int v1_uv,int v2_uv)
+{
+ m->soc=(long long)fg_clamp(percent,0,100)*1000000;
+ m->v1_uv=v1_uv;m->v2_uv=v2_uv;m->rs_mohm=120;m->rp_mohm=40;m->current_ua=0;
+}
+static inline void fg_step(struct t110_fuel_model *m,int voltage_uv,int temp_deci,int elapsed_ms,int full)
+{
+ int percent=fg_div(m->soc,1000000),ocv_uv,rtot,ib_ua,dt;
+ if(percent>=100)ocv_uv=t110_ocv[100]*1000;
+ else ocv_uv=t110_ocv[percent]*1000+fg_div((long long)(t110_ocv[percent+1]-t110_ocv[percent])*(m->soc-(long long)percent*1000000),1000);
+ ib_ua=fg_div((long long)(ocv_uv-voltage_uv-m->v1_uv-m->v2_uv)*1000,m->rs_mohm);
+ ib_ua=fg_clamp(ib_ua,-3000000,3000000);
+ /* Choose charge/discharge resistance by modeled net ib_ua sign:
+  * a USB-connected tablet can still draw from its battery under load. */
+ rtot=fg_rtot(ib_ua<0,ib_ua<0?-ib_ua/1000:ib_ua/1000,temp_deci,percent);
+ m->rp_mohm=rtot/3;m->rs_mohm=rtot/3+32;
+ dt=fg_clamp(elapsed_ms,0,5000);
+ m->v1_uv+=fg_div((fg_div((long long)ib_ua*m->rp_mohm,1000)-m->v1_uv)*dt,1000*m->rp_mohm);
+ m->v2_uv+=fg_div((fg_div((long long)ib_ua*m->rp_mohm,1000)-m->v2_uv)*dt,10000*m->rp_mohm);
+ m->soc-=fg_div((long long)ib_ua*dt*100,12960000);
+ if(m->soc<0)m->soc=0;
+ if(m->soc>100000000)m->soc=100000000;
+ if(full&&voltage_uv>=4250000)m->soc=100000000;
+ m->current_ua=ib_ua;
+}
+#endif
