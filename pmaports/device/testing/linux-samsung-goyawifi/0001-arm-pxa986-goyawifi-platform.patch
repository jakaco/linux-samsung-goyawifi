 	.notifier_call = twd_rate_change,
 };
 
+#ifdef CONFIG_T110_CPUFREQ
+/* Temporary board hook until PXA986 CPU/PERIPHCLK have a CCF provider.
+ * This board keeps PERIPHCLK=CPU/8 at every supported operating point.
+ * POSTCHANGE executes outside the clock transition's stop_machine section.
+ */
+static int t110_twd_cpufreq(struct notifier_block *nb, unsigned long event,
+                           void *data)
+{
+ struct cpufreq_freqs *f = data;
+ unsigned long rate = (unsigned long)f->new * 1000 / 8;
+ if (event == CPUFREQ_POSTCHANGE)
+  on_each_cpu(twd_update_frequency, &rate, 1);
+ return NOTIFY_OK;
+}
+static struct notifier_block t110_twd_nb = {
+ .notifier_call = t110_twd_cpufreq,
+};
+#endif
+
 static int twd_clk_init(void)
 {
+#ifdef CONFIG_T110_CPUFREQ
+ if (twd_evt && IS_ERR(twd_clk) && of_machine_is_compatible("samsung,goyawifi"))
+  return cpufreq_register_notifier(&t110_twd_nb, CPUFREQ_TRANSITION_NOTIFIER);
+#endif
 	if (twd_evt && raw_cpu_ptr(twd_evt) && !IS_ERR(twd_clk))
 		return clk_notifier_register(twd_clk, &twd_clk_nb);
 
