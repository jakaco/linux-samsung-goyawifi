+{
+ return sysfs_emit(buf,"magic=%08x level=%u stage=%u resume_scu=%08x resume_l2=%08x icu_pmic=%08x icu_mask=%08x cpu1_arrived=%u apsr=%08x cpsr=%08x aprr=%08x mc_req_ap=%08x mc_req_cp=%08x mc_req_msa=%08x\n",
+ readl(sleep_trace),readl(sleep_trace+4),readl(sleep_trace+8),readl(sleep_trace+0x10),readl(sleep_trace+0x14),readl(sleep_trace+0x18),readl(sleep_trace+0x1c),readl(sleep_trace+0x40),readl(MPMU_REG(0x1004)),readl(MPMU_REG(4)),readl(MPMU_REG(0x1020)),readl(APMU_REG(0xb4)),readl(APMU_REG(0xb8)),readl(APMU_REG(0xbc)));
+}
+static DEVICE_ATTR_RO(trace);
+static ssize_t gating_show(struct device *dev,struct device_attribute *a,char *buf)
+{return sysfs_emit(buf,"%u\n",READ_ONCE(sleep_gating));}
+static ssize_t gating_store(struct device *dev,struct device_attribute *a,const char *buf,size_t len)
+{bool v;int ret=kstrtobool(buf,&v);if(ret)return ret;WRITE_ONCE(sleep_gating,v);return len;}
+static DEVICE_ATTR_RW(gating);
+static ssize_t display_gating_show(struct device *dev,struct device_attribute *a,char *buf)
+{return sysfs_emit(buf,"enabled=%u entry_lcd=%08x entry_dsi=%08x entry_usb=%08x\n",READ_ONCE(display_gating),readl(sleep_trace+0xa0),readl(sleep_trace+0xa4),readl(sleep_trace+0xa8));}
+static ssize_t display_gating_store(struct device *dev,struct device_attribute *a,const char *buf,size_t len)
+{bool v;int ret=kstrtobool(buf,&v);if(ret)return ret;WRITE_ONCE(display_gating,v);return len;}
+static DEVICE_ATTR_RW(display_gating);
+static ssize_t standby_request_show(struct device *dev,struct device_attribute *a,char *buf)
+{return sysfs_emit(buf,"%u\n",READ_ONCE(standby_request));}
+static ssize_t standby_request_store(struct device *dev,struct device_attribute *a,const char *buf,size_t len)
+{bool v;int ret=kstrtobool(buf,&v);if(ret)return ret;WRITE_ONCE(standby_request,v);return len;}
+static DEVICE_ATTR_RW(standby_request);
+static ssize_t l2_quiesce_show(struct device *dev,struct device_attribute *a,char *buf)
+{return sysfs_emit(buf,"%u\n",READ_ONCE(l2_quiesce));}
+static ssize_t l2_quiesce_store(struct device *dev,struct device_attribute *a,const char *buf,size_t len)
+{bool v;int ret=kstrtobool(buf,&v);if(ret)return ret;WRITE_ONCE(l2_quiesce,v);return len;}
+static DEVICE_ATTR_RW(l2_quiesce);
+static ssize_t clocks_show(struct device *dev,struct device_attribute *a,char *buf)
+{
+ return sysfs_emit(buf,"ciu_mc=%08x apmu_debug=%08x idle_cfg=%08x sp_idle_cfg=%08x cpcr=%08x cprr=%08x apsr=%08x cpsr=%08x mc_status=%08x mc_dram=%08x mc_hw=%08x mc_sw=%08x mck4=%08x sleep_gating=%u counters=%08x/%08x/%08x/%08x pre_ciu=%08x used_ciu=%08x\n",
+ readl(CIU_REG(0x40)),readl(APMU_REG(0x88)),readl(APMU_REG(0x18)),readl(APMU_REG(0x14)),readl(MPMU_REG(0)),readl(MPMU_REG(0x20)),readl(MPMU_REG(0x1004)),readl(MPMU_REG(4)),readl(sleep_mc+4),readl(sleep_mc+8),readl(APMU_REG(0xb0)),readl(APMU_REG(0xc0)),readl(APMU_REG(0xe8)),READ_ONCE(sleep_gating),readl(sleep_mc+0x450),readl(sleep_mc+0x454),readl(sleep_mc+0x458),readl(sleep_mc+0x45c),readl(sleep_trace+0x80),readl(sleep_trace+0x84));
+}
+static DEVICE_ATTR_RO(clocks);
+static ssize_t activity_show(struct device *dev,struct device_attribute *a,char *buf)
+{
+ void __iomem *lcd=ioremap(0xd420b000,SZ_4K);u32 pn=~0,tv=~0,pn2=~0;
+ if(lcd){pn=readl(lcd+0x190);tv=readl(lcd+0x80);pn2=readl(lcd+0x2c8);iounmap(lcd);}
+ return sysfs_emit(buf,"sleep_total=%u sleep_dpc_idle=%u sleep_rw_commands=%u sleep_no_util=%u lcd_dma=%08x/%08x/%08x usb=%08x lcd_clk=%08x dsi_clk=%08x vpu=%08x dma=%08x squ=%08x sdh=%08x/%08x/%08x\n",ddr_cycles,ddr_idle_cycles,ddr_commands,ddr_no_util,pn,tv,pn2,readl(APMU_REG(0x5c)),readl(APMU_REG(0x4c)),readl(APMU_REG(0x44)),readl(APMU_REG(0xa4)),readl(APMU_REG(0x64)),readl(APMU_REG(0x1c)),readl(APMU_REG(0x54)),readl(APMU_REG(0x58)),readl(APMU_REG(0xe0)));
+}
+static DEVICE_ATTR_RO(activity);
+static ssize_t sram_probe_show(struct device *dev,struct device_attribute *a,char *buf)
+{return sysfs_emit(buf,"enabled=%u phys=%08x ran=%u dram=%08x mc_status=%08x\n",sram_probe_enabled,(u32)sram_probe_phys,readl(sleep_trace+0x98),readl(sleep_trace+0x90),readl(sleep_trace+0x94));}
+static ssize_t sram_probe_store(struct device *dev,struct device_attribute *a,const char *buf,size_t len)
+{bool v;int ret=kstrtobool(buf,&v);if(ret)return ret;if(v&&!sram_probe_phys)return -ENODEV;WRITE_ONCE(sram_probe_enabled,v);return len;}
+static DEVICE_ATTR_RW(sram_probe);
+static struct attribute *sleep_attrs[] = { &dev_attr_state.attr, &dev_attr_level.attr, &dev_attr_trace.attr, &dev_attr_gating.attr, &dev_attr_display_gating.attr, &dev_attr_standby_request.attr, &dev_attr_l2_quiesce.attr, &dev_attr_clocks.attr, &dev_attr_activity.attr, &dev_attr_sram_probe.attr, NULL };
+ATTRIBUTE_GROUPS(sleep);
+static int __init pxa98x_sleep_diag_init(void)
+{
+	struct platform_device *dev;
+	int ret;
+	if (!t110_scu) return -ENODEV;
+	sleep_mc=ioremap(0xc0100000,0x1000);
+	if (!sleep_mc) return -ENOMEM;
+ /* A dedicated page after the vendor's 256KiB RAM console, within the
+  * already-reserved diagnostics carveout; not part of its data or ECC. */
+ sleep_trace=ioremap(0x08140000,SZ_4K);
+ if(!sleep_trace)return -ENOMEM;
+ pr_info("t110-sleep: previous trace magic=%08x level=%u stage=%u\n",readl(sleep_trace),readl(sleep_trace+4),readl(sleep_trace+8));
+	dev = platform_device_register_simple("t110-sleep", -1, NULL, 0);
+	if (IS_ERR(dev)) return PTR_ERR(dev);
+	suspend_set_ops(&t110_suspend_ops);
+	ret = device_add_groups(&dev->dev, sleep_groups);
+	if (ret) platform_device_unregister(dev);
+	return ret;
+}
+device_initcall(pxa98x_sleep_diag_init);
+static int __init t110_sleep_sram_init(void)
+{
+ struct device_node *np=of_find_node_by_path("/audio@d42a0c00");
+ struct gen_pool *pool;void *dst;dma_addr_t phys;size_t n=t110_sram_probe_end-t110_sram_probe;
+ if(!np)return -ENODEV;
+ pool=of_gen_pool_get(np,"asram",0);of_node_put(np);
+ if(!pool)return -ENODEV;
+ dst=gen_pool_dma_alloc(pool,n,&phys);if(!dst)return -ENOMEM;
+ memcpy_toio((void __iomem *)dst,t110_sram_probe,n);
+ writel(__pa_symbol(t110_cpu_resume),(void __iomem *)dst+(t110_sram_target-t110_sram_probe));
+ dsb(sy);sram_probe_phys=phys;
+ pr_info("t110-sleep: SRAM rank probe phys=%08x bytes=%zu\n",(u32)phys,n);
+ return 0;
+}
+late_initcall(t110_sleep_sram_init);
+
+static const struct smp_operations pxa98x_smp_ops __initconst = {
+	.smp_prepare_cpus = pxa98x_prepare_cpus,
+	.smp_boot_secondary = pxa98x_boot_secondary,
