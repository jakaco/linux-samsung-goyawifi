diff --git a/arch/arm/mach-mmp/pxa98x-thermal.c b/arch/arm/mach-mmp/pxa98x-thermal.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-thermal.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* PXA986 polling-only high-range sensor. Code zero means <=80C. */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+struct t110_thermal {void __iomem *regs;struct mutex lock;};
+static int t110_get_temp(struct thermal_zone_device *zone,int *temp)
+{
+ struct t110_thermal *t=thermal_zone_device_priv(zone);
+ u32 raw,ctrl,gray,binary;int i,ret=0;
+ mutex_lock(&t->lock);
+ for(i=0;i<10;i++) {
+  raw=readl(t->regs+0x24);
+  if(raw&BIT(4))break;
+  msleep(20);
+ }
+ if(i==10){ret=-EAGAIN;goto out;}
+ gray=raw&15;binary=gray^(gray>>1)^(gray>>2)^(gray>>3);
+ *temp=80000+binary*2500;
+ ctrl=readl(t->regs+0x20);
+ writel(ctrl&~BIT(3),t->regs+0x20);
+ writel(ctrl|BIT(3),t->regs+0x20);
+out:
+ mutex_unlock(&t->lock);return ret;
+}
+static const struct thermal_zone_device_ops t110_thermal_ops={.get_temp=t110_get_temp};
+static ssize_t measurement_range_show(struct device *dev,struct device_attribute *attr,char *buf)
+{return sysfs_emit(buf,"80000 117500 millicelsius; 80000 means at or below sensor floor\n");}
+static DEVICE_ATTR_RO(measurement_range);
+static struct attribute *t110_attrs[]={&dev_attr_measurement_range.attr,NULL};
+ATTRIBUTE_GROUPS(t110);
+static int t110_thermal_probe(struct platform_device *pdev)
+{
+ struct t110_thermal *t;struct thermal_zone_device *zone;u32 ctrl;
+ t=devm_kzalloc(&pdev->dev,sizeof(*t),GFP_KERNEL);if(!t)return -ENOMEM;
+ mutex_init(&t->lock);
+ t->regs=devm_platform_ioremap_resource(pdev,0);if(IS_ERR(t->regs))return PTR_ERR(t->regs);
+ /* Match PXA986's vendor polling path, retaining over-range reset state. */
+ ctrl=readl(t->regs+0x20);
+ ctrl&=~(BIT(29)|BIT(25)|BIT(18)|BIT(3)|BIT(2)|BIT(1));
+ ctrl|=BIT(0);writel(ctrl,t->regs+0x20);
+ /* Vendor documented reset settling interval; no busy-wait or deep idle. */
+ msleep(2000);
+ writel(ctrl|BIT(2)|BIT(3),t->regs+0x20);
+ zone=devm_thermal_of_zone_register(&pdev->dev,0,t,&t110_thermal_ops);
+ if(IS_ERR(zone))return PTR_ERR(zone);
+ dev_info(&pdev->dev,"PXA986 hot-range thermal polling; 80C floor, 2.5C steps\n");
+ return 0;
+}
+static const struct of_device_id t110_thermal_match[]={{.compatible="samsung,t110-pxa986-thermal"},{}};
+MODULE_DEVICE_TABLE(of,t110_thermal_match);
+static struct platform_driver t110_thermal_driver={.probe=t110_thermal_probe,.driver={.name="t110-pxa986-thermal",.of_match_table=t110_thermal_match,.dev_groups=t110_groups}};
+module_platform_driver(t110_thermal_driver);
+MODULE_LICENSE("GPL");
diff --git a/arch/arm/mach-mmp/pxa98x-usb.c b/arch/arm/mach-mmp/pxa98x-usb.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-usb.c
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* PXA986/PXA988 USB device glue; PHY sequence from Samsung's goyawifi kernel. */
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/usb/chipidea.h>
+
+struct pxa98x_usb {
+	void __iomem *phy_base;
+	void __iomem *clock;
+	struct platform_device *ci;
+	u32 sleep_clock;
+	bool clock_sleep;
+};
+
+static int pxa98x_phy_init(struct phy *phy)
+{
+	struct pxa98x_usb *usb = phy_get_drvdata(phy);
+	void __iomem *base = usb->phy_base;
+	u16 value;
+	int ret;
+	/* Exact GOYA values; this is the PXA98x 16-bit PHY register layout. */
+	static const struct { u16 offset, value; } regs[] = {
+		{0x04, 0x5af0}, /* PLLVDD18=1, REFDIV=13, FBDIV=240 */
+		{0x08, 0x3133}, /* PU_PLL, LOCK_BYPASS, ICP=1, KVCO=3, CAL12=3 */
+		{0x10, 0x0188}, /* IMPCAL_VTH=1, HS/FS_RCAL=8 */
+		{0x14, 0x07d4}, /* TXVDD15=1, TXVDD12=3, LOWVDD, AMP=5, PHSEL=4 */
+		{0x18, 0x0aff}, /* SLEWRATE=2, CAL_DLY=2, FS/HS_DRV=15 */
+		{0x20, 0xaac1}, /* GOYA SQ_THRESH=12 */
+		{0x24, 0x3892},
+		{0x28, 0x0105},
+		{0x30, 0x0110},
+		{0x34, 0x5680},
+		{0x3c, 0x2586},
+		{0x40, 0xe400},
+		{0x58, 0x0000},
+	};
+	unsigned int i;
+	writel(0x10901003, base + 0x104);
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		writew(regs[i].value, base + regs[i].offset);
+	ret = readw_poll_timeout(base + 0x08, value, value & BIT(15),
+				10, 200000);
+	dev_info(&phy->dev, "PXA98x PHY PLL=%04x power=%08x ready=%d\n",
+		 value, readl(base + 0x104), !ret);
+	/* Vendor initializes without requiring the PLL_READY status bit. */
+	return 0;
+}
+
+static int pxa98x_phy_exit(struct phy *phy)
+{
+	struct pxa98x_usb *usb = phy_get_drvdata(phy);
+	writew(readw(usb->phy_base + 0x08) & ~BIT(13), usb->phy_base + 0x08);
+	writew(readw(usb->phy_base + 0x34) & ~BIT(14), usb->phy_base + 0x34);
+	writel(0x10901000, usb->phy_base + 0x104);
+	return 0;
+}
+
+static const struct phy_ops pxa98x_phy_ops = {
+	.init = pxa98x_phy_init,
+	.exit = pxa98x_phy_exit,
+	.owner = THIS_MODULE,
+};
+
+static int pxa98x_usb_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ci_hdrc_platform_data pdata = {
+		.name = "pxa98x-usb",
+		.capoffset = DEF_CAPOFFSET,
+		.phy_mode = USBPHY_INTERFACE_MODE_UTMI,
+		.dr_mode = USB_DR_MODE_PERIPHERAL,
+		.flags = CI_HDRC_DISABLE_STREAMING | CI_HDRC_REQUIRES_ALIGNED_DMA |
+			 CI_HDRC_DUAL_ROLE_NOT_OTG | CI_HDRC_FORCE_VBUS_ACTIVE_ALWAYS,
+	};
+	struct pxa98x_usb *usb;
+	struct resource resources[2];
+	struct resource *controller;
+	struct phy *phy;
+	int irq;
+
+	usb = devm_kzalloc(dev, sizeof(*usb), GFP_KERNEL);
+	if (!usb) return -ENOMEM;
+	usb->phy_base = devm_platform_ioremap_resource_byname(pdev, "phy");
+	if (IS_ERR(usb->phy_base)) return PTR_ERR(usb->phy_base);
+	usb->clock = devm_platform_ioremap_resource_byname(pdev, "clock");
+	if (IS_ERR(usb->clock)) return PTR_ERR(usb->clock);
+	/* Vendor UDCCLK: release AXI reset and enable the AXI clock. */
+	writel(0x9, usb->clock);
+	readl(usb->clock);
+	udelay(20);
+	phy = devm_phy_create(dev, NULL, &pxa98x_phy_ops);
+	if (IS_ERR(phy)) return PTR_ERR(phy);
+	phy_set_drvdata(phy, usb);
+	pdata.phy = phy;
+	controller = platform_get_resource_byname(pdev, IORESOURCE_MEM, "controller");
+	if (!controller) return -EINVAL;
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0) return irq;
+	resources[0] = *controller;
+	resources[1] = (struct resource) {
+		.start = irq, .end = irq, .flags = IORESOURCE_IRQ,
+	};
+	platform_set_drvdata(pdev, usb);
+	usb->ci = ci_hdrc_add_device(dev, resources, ARRAY_SIZE(resources), &pdata);
+	if (IS_ERR(usb->ci)) return PTR_ERR(usb->ci);
+	dev_info(dev, "PXA98x ChipIdea USB peripheral registered, IRQ %d\n", irq);
+	return 0;
+}
+
+static void pxa98x_usb_remove(struct platform_device *pdev)
+{
+	struct pxa98x_usb *usb = platform_get_drvdata(pdev);
+	ci_hdrc_remove_device(usb->ci);
+	writel(0, usb->clock);
+}
+
+/* Board diagnostic: child ChipIdea suspends first; preserve its register
+ * context and PHY, then gate only the AXI clock. Restore before child resume.
+ * The explicit test helper detaches the gadget before enabling this option.
+ * Default off until USB and DDR suspend behaviour has been validated. */
+static ssize_t clock_sleep_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct pxa98x_usb *usb = dev_get_drvdata(dev);
+	return sysfs_emit(buf, "%u\n", READ_ONCE(usb->clock_sleep));
+}
+static ssize_t clock_sleep_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t len)
+{
+	struct pxa98x_usb *usb = dev_get_drvdata(dev);
+	bool enable;
+	int ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+	WRITE_ONCE(usb->clock_sleep, enable);
+	return len;
+}
+static DEVICE_ATTR_RW(clock_sleep);
+static struct attribute *pxa98x_usb_attrs[] = {
+	&dev_attr_clock_sleep.attr, NULL,
+};
+ATTRIBUTE_GROUPS(pxa98x_usb);
+
+static int pxa98x_usb_suspend_late(struct device *dev)
+{
+	struct pxa98x_usb *usb = dev_get_drvdata(dev);
+	usb->sleep_clock = readl(usb->clock);
+	if (READ_ONCE(usb->clock_sleep)) {
+		writel(usb->sleep_clock & ~BIT(3), usb->clock);
+		readl(usb->clock);
+		dev_info(dev, "suspend AXI clock gated, reset retained\n");
+	}
+	return 0;
+}
+static int pxa98x_usb_resume_early(struct device *dev)
+{
+	struct pxa98x_usb *usb = dev_get_drvdata(dev);
+	writel(usb->sleep_clock, usb->clock);
+	readl(usb->clock);
+	udelay(20);
+	return 0;
+}
+static const struct dev_pm_ops pxa98x_usb_pm = {
+	SET_LATE_SYSTEM_SLEEP_PM_OPS(pxa98x_usb_suspend_late,
+				     pxa98x_usb_resume_early)
+};
+
+static const struct of_device_id pxa98x_usb_match[] = {
+	{ .compatible = "marvell,pxa986-usb" }, {},
+};
+MODULE_DEVICE_TABLE(of, pxa98x_usb_match);
+static struct platform_driver pxa98x_usb_driver = {
+	.probe = pxa98x_usb_probe,
+	.remove = pxa98x_usb_remove,
+	.driver = { .name = "pxa98x-usb", .of_match_table = pxa98x_usb_match,
+		.pm = pm_sleep_ptr(&pxa98x_usb_pm),
+		.dev_groups = pxa98x_usb_groups },
+};
+module_platform_driver(pxa98x_usb_driver);
+MODULE_LICENSE("GPL");
diff --git a/arch/arm/mach-mmp/t110-camera-clock.c b/arch/arm/mach-mmp/t110-camera-clock.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/t110-camera-clock.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Board-scoped PXA986 CCIC clock gates; never gate the shared LCD bus. */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/clk-provider.h>
+#include <linux/of.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+struct cam_clock {struct clk_hw hw;void __iomem *rst,*dbg,*lcd;};
+static int cam_prepare(struct clk_hw *hw) {
+ struct cam_clock *c=container_of(hw,struct cam_clock,hw);u32 v;
+ /* LCD/CCIC shared HCLK: release, retain for the display on disable. */
+ writel(readl(c->lcd)|BIT(5)|BIT(2),c->lcd);
+ v=readl(c->rst);
+ /* PLL1_624 source1 /2=312MHz; PHY slow52MHz /26. */
+ v&=~((3<<16)|(7<<18)|(31<<10)|BIT(7));
+ v|=BIT(16)|(2<<18)|(26<<10)|BIT(7);
+ writel(v|BIT(0)|BIT(3),c->rst);
+ writel(v|BIT(0)|BIT(3)|BIT(1)|BIT(4)|BIT(15),c->rst);
+ udelay(10);
+ writel(readl(c->rst)|BIT(2)|BIT(5)|BIT(8)|BIT(9),c->rst);
+ writel(readl(c->dbg)|0x06000000,c->dbg);udelay(10);
+ return 0;
+}
+static void cam_unprepare(struct clk_hw *hw) {
+ struct cam_clock *c=container_of(hw,struct cam_clock,hw);
+ writel(readl(c->rst)&~(BIT(3)|BIT(4)|BIT(5)|BIT(9)|BIT(2)),c->rst);
+ writel(readl(c->dbg)&~0x06000000,c->dbg);
+}
+static unsigned long cam_rate(struct clk_hw *hw,unsigned long parent){return 312000000;}
+static const struct clk_ops cam_ops={.prepare=cam_prepare,.unprepare=cam_unprepare,.recalc_rate=cam_rate};
+static int cam_clock_probe(struct platform_device *pdev) {
+ struct cam_clock *c;struct clk_init_data init={.name="t110-ccic",.ops=&cam_ops};int ret;
+ c=devm_kzalloc(&pdev->dev,sizeof(*c),GFP_KERNEL);if(!c)return -ENOMEM;
+ c->rst=devm_platform_ioremap_resource(pdev,0);if(IS_ERR(c->rst))return PTR_ERR(c->rst);
+ c->dbg=devm_platform_ioremap_resource(pdev,1);if(IS_ERR(c->dbg))return PTR_ERR(c->dbg);
+ c->lcd=devm_platform_ioremap_resource(pdev,2);if(IS_ERR(c->lcd))return PTR_ERR(c->lcd);
+ c->hw.init=&init;ret=devm_clk_hw_register(&pdev->dev,&c->hw);if(ret)return ret;
+ return devm_of_clk_add_hw_provider(&pdev->dev,of_clk_hw_simple_get,&c->hw);
+}
+static const struct of_device_id cam_clock_match[]={{.compatible="samsung,t110-camera-clock"},{}};
+MODULE_DEVICE_TABLE(of,cam_clock_match);
+static struct platform_driver cam_clock_driver={.probe=cam_clock_probe,.driver={.name="t110-camera-clock",.of_match_table=cam_clock_match}};
+module_platform_driver(cam_clock_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("SM-T110 bounded CCIC clock gates");
