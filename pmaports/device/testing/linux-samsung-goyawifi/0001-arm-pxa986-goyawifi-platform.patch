diff --git a/arch/arm/mach-mmp/pxa98x-board.c b/arch/arm/mach-mmp/pxa98x-board.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-board.c
@@ -0,0 +1,313 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Samsung Galaxy Tab 3 Lite SM-T110 platform support. Based on Marvell PXA988 register sequences. */
+#include <linux/console.h>
+#include <linux/kernel.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/libfdt.h>
+#include <linux/t110-board.h>
+#include <linux/sizes.h>
+#include <linux/of_fdt.h>
+#include <linux/io.h>
+#include <linux/irqchip.h>
+#include <linux/clocksource.h>
+#include <linux/clk-provider.h>
+#include <linux/reboot.h>
+#include <asm/mach/arch.h>
+#include <asm/mach/map.h>
+#include <asm/barrier.h>
+#include "common.h"
+#include "addr-map.h"
+#include "t110-ecc.h"
+
+#define LOG_VIRT 0xfe800000UL
+#define LOG_PHYS 0x08100000UL
+#define LOG_SIZE 0x40000
+#define DATA_SIZE 232980
+#define ECC_BLOCKS 1821
+#define LOG ((void __iomem *)LOG_VIRT)
+
+/* No allocation or timer dependency: usable from map_io onward. */
+static void t110_ecc(const void __iomem *src, unsigned int len,
+		     void __iomem *dst)
+{
+	u8 par[16] = {0};
+	unsigned int i, j, fb, n;
+	for (i = 0; i < len; i++) {
+		fb = t110_index[readb(src + i) ^ par[0]];
+		if (fb != 255)
+			for (j = 1; j < 16; j++) {
+				n = fb + t110_gen[16 - j];
+				if (n >= 255) n -= 255;
+				par[j] ^= t110_alpha[n];
+			}
+		for (j = 0; j < 15; j++) par[j] = par[j + 1];
+		n = fb + t110_gen[0];
+		if (n >= 255) n -= 255;
+		par[15] = fb != 255 ? t110_alpha[n] : 0;
+	}
+	for (j = 0; j < 16; j++) writeb(par[j], dst + j);
+}
+
+static void t110_ram_write(struct console *con, const char *s, unsigned int n)
+{
+	u32 start = readl(LOG + 4), size = readl(LOG + 8);
+	unsigned int take, first, last, i, length;
+	while (n) {
+		take = min_t(unsigned int, n, DATA_SIZE - start);
+		memcpy_toio(LOG + 12 + start, s, take);
+		first = start / 128;
+		last = (start + take - 1) / 128;
+		for (i = first; i <= last; i++) {
+			length = min_t(unsigned int, 128, DATA_SIZE - i * 128);
+			t110_ecc(LOG + 12 + i * 128, length,
+				 LOG + 12 + DATA_SIZE + i * 16);
+		}
+		start = (start + take) % DATA_SIZE;
+		size = min_t(u32, DATA_SIZE, size + take);
+		writel(start, LOG + 4);
+		writel(size, LOG + 8);
+		t110_ecc(LOG, 12, LOG + 12 + DATA_SIZE + ECC_BLOCKS * 16);
+		dsb(sy);
+		s += take;
+		n -= take;
+	}
+}
+
+static struct console t110_console = {
+	.name = "t110ram",
+	.write = t110_ram_write,
+	.flags = CON_PRINTBUFFER | CON_ENABLED | CON_BOOT,
+	.index = -1,
+};
+
+static struct map_desc t110_log_map __initdata = {
+	.virtual = LOG_VIRT,
+	.pfn = __phys_to_pfn(LOG_PHYS),
+	.length = LOG_SIZE,
+	.type = MT_DEVICE,
+};
+
+static void __init t110_map_io(void)
+{
+	mmp_map_io();
+	iotable_init(&t110_log_map, 1);
+	memset_io(LOG, 0, LOG_SIZE);
+	writel(0x43474244, LOG);
+	t110_ecc(LOG, 12, LOG + 12 + DATA_SIZE + ECC_BLOCKS * 16);
+	static const char marker[] = "goyawifi: map_io reached\n";
+	t110_ram_write(NULL, marker, sizeof(marker) - 1);
+	register_console(&t110_console);
+	pr_emerg("goyawifi: compatible early RAM console registered\n");
+}
+
+static void __init t110_init_irq(void)
+{
+	/* In active mode sources go directly to the GIC, not the ICU output. */
+	writel(3, AXI_VIRT_BASE + 0x82114);
+	writel(3, AXI_VIRT_BASE + 0x82144);
+	irqchip_init();
+	pr_emerg("goyawifi: GIC initialized\n");
+}
+
+static void __init t110_init_time(void)
+{
+#ifdef CONFIG_MMC_SDHCI_PXAV3
+	/* Keep the shared SDH AXI clock/reset released; eMMC source PLL1/8. */
+	u32 sdh = readl(APMU_REG(0x0e0));
+	writel(readl(APMU_REG(0x54)) | 9, APMU_REG(0x54));
+	writel((sdh & ~0x7c0) | 0xf12, APMU_REG(0x0e0));
+	readl(APMU_REG(0x0e0));
+	udelay(20);
+	pr_info("T110_STORAGE_G: SDH0=%08x SDH2=%08x, source 52MHz\n",
+		readl(APMU_REG(0x54)), readl(APMU_REG(0x0e0)));
+#endif
+
+	/* Touch TWSI1 and GPIO APBC clocks, matching goyawifi vendor setup. */
+	writel(3, APBC_REG(0x008));
+	writel(2, APBC_REG(0x060));
+	udelay(10);
+	writel(3, APBC_REG(0x060));
+	udelay(10);
+	/* Preserve electrical settings; GPIO87/88 AF5 is CI2C2. */
+	writel((readl(APB_VIRT_BASE + 0x1e208) & ~7) | 5, APB_VIRT_BASE + 0x1e208);
+	writel((readl(APB_VIRT_BASE + 0x1e20c) & ~7) | 5, APB_VIRT_BASE + 0x1e20c);
+	writel(readl(APB_VIRT_BASE + 0x1e224) & ~7, APB_VIRT_BASE + 0x1e224);
+	/* Rear camera power GPIO14/15/79/80 and bit-bang I2C53/54. */
+	for (unsigned int off = 0x114; off <= 0x118; off += 4)
+		writel(readl(APB_VIRT_BASE + 0x1e000 + off)&~7,APB_VIRT_BASE + 0x1e000 + off);
+	for (unsigned int off = 0x1e8; off <= 0x1ec; off += 4)
+		writel(readl(APB_VIRT_BASE + 0x1e000 + off)&~7,APB_VIRT_BASE + 0x1e000 + off);
+	for (unsigned int off = 0x1b0; off <= 0x1b4; off += 4)
+		writel(readl(APB_VIRT_BASE + 0x1e000 + off)&~7,APB_VIRT_BASE + 0x1e000 + off);
+	/* GPIO77 CAM_MCLK AF1. */
+	writel((readl(APB_VIRT_BASE + 0x1e1e0)&~7)|1,APB_VIRT_BASE + 0x1e1e0);
+	/* GPS AP UART2: vendor APBC source1, 14.7456MHz. */
+	writel(0x17, APBC_REG(0x004));
+	udelay(10);
+	writel(0x13, APBC_REG(0x004));
+	/* RX/TX GPIO45/46 AF1, reset5/onoff52/clock89 AF0. */
+	for (unsigned int off = 0x190; off <= 0x194; off += 4)
+		writel((readl(APB_VIRT_BASE + 0x1e000 + off)&~7)|1,APB_VIRT_BASE + 0x1e000 + off);
+	writel(readl(APB_VIRT_BASE + 0x1e0f0)&~7,APB_VIRT_BASE + 0x1e0f0);
+	writel(readl(APB_VIRT_BASE + 0x1e1ac)&~7,APB_VIRT_BASE + 0x1e1ac);
+	writel(readl(APB_VIRT_BASE + 0x1e210)&~7,APB_VIRT_BASE + 0x1e210);
+	/* Dedicated accelerometer GPIO I2C5 and INT1; preserve pulls. */
+	for (unsigned int off = 0x168; off <= 0x16c; off += 4)
+		writel(readl(APB_VIRT_BASE + 0x1e000 + off) & ~7,
+		       APB_VIRT_BASE + 0x1e000 + off);
+	writel(readl(APB_VIRT_BASE + 0x1e104) & ~7, APB_VIRT_BASE + 0x1e104);
+	/* Physical keys: GPIO1, GPIO2 and GPIO13; keep existing pulls. */
+	writel(readl(APB_VIRT_BASE + 0x1e0e0) & ~7, APB_VIRT_BASE + 0x1e0e0);
+	writel(readl(APB_VIRT_BASE + 0x1e0e4) & ~7, APB_VIRT_BASE + 0x1e0e4);
+	writel(readl(APB_VIRT_BASE + 0x1e110) & ~7, APB_VIRT_BASE + 0x1e110);
+	pr_info("T110_INPUT_J: GPIO and touch TWSI1 clocks/pins configured\n");
+#ifdef CONFIG_T110_MONITOR
+	/* Vendor DROTS clock source 13MHz, release APBC reset. */
+	writel(3, APBC_REG(0x058));
+	udelay(10);
+#endif
+	/* PMIC I2C: vendor APBCP_PWRTWSI clock sequence, source 33 MHz. */
+	writel(2, APB_VIRT_BASE + 0x3b028);
+	udelay(10);
+	writel(3, APB_VIRT_BASE + 0x3b028);
+	udelay(10);
+
+	/* SDH2 Wi-Fi: PLL1/8, same shared MMC interrupt as eMMC. */
+	writel((readl(APMU_REG(0x58)) & ~0x7c0) | 0xf12, APMU_REG(0x58));
+	readl(APMU_REG(0x58));
+	udelay(20);
+	/* GPIO37..42 SDIO AF1; preserve bootloader drive and pulls. */
+	for (unsigned int off = 0x170; off <= 0x184; off += 4)
+		writel((readl(APB_VIRT_BASE + 0x1e000 + off) & ~7) | 1,
+		       APB_VIRT_BASE + 0x1e000 + off);
+	writel(readl(APB_VIRT_BASE + 0x1e1a8) & ~7, APB_VIRT_BASE + 0x1e1a8);
+	pr_info("T110_WIFI_O: SDH2 clock=%08x, SDIO AF1 and PDn GPIO51 configured\n",
+		readl(APMU_REG(0x58)));
+	/* SM-T110 board rev02: removable SDH1, PLL1/8=52MHz source.
+	 * APMU054 also owns the shared AXI gate and reset for all hosts:
+	 * retain bit3 and bit0; never pulse the shared reset here. */
+	writel((readl(APMU_REG(0x54)) & ~0x7c0) | 0xf1b, APMU_REG(0x54));
+	readl(APMU_REG(0x54));
+	udelay(20);
+	/* MMC1 DAT3..DAT0, CMD, CLK AF0; card detect is GPIO11 AF0. */
+	for (unsigned int off = 0x94; off <= 0xa8; off += 4)
+		writel(readl(APB_VIRT_BASE + 0x1e000 + off) & ~7,
+		       APB_VIRT_BASE + 0x1e000 + off);
+	writel(readl(APB_VIRT_BASE + 0x1e108) & ~7, APB_VIRT_BASE + 0x1e108);
+	/* Vendor pxa988_aib_mmc1_iodomain(3300000): 3.3V pad domain,
+	 * powerdown_n set, preserve all unrelated electrical controls. */
+	{
+		u32 sdpad;
+		writel(0xbaba, APBC_REG(0x050));
+		writel(0xeb10, APBC_REG(0x054));
+		sdpad = (readl(APB_VIRT_BASE + 0x1e81c) & ~0xc) | 1;
+		writel(0xbaba, APBC_REG(0x050));
+		writel(0xeb10, APBC_REG(0x054));
+		writel(sdpad, APB_VIRT_BASE + 0x1e81c);
+	}
+	pr_info("T110_MICROSD_AH: SDH1=%08x, GPIO11 CD and 3.3V pads\n",
+		readl(APMU_REG(0x54)));
+	of_clk_init(NULL);
+	/* Vendor APBC reset/clock sequence, FNCLKSEL=3 => 3.25 MHz. */
+	writel(5, APBC_REG(0x34));
+	writel(0x33, APBC_REG(0x34));
+	writel(0, APB_VIRT_BASE + 0x14000);
+	timer_probe();
+	pr_emerg("goyawifi: APB timer initialized\n");
+}
+
+static void t110_restart(enum reboot_mode mode, const char *cmd)
+{
+	void __iomem *wdt = APB_VIRT_BASE + 0x80000;
+	u32 count;
+	pr_emerg("T110_DISPLAY_D: watchdog restart cmd=%s\n", cmd ?: "normal");
+	/* Same recovery magic as vendor do_wdt_reset(). */
+	writel(cmd && !strcmp(cmd, "recovery") ? 0x7265636f : 0,
+	       APB_VIRT_BASE + 0x10014);
+	writel(readl(MPMU_REG(0x1020)) | 1, MPMU_REG(0x1020));
+	udelay(10);
+	writel(readl(MPMU_REG(0x20)) | 0xc, MPMU_REG(0x20));
+	udelay(10);
+	writel(7, MPMU_REG(0x200));
+	readl(MPMU_REG(0x200));
+	writel(3, MPMU_REG(0x200));
+	readl(MPMU_REG(0x200));
+	writel(0xbaba, wdt + 0x9c); writel(0xeb10, wdt + 0xa0);
+	writel(3, wdt + 0x64);
+	writel(readl(MPMU_REG(0x1020)) | 0x10, MPMU_REG(0x1020));
+	writel(0xbaba, wdt + 0x9c); writel(0xeb10, wdt + 0xa0);
+	writel(0, wdt + 0x70);
+	count = readl(wdt + 0x6c);
+	writel(0xbaba, wdt + 0x9c); writel(0xeb10, wdt + 0xa0);
+	writel((count + 0x20) & 0xffff, wdt + 0x68);
+	dsb(sy);
+	for (;;) cpu_relax();
+}
+
+/* The boot image packer carries an external initramfs in FDT tail space.
+ * ARM's decompressor may relocate that whole blob. Derive the handoff from
+ * r2's actual physical FDT address, then expose only the real DT size so
+ * generic initrd reservation does not overlap the FDT reservation. The
+ * packer leaves one page between DT and initrd for independent lifetimes.
+ * Run before early_init_dt_verify(): its CRC must not touch initramfs tail
+ * bytes beyond ARM's two-section fixed mapping of the FDT.
+ */
+extern unsigned int __atags_pointer;
+void __init pxa98x_fixup_boot_fdt(void *blob)
+{
+	const fdt32_t *size_prop;
+	u32 total, size, dt_size, start, end;
+	u64 end64;
+	int chosen, len;
+
+	if (fdt_check_header(blob) ||
+	    fdt_node_check_compatible(blob, 0, "samsung,goyawifi"))
+		return;
+	chosen = fdt_path_offset(blob, "/chosen");
+	if (chosen < 0)
+		return;
+	size_prop = fdt_getprop(blob, chosen, "samsung,goyawifi-initrd-size", &len);
+	if (!size_prop || len != sizeof(*size_prop))
+		return;
+	size = fdt32_to_cpu(*size_prop);
+	total = fdt_totalsize(blob);
+	if (!size || size > SZ_16M || total < size + SZ_4K + sizeof(struct fdt_header))
+		return;
+	dt_size = total - size - SZ_4K;
+	if (fdt_off_dt_strings(blob) + fdt_size_dt_strings(blob) > dt_size)
+		return;
+	end64 = (u64)__atags_pointer + total;
+	if (end64 > U32_MAX)
+		return;
+	end = end64;
+	start = end - size;
+	if (fdt_setprop_inplace_u32(blob, chosen, "linux,initrd-start", start) ||
+	    fdt_setprop_inplace_u32(blob, chosen, "linux,initrd-end", end))
+		return;
+	fdt_set_totalsize(blob, dt_size);
+
+	pr_info("goyawifi: external initramfs %08x..%08x, FDT at %08x\n",
+		start, end, __atags_pointer);
+}
+
+static void __init goyawifi_fixup_initrd(void)
+{
+	/* r2 holds the physical FDT address; the early mapping is fixed virtual. */
+	initial_boot_params_pa = __atags_pointer;
+}
+
+static const char *const t110_compat[] __initconst = {
+	"samsung,goyawifi", NULL,
+};
+
+DT_MACHINE_START(GOYAWIFI, "Samsung Galaxy Tab 3 Lite SM-T110")
+	.dt_fixup = goyawifi_fixup_initrd,
+	.map_io = t110_map_io,
+	.init_irq = t110_init_irq,
+	.init_time = t110_init_time,
+	.restart = t110_restart,
+	.l2c_aux_val = 0x30800000,
+	.l2c_aux_mask = 0xce7fffff,
+	.dt_compat = t110_compat,
+MACHINE_END
diff --git a/arch/arm/mach-mmp/pxa98x-cpufreq.c b/arch/arm/mach-mmp/pxa98x-cpufreq.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-cpufreq.c
@@ -0,0 +1,552 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T110 PXA986 clock bring-up, derived from Marvell's PXA988 vendor driver. */
+#include <linux/init.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/regmap.h>
+#include <linux/reboot.h>
+#include <linux/cpufreq.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/mutex.h>
+#include <linux/moduleparam.h>
+#include <linux/platform_device.h>
+#include <linux/devfreq.h>
+#include <linux/pm_opp.h>
+#include <linux/pm_qos.h>
+#include <linux/workqueue.h>
+#include <linux/ktime.h>
+#include <linux/stop_machine.h>
+#include <linux/sysfs.h>
+#include "addr-map.h"
+
+static DEFINE_MUTEX(fc_mutex);
+static bool enabled;
+static bool autostart = true;
+module_param(autostart, bool, 0444);
+static bool voltage_autostart = true;
+module_param(voltage_autostart, bool, 0444);
+static unsigned int transitions;
+static bool dvfs;
+static struct regmap *power_map;
+static struct device *power_dev;
+static unsigned int rail_uv = 1250000;
+static unsigned int voltage_changes;
+static bool ddr_low = true, ddr_fault;
+static unsigned int ddr_transitions, ddr_busy, ddr_total, ddr_percent;
+static void __iomem *mc;
+static struct devfreq *ddr_devfreq;
+static struct cpufreq_policy *cpu_policy;
+static bool ddr_auto = true;
+module_param(ddr_auto, bool, 0444);
+static u64 ddr_sample_start_ns;
+static bool ddr_sample_valid;
+static struct dev_pm_qos_request ddr_thermal_qos;
+static void ddr_limit_poll(struct work_struct *work);
+static DECLARE_DELAYED_WORK(ddr_limit_work,ddr_limit_poll);
+
+/* The observed profile-5 vendor table needs 1175mV for VL2 and 1262.5mV
+ * for VL3. Retain the VL2 floor for CP/GPU/VPU; round VL3 up to 1275mV.
+ * DDR must first leave 533MHz (which requires VL3) for its vendor 312MHz OP.
+ * Hardware DVC stays disabled: only its statically selected PM822 slot 0
+ * is changed. Other voltage slots, rails and DVC pins are untouched.
+ */
+static int set_rail(unsigned int uv)
+{
+	unsigned int value, sel = (uv - 600000) / 12500;
+	int ret;
+	if (uv != 1175000 && uv != 1250000 && uv != 1275000)
+		return -EINVAL;
+	ret = regmap_update_bits(power_map, 0x3c, 0x7f, sel);
+	if (ret) return ret;
+	udelay(100); /* vendor ramp + launch bound, with additional margin */
+	ret = regmap_read(power_map, 0x3c, &value);
+	if (ret || (value & 127) != sel) return ret ?: -EIO;
+	rail_uv = uv; voltage_changes++;
+	return 0;
+}
+
+/* The profile-5 VL2 floor covers GC624. Verify the actual shared slot
+ * before a GPU clock increase; CPU and DDR remain the only rail writers.
+ */
+int t110_gpu_voltage_ready(void);
+int t110_gpu_voltage_ready(void)
+{
+	unsigned int value;
+	int ret;
+	mutex_lock(&fc_mutex);
+	ret = !dvfs ? -EAGAIN : regmap_read(power_map, 0x3c, &value);
+	if (!ret && (value & 127) < 46) ret = -ERANGE;
+	mutex_unlock(&fc_mutex);
+	return ret;
+}
+
+static int ddr_fc(void *data)
+{
+	bool low = *(bool *)data;
+	u32 value, cc, fccr, tbl;
+	int ret;
+	ret = readl_poll_timeout_atomic(APMU_REG(0xc), value,
+		!(value & BIT(24)) && (value & BIT(25)), 1, 10000);
+	if (ret) goto unlock;
+	writel(readl(APMU_REG(0x98)) | BIT(1), APMU_REG(0x98));
+	writel(readl(APMU_REG(0x88)) | BIT(0) | BIT(1) | BIT(3) |
+		BIT(21) | BIT(22), APMU_REG(0x88));
+	writel(readl(APMU_REG(0)) | BIT(27), APMU_REG(0));
+	writel(readl(APMU_REG(0xa0)) & ~BIT(1), APMU_REG(0xa0));
+	fccr=readl(MPMU_REG(8));
+	writel((fccr & ~(3U << 23)) | ((low ? 1U : 3U) << 23), MPMU_REG(8));
+	readl(MPMU_REG(8));
+	tbl=readl(APMU_REG(0xb0));
+	writel((tbl & ~(BIT(6) | GENMASK(5,3))) | ((low ? 3 : 5) << 3), APMU_REG(0xb0));
+	cc=readl(APMU_REG(4));
+	cc &= ~(GENMASK(14,12) | BIT(24) | BIT(25) | BIT(26));
+	writel(cc | BIT(27) | BIT(25), APMU_REG(4));
+	ret=readl_poll_timeout_atomic(APMU_REG(0xa0),value,value & BIT(1),1,10000);
+	writel(readl(APMU_REG(4)) & ~BIT(25), APMU_REG(4));
+	writel(readl(APMU_REG(0xa0)) & ~BIT(1), APMU_REG(0xa0));
+	if (!ret && (((readl(APMU_REG(0xc4)) >> 4) & 3) != (low ? 1 : 3) ||
+		(readl(APMU_REG(0xc)) & GENMASK(14,12)))) ret=-EIO;
+unlock:
+	writel(readl(APMU_REG(4)) | BIT(31), APMU_REG(4));
+	writel(readl(APMU_REG(4)) & ~BIT(31), APMU_REG(4));
+	return ret;
+}
+static struct cpufreq_frequency_table t110_table[] = {
+	{ .frequency = 312000 }, { .frequency = 624000 },
+	{ .frequency = 1066000 }, { .frequency = 1205000 },
+	{ .frequency = CPUFREQ_TABLE_END },
+};
+
+/* PLLs stay enabled; the boot SRAM RTC/WTC stay untouched.
+ * L2 <= 602MHz, DDR-interface <= 602MHz, BIU <= 301MHz at every point.
+ * All points retain CC2_AP.peri_clk_div=1, hence the TWD clock is CPU/8.
+ */
+static const u32 selectors[] = { 0, 0, 2, 1 };
+static const u32 dividers[] = { 0x49, 0x240, 0x240, 0x240 };
+
+static unsigned int t110_rate(void)
+{
+	u32 sel = (readl(APMU_REG(0xc4)) >> 2) & 3;
+	u32 div = readl(APMU_REG(0xc)) & 7;
+	unsigned int rate = sel == 0 ? 624000 : sel == 2 ? 1066000 : 1205000;
+	writel(readl(APMU_REG(4)) | BIT(31), APMU_REG(4));
+	writel(readl(APMU_REG(4)) & ~BIT(31), APMU_REG(4));
+	return rate / (div + 1);
+}
+
+static unsigned int t110_get(unsigned int cpu)
+{
+	unsigned int rate;
+	mutex_lock(&fc_mutex);
+	rate = t110_rate();
+	mutex_unlock(&fc_mutex);
+	return rate;
+}
+
+/* stop_machine keeps both CPUs out of normal work during the shared change.
+ * APB clocksource, DDR, AXI and USB source clocks are not changed.
+ */
+static int t110_fc(void *data)
+{
+	unsigned int index = *(unsigned int *)data;
+	u32 value, cc, fccr;
+	int ret;
+
+	ret = readl_poll_timeout_atomic(APMU_REG(0xc), value,
+		!(value & BIT(24)) && (value & BIT(25)), 1, 10000);
+	if (ret)
+		goto unlock;
+	/* Same AP-FC acknowledgement settings as the vendor driver. */
+	writel(readl(APMU_REG(0x98)) | BIT(1), APMU_REG(0x98));
+	writel(readl(APMU_REG(0x88)) | BIT(0) | BIT(1) | BIT(3) |
+		BIT(21) | BIT(22), APMU_REG(0x88));
+	writel(readl(APMU_REG(0)) | BIT(27), APMU_REG(0));
+	writel(readl(APMU_REG(0xa0)) & ~BIT(1), APMU_REG(0xa0));
+	fccr = readl(MPMU_REG(8));
+	writel((fccr & ~(7U << 29)) | (selectors[index] << 29), MPMU_REG(8));
+	readl(MPMU_REG(8));
+	cc = readl(APMU_REG(4));
+	cc &= ~(GENMASK(11, 0) | BIT(24) | BIT(25) | BIT(26) | BIT(28));
+	cc |= dividers[index] | GENMASK(23, 18) | BIT(27);
+	writel(cc | BIT(24), APMU_REG(4));
+	ret = readl_poll_timeout_atomic(APMU_REG(0xa0), value,
+		value & BIT(1), 1, 10000);
+	writel(readl(APMU_REG(4)) & ~BIT(24), APMU_REG(4));
+	writel(readl(APMU_REG(0xa0)) & ~BIT(1), APMU_REG(0xa0));
+	if (!ret && (((readl(APMU_REG(0xc4)) >> 2) & 3) != selectors[index] ||
+		(readl(APMU_REG(0xc)) & GENMASK(11, 0)) != dividers[index]))
+		ret = -EIO;
+unlock:
+	writel(readl(APMU_REG(4)) | BIT(31), APMU_REG(4));
+	writel(readl(APMU_REG(4)) & ~BIT(31), APMU_REG(4));
+	return ret;
+}
+
+static int t110_target(struct cpufreq_policy *policy, unsigned int index)
+{
+	int ret;
+	unsigned int target_uv;
+	mutex_lock(&fc_mutex);
+	target_uv = (index == 3 || !ddr_low || ddr_fault) ? 1275000 : 1175000;
+	/* Always verify the high selector before the top clock, even if a
+	 * previous reduction wrote successfully but its readback failed.
+	 * In that case the cached rail value cannot establish hardware voltage.
+	 */
+	if (dvfs && target_uv == 1275000) {
+		ret = set_rail(target_uv);
+		if (ret) goto out;
+	}
+	ret = stop_machine(t110_fc, &index, cpumask_of(0));
+	if (!ret) {
+		transitions++;
+		if (dvfs && target_uv < rail_uv && set_rail(target_uv)) {
+			/* Frequency changed successfully. Keep the higher voltage on
+			 * a failed reduction; do not tell cpufreq the clock stayed old.
+			 */
+			pr_err("t110-dvfs: voltage reduction failed; retaining higher rail\n");
+		}
+	} else
+		pr_err("t110-cpufreq: transition to %u failed: %d, now %u kHz\n",
+			t110_table[index].frequency, ret, t110_rate());
+out:
+	mutex_unlock(&fc_mutex);
+	return ret;
+}
+
+static int t110_policy_init(struct cpufreq_policy *policy)
+{
+	cpufreq_generic_init(policy, t110_table, 1000000);
+	policy->shared_type = CPUFREQ_SHARED_TYPE_ALL;
+	policy->transition_delay_us = 100000;
+	cpu_policy = policy;
+	return 0;
+}
+
+static struct cpufreq_driver t110_driver = {
+	.name = "t110-pxa986",
+	.flags = CPUFREQ_NEED_INITIAL_FREQ_CHECK | CPUFREQ_IS_COOLING_DEV,
+	.verify = cpufreq_generic_frequency_table_verify,
+	.target_index = t110_target,
+	.get = t110_get,
+	.init = t110_policy_init,
+};
+
+static ssize_t enable_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", enabled);
+}
+
+static ssize_t enable_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	bool value;
+	int ret;
+	if (kstrtobool(buf, &value) || !value || enabled)
+		return -EINVAL;
+	/* Only accept the exact, observed T110 A0 boot configuration. Fail closed
+	 * on an unrecognised PLL, divider or timer setup; never reprogram a PLL.
+	 */
+	if (readl(MPMU_REG(0x1c)) != 0xc1163 ||
+		readl(MPMU_REG(0x34)) != 0x1bd800 ||
+		readl(APB_VIRT_BASE + 0x90104) != 0x668b5228 ||
+		readl(APB_VIRT_BASE + 0x90108) != 0x66825008 ||
+		readl(APMU_REG(0x100)) != 1 || t110_get(0) != 1205000)
+		return -ENODEV;
+	ret = cpufreq_register_driver(&t110_driver);
+	if (ret)
+		return ret;
+	enabled = true;
+	pr_info("t110-cpufreq: enabled shared clock scaling, boot voltage retained\n");
+	return count;
+}
+static DEVICE_ATTR_RW(enable);
+
+static ssize_t registers_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	void __iomem *ciu = ioremap(0xd4282c00, 0x100);
+	int n;
+	mutex_lock(&fc_mutex);
+	n = sysfs_emit(buf,
+		"CC_CP=%08x CC_AP=%08x DM_CC_AP=%08x CC2_AP=%08x DM_CC2_AP=%08x\n"
+		"PLL_SEL=%08x FCCR=%08x PLL2CR=%08x PLL3CR=%08x POSR=%08x\n"
+		"PLL2SW=%08x PLL3SW=%08x DEBUG=%08x IMR=%08x ISR=%08x\n"
+		"CHIP_ID=%08x SRAM0=%08x SRAM1=%08x\n",
+		readl(APMU_REG(0)), readl(APMU_REG(4)), readl(APMU_REG(0xc)),
+		readl(APMU_REG(0x100)), readl(APMU_REG(0x104)),
+		readl(APMU_REG(0xc4)), readl(MPMU_REG(8)),
+		readl(MPMU_REG(0x34)), readl(MPMU_REG(0x1c)), readl(MPMU_REG(0x10)),
+		readl(APB_VIRT_BASE + 0x90104), readl(APB_VIRT_BASE + 0x90108),
+		readl(APMU_REG(0x88)), readl(APMU_REG(0x98)), readl(APMU_REG(0xa0)),
+		ciu ? readl(ciu) : 0, ciu ? readl(ciu + 0xc8) : 0,
+		ciu ? readl(ciu + 0xcc) : 0);
+	/* Reading DM_CC_AP acquires the AP clock-register latch: release it. */
+	writel(readl(APMU_REG(4)) | BIT(31), APMU_REG(4));
+	writel(readl(APMU_REG(4)) & ~BIT(31), APMU_REG(4));
+	iounmap(ciu);
+	mutex_unlock(&fc_mutex);
+	n += sysfs_emit_at(buf, n, "TRANSITIONS=%u VOLTAGE=%s\n", transitions,
+		dvfs ? "software-scaled" : "boot-fixed");
+	return n;
+}
+static DEVICE_ATTR_RO(registers);
+
+/* Audio shares FCCR with CPU/DDR source selection. Never update bit 28
+ * from an independent read/modify/write while a frequency change runs.
+ */
+int t110_audio_clock_source(void);
+int t110_audio_clock_source(void)
+{
+	int ret;
+	mutex_lock(&fc_mutex);
+	writel(readl(MPMU_REG(8))|BIT(28),MPMU_REG(8));
+	ret=(readl(MPMU_REG(8))&BIT(28))?0:-EIO;
+	mutex_unlock(&fc_mutex);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(t110_audio_clock_source);
+
+static ssize_t voltage_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	u32 gate=readl(APMU_REG(0x68)), fuse, dro;
+	writel(gate | 9, APMU_REG(0x68)); udelay(10);
+	fuse=readl(AXI_VIRT_BASE+0x1420); dro=readl(AXI_VIRT_BASE+0x1418);
+	writel(gate, APMU_REG(0x68));
+	return sysfs_emit(buf,"DVCR=%08x AP=%08x CP=%08x DP=%08x APSUB=%08x CHIP=%08x STATUS=%08x IMR=%08x ISR=%08x\nST01=%08x ST12=%08x ST23=%08x FUSE=%08x DRO=%08x\n",
+		readl(MPMU_REG(0x2000)),readl(MPMU_REG(0x2020)),readl(MPMU_REG(0x2024)),
+		readl(MPMU_REG(0x2028)),readl(MPMU_REG(0x202c)),readl(MPMU_REG(0x2030)),
+		readl(MPMU_REG(0x2040)),readl(MPMU_REG(0x2050)),readl(MPMU_REG(0x2054)),
+		readl(MPMU_REG(0x2004)),readl(MPMU_REG(0x2008)),readl(MPMU_REG(0x200c)),fuse,dro);
+}
+static DEVICE_ATTR_RO(voltage);
+
+static ssize_t dvfs_enable_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf,"enabled=%u rail_uv=%u changes=%u ddr_floor_uv=1175000\n",dvfs,rail_uv,voltage_changes);
+}
+static ssize_t dvfs_enable_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t count)
+{
+	bool value, low=true;
+	u32 gate, fuse;
+	unsigned int slot;
+	int ret=0;
+	if (kstrtobool(buf,&value) || !value) return -EINVAL;
+	mutex_lock(&fc_mutex);
+	if (dvfs) {ret=-EBUSY;goto out;}
+	gate=readl(APMU_REG(0x68));writel(gate|9,APMU_REG(0x68));udelay(10);
+	fuse=readl(AXI_VIRT_BASE+0x1420);writel(gate,APMU_REG(0x68));
+	/* Exact observed board, profile 5, no active hardware voltage voting. */
+	if (fuse!=0x03ffc007 || readl(MPMU_REG(0x2000)) || readl(MPMU_REG(0x2040)) ||
+		(readl(APMU_REG(0xc4)) & 0x30)!=0x30) {ret=-ENODEV;goto out;}
+	power_dev=bus_find_device_by_name(&i2c_bus_type,NULL,"2-0031");
+	if (!power_dev) {ret=-EPROBE_DEFER;goto out;}
+	power_map=dev_get_regmap(power_dev,NULL);
+	if (!power_map) {ret=-ENODEV;goto out;}
+	ret=regmap_read(power_map,0x3c,&slot);
+	if (ret || slot!=0x34) {ret=ret ?: -ENODEV;goto out;}
+	ret=set_rail(1275000);
+	if (ret) goto out;
+	/* Reuse the same bootloader DDR hardware tables used by the vendor:
+	 * table 3 = 312MHz, table 5 = 533MHz. No timing-table writes.
+	 */
+	ret=stop_machine(ddr_fc,&low,cpumask_of(0));
+	if (ret) goto out; /* never undervolt if DDR transition is unconfirmed */
+	dvfs=true;
+	if (t110_rate()<1205000) ret=set_rail(1175000);
+	pr_info("t110-dvfs: profile5, DDR312, software BUCK1 1175/1275mV\n");
+out:
+	mutex_unlock(&fc_mutex);
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(dvfs_enable);
+
+/* Counter events and reset/start sequence match the vendor MCK4 driver.
+ * At 100ms, even the total-cycle counter cannot wrap at 533MHz. Resetting
+ * also avoids accumulating a sample across a frequency transition.
+ */
+static void ddr_counter_reset(void)
+{
+	writel(0, mc + 0x440);
+	writel(0x10, mc + 0x448);
+	writel(0, mc + 0x450); writel(0, mc + 0x454);
+	writel(0, mc + 0x458); writel(0, mc + 0x45c);
+	writel(15, mc + 0x444);
+	writel(0x84948180, mc + 0x440);
+	ddr_sample_start_ns=ktime_get_ns();
+}
+
+static unsigned long ddr_rate(void)
+{
+	u32 source = (readl(APMU_REG(0xc4)) >> 4) & 3;
+	return source == 1 ? 312000000 : source == 3 ? 533000000 : 0;
+}
+
+static bool ddr_thermal_limited(void)
+{
+	/* A frequency cap (including the thermal cooling device) conservatively
+	 * caps DDR too. No cpufreq lock or thermal-zone lock under fc_mutex.
+	 * This built-in board driver has no CPU hotplug/policy removal path.
+	 */
+	return cpu_policy && READ_ONCE(cpu_policy->max) < 1205000;
+}
+
+static int ddr_target(struct device *dev, unsigned long *freq, u32 flags)
+{
+	struct dev_pm_opp *opp;
+	bool low;
+	int ret=0;
+	opp=devfreq_recommended_opp(dev,freq,flags);
+	if (IS_ERR(opp)) return PTR_ERR(opp);
+	dev_pm_opp_put(opp);
+	mutex_lock(&fc_mutex);
+	if (!dvfs || ddr_fault) {ret=-EIO;goto out;}
+	low=*freq<=312000000 || ddr_thermal_limited();
+	if (low == ddr_low) goto out;
+	if (!low) {
+		/* Always read back high voltage before a memory speed-up. */
+		ret=set_rail(1275000);
+		if (ret) goto out;
+	}
+	ret=stop_machine(ddr_fc,&low,cpumask_of(0));
+	if (ret) {
+		ddr_fault=true;
+		set_rail(1275000);
+		pr_err("t110-ddr: transition failed: %d; voltage held high\n",ret);
+		goto out;
+	}
+	ddr_low=low;ddr_transitions++;
+	ddr_counter_reset();
+	if (low && t110_rate()<1205000 && set_rail(1175000))
+		pr_err("t110-ddr: voltage reduction failed\n");
+out:
+	*freq=ddr_rate();
+	mutex_unlock(&fc_mutex);
+	return ret;
+}
+
+static int ddr_status(struct device *dev, struct devfreq_dev_status *stat)
+{
+	u64 busy;
+	mutex_lock(&fc_mutex);
+	writel(0,mc+0x440);
+	ddr_total=readl(mc+0x450);
+	busy=(u64)readl(mc+0x458)*4;
+	ddr_busy=min_t(u64,busy,ddr_total);
+	ddr_percent=ddr_total ? div_u64((u64)ddr_busy*100,ddr_total) : 0;
+	/* Devfreq can defer idle polling. Reject intervals long enough to risk
+	 * a 32-bit counter wrap instead of trusting the unreliable overflow flag.
+	 * A zero total makes simple_ondemand choose the safe high point for one
+	 * fresh interval. The thermal frequency cap still takes precedence.
+	 */
+	ddr_sample_valid=ktime_get_ns()-ddr_sample_start_ns < 2ULL*NSEC_PER_SEC;
+	stat->current_frequency=ddr_rate();
+	/* Scale both values to avoid 32-bit arithmetic overflow in governor. */
+	stat->total_time=ddr_total>>8;
+	stat->busy_time=ddr_thermal_limited() ? 0 : ddr_busy>>8;
+	if (!ddr_sample_valid) {stat->total_time=0;stat->busy_time=0;}
+	ddr_counter_reset();
+	mutex_unlock(&fc_mutex);
+	return 0;
+}
+
+static int ddr_current(struct device *dev, unsigned long *freq)
+{
+	*freq=ddr_rate();return *freq ? 0 : -EIO;
+}
+static struct devfreq_dev_profile ddr_profile={
+	.initial_freq=312000000,.polling_ms=100,
+	.target=ddr_target,.get_dev_status=ddr_status,.get_cur_freq=ddr_current,
+};
+static struct devfreq_simple_ondemand_data ddr_governor={.upthreshold=25,.downdifferential=10};
+
+static ssize_t ddr_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	int n;
+	mutex_lock(&fc_mutex);
+	n=sysfs_emit(buf,"frequency_hz=%lu rail_uv=%u transitions=%u busy=%u total=%u utilization_pct=%u sample_valid=%u thermal_limited=%u fault=%u\n",
+		ddr_rate(),rail_uv,ddr_transitions,ddr_busy,ddr_total,ddr_percent,ddr_sample_valid,ddr_thermal_limited(),ddr_fault);
+	mutex_unlock(&fc_mutex);return n;
+}
+static DEVICE_ATTR_RO(ddr);
+
+static void ddr_limit_poll(struct work_struct *work)
+{
+	/* Use devfreq's standard frequency QoS path, outside fc_mutex, so a
+	 * thermal cap works even with the performance/userspace governors.
+	 */
+	if (!READ_ONCE(dvfs)) return;
+	dev_pm_qos_update_request(&ddr_thermal_qos,ddr_thermal_limited() ? 312000 : 533000);
+	schedule_delayed_work(&ddr_limit_work,msecs_to_jiffies(500));
+}
+
+static int ddr_register(struct device *dev)
+{
+	int ret;
+	mc=ioremap(0xc0100000,0x1000);
+	if (!mc) return -ENOMEM;
+	ret=dev_pm_opp_add(dev,312000000,1175000);if (ret) return ret;
+	ret=dev_pm_opp_add(dev,533000000,1275000);if (ret) return ret;
+	ret=dev_pm_qos_add_request(dev,&ddr_thermal_qos,DEV_PM_QOS_MAX_FREQUENCY,533000);
+	if (ret<0) return ret;
+	ddr_counter_reset();
+	ddr_devfreq=devfreq_add_device(dev,&ddr_profile,
+		ddr_auto ? DEVFREQ_GOV_SIMPLE_ONDEMAND : DEVFREQ_GOV_USERSPACE,&ddr_governor);
+	if (IS_ERR(ddr_devfreq)) return PTR_ERR(ddr_devfreq);
+	schedule_delayed_work(&ddr_limit_work,msecs_to_jiffies(500));
+	return device_create_file(dev,&dev_attr_ddr);
+}
+
+static int voltage_reboot(struct notifier_block *nb, unsigned long event, void *unused)
+{
+	cancel_delayed_work_sync(&ddr_limit_work);
+	mutex_lock(&fc_mutex);
+	if (dvfs) {
+		bool low=true;
+		dvfs=false;
+		/* Stop accepting governor changes before restoring the boot rail.
+		 * Bring DDR low first, so the reboot handoff cannot undervolt DDR533.
+		 */
+		if (ddr_fault)
+			pr_err("t110-ddr: faulted controller; retaining high rail for reboot\n");
+		else if (!ddr_low && stop_machine(ddr_fc,&low,cpumask_of(0)))
+			pr_err("t110-ddr: reboot DDR reduction failed; retaining high rail\n");
+		else if (set_rail(1250000)) pr_err("t110-dvfs: boot voltage restore failed\n");
+	}
+	mutex_unlock(&fc_mutex);
+	return NOTIFY_DONE;
+}
+static struct notifier_block voltage_reboot_nb={.notifier_call=voltage_reboot};
+
+static int __init t110_cpufreq_init(void)
+{
+	struct platform_device *pdev;
+	pdev = platform_device_register_simple("t110-cpufreq", -1, NULL, 0);
+	if (IS_ERR(pdev))
+		return PTR_ERR(pdev);
+	if (device_create_file(&pdev->dev, &dev_attr_registers))
+		return -EINVAL;
+	if (device_create_file(&pdev->dev, &dev_attr_voltage))
+		return -EINVAL;
+	if (device_create_file(&pdev->dev, &dev_attr_dvfs_enable))
+		return -EINVAL;
+	register_reboot_notifier(&voltage_reboot_nb);
+	if (device_create_file(&pdev->dev, &dev_attr_enable))
+		return -EINVAL;
+	if (autostart) {
+		int ret = enable_store(&pdev->dev, NULL, "1", 1);
+		if (ret < 0)
+			pr_err("t110-cpufreq: automatic registration refused: %d\n", ret);
+	}
+	if (enabled && voltage_autostart) {
+		int ret = dvfs_enable_store(&pdev->dev, NULL, "1", 1);
+		if (ret < 0) pr_err("t110-dvfs: automatic activation refused: %d\n",ret);
+	}
+	if (dvfs) {
+		int ret=ddr_register(&pdev->dev);
+		if (ret) pr_err("t110-ddr: devfreq registration failed: %d\n",ret);
+	}
+	return 0;
+}
+late_initcall(t110_cpufreq_init);
diff --git a/arch/arm/mach-mmp/pxa98x-display.c b/arch/arm/mach-mmp/pxa98x-display.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-display.c
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Guarded reuse of the SM-T110 bootloader's running display. */
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/platform_device.h>
+#include <linux/platform_data/simplefb.h>
+#include "addr-map.h"
+
+static int __init t110_display_handoff(void)
+{
+	void __iomem *lcd = AXI_VIRT_BASE + 0xb000;
+	u32 address = readl(lcd + 0xf4), pitch = readl(lcd + 0xfc) & 0xffff;
+	u32 size = readl(lcd + 0x104), ctrl = readl(lcd + 0x190);
+	u32 format = (ctrl >> 16) & 15;
+	struct simplefb_platform_data pdata = { .width = 1024, .height = 600 };
+	struct resource resource;
+	struct platform_device *pdev;
+	pr_info("T110_DISPLAY_D: scanout=%08x pitch=%u size=%08x DMA=%08x\n",
+		address, pitch, size, ctrl);
+	/* Never map arbitrary controller addresses as a writable framebuffer. */
+	if (address != 0x17000000 || size != 0x02580400 || !(ctrl & BIT(8)) ||
+	    (ctrl & (BIT(15) | BIT(9)))) {
+		pr_err("T110_DISPLAY_D: unsupported display handoff; no framebuffer registered\n");
+		return -ENODEV;
+	}
+	if (format == 4 && pitch == 4096)
+		/* Vendor set_dma_control0: swaprb = (pix_fmt & 1) ^ 1,
+		 * goyawifi panel_rbswap=0. Thus bit12=1 means RGB, red at16.
+		 */
+		pdata.format = ctrl & BIT(12) ? "a8r8g8b8" : "a8b8g8r8";
+	else if (format == 0 && pitch == 2048 && !(ctrl & BIT(12)))
+		pdata.format = "r5g6b5";
+	else {
+		pr_err("T110_DISPLAY_D: unsupported pixel format %u\n", format);
+		return -ENODEV;
+	}
+	pdata.stride = pitch;
+	resource = (struct resource) {
+		.start = address, .end = address + pitch * 600 - 1,
+		.flags = IORESOURCE_MEM,
+	};
+	pdev = platform_device_register_resndata(NULL, "simple-framebuffer", 0,
+		&resource, 1, &pdata, sizeof(pdata));
+	return PTR_ERR_OR_ZERO(pdev);
+}
+late_initcall(t110_display_handoff);
diff --git a/arch/arm/mach-mmp/pxa98x-gps.c b/arch/arm/mach-mmp/pxa98x-gps.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-gps.c
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T110 GPS power controls, matching the vendor board's sirf API. */
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/gpio/consumer.h>
+#include <linux/regulator/consumer.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/uaccess.h>
+#include <linux/delay.h>
+#include <linux/mutex.h>
+struct t110_gps {
+ struct gpio_desc *reset,*onoff,*clock;
+ struct regulator *supply;
+ struct mutex lock;
+ bool powered;
+};
+static int gps_command(struct t110_gps *g,const char *cmd) {
+ int ret=0;
+ mutex_lock(&g->lock);
+ if(!strcmp(cmd,"on")||!strcmp(cmd,"off")) {
+  bool on=!strcmp(cmd,"on");
+  gpiod_set_value_cansleep(g->clock,0);
+  gpiod_set_value_cansleep(g->reset,1);
+  gpiod_set_value_cansleep(g->onoff,0);
+  if(on&&!g->powered) { ret=regulator_enable(g->supply);if(!ret)g->powered=true; }
+  else if(!on&&g->powered) {ret=regulator_disable(g->supply);if(!ret)g->powered=false;}
+  if(on&&!ret)msleep(20);
+ } else if(!strcmp(cmd,"reset 0")||!strcmp(cmd,"reset 1")) {
+  gpiod_set_value_cansleep(g->reset,cmd[6]=='0');
+ } else if(!strcmp(cmd,"sirfon 0")||!strcmp(cmd,"sirfon 1")) {
+  gpiod_set_value_cansleep(g->onoff,cmd[7]=='1');
+ } else if(!strcmp(cmd,"eclk 0")) {
+  gpiod_set_value_cansleep(g->clock,0);
+ } else ret=-EINVAL; /* Vendor platform disables optional ECLK. */
+ mutex_unlock(&g->lock);return ret;
+}
+static ssize_t control_store(struct device *dev,struct device_attribute *attr,const char *buf,size_t len) {
+ struct t110_gps *g=dev_get_drvdata(dev);char cmd[24];int ret;
+ if(len>=sizeof(cmd))return -EINVAL;
+ memcpy(cmd,buf,len);cmd[len]=0;strim(cmd);ret=gps_command(g,cmd);return ret?ret:len;
+}
+static ssize_t control_show(struct device *dev,struct device_attribute *attr,char *buf) {
+ struct t110_gps *g=dev_get_drvdata(dev);
+ return sysfs_emit(buf,"powered=%u reset_asserted=%d onoff=%d\n",g->powered,gpiod_get_value_cansleep(g->reset),gpiod_get_value_cansleep(g->onoff));
+}
+static DEVICE_ATTR_RW(control);
+static struct attribute *gps_attrs[]={&dev_attr_control.attr,NULL};
+static const struct attribute_group gps_group={.attrs=gps_attrs};
+static int gps_proc_show(struct seq_file *s,void *unused) {
+ struct t110_gps *g=s->private;seq_printf(s,"%s\n",g->powered?"on":"off");return 0;
+}
+static int gps_proc_open(struct inode *inode,struct file *file) {return single_open(file,gps_proc_show,pde_data(inode));}
+static ssize_t gps_proc_write(struct file *file,const char __user *buf,size_t len,loff_t *pos) {
+ struct t110_gps *g=pde_data(file_inode(file));char cmd[24];int ret;
+ if(len>=sizeof(cmd))return -EINVAL;
+ if(copy_from_user(cmd,buf,len))return -EFAULT;
+ cmd[len]=0;strim(cmd);ret=gps_command(g,cmd);return ret?ret:len;
+}
+static const struct proc_ops gps_proc_ops={.proc_open=gps_proc_open,.proc_read=seq_read,.proc_write=gps_proc_write,.proc_lseek=seq_lseek,.proc_release=single_release};
+static void gps_shutdown(struct platform_device *pdev) {gps_command(platform_get_drvdata(pdev),"off");}
+static int gps_suspend(struct device *dev) {
+ struct t110_gps *g=dev_get_drvdata(dev);
+ /* Do not silently interrupt a navigation session until userspace can quiesce it. */
+ return g->powered?-EBUSY:0;
+}
+static DEFINE_SIMPLE_DEV_PM_OPS(gps_pm,gps_suspend,NULL);
+static int gps_probe(struct platform_device *pdev) {
+ struct device *dev=&pdev->dev;struct t110_gps *g;int ret;
+ g=devm_kzalloc(dev,sizeof(*g),GFP_KERNEL);if(!g)return -ENOMEM;
+ mutex_init(&g->lock);
+ g->supply=devm_regulator_get(dev,"vcc");if(IS_ERR(g->supply))return dev_err_probe(dev,PTR_ERR(g->supply),"GPS supply\n");
+ g->reset=devm_gpiod_get(dev,"reset",GPIOD_OUT_HIGH);if(IS_ERR(g->reset))return PTR_ERR(g->reset);
+ g->onoff=devm_gpiod_get(dev,"onoff",GPIOD_OUT_LOW);if(IS_ERR(g->onoff))return PTR_ERR(g->onoff);
+ g->clock=devm_gpiod_get(dev,"clock",GPIOD_OUT_LOW);if(IS_ERR(g->clock))return PTR_ERR(g->clock);
+ platform_set_drvdata(pdev,g);
+ ret=devm_device_add_group(dev,&gps_group);if(ret)return ret;
+ if(!proc_create_data("driver/sirf",0600,NULL,&gps_proc_ops,g))return -ENOMEM;
+ dev_info(dev,"GPS UART2 controls ready; reset asserted, optional ECLK disabled\n");return 0;
+}
+static const struct of_device_id gps_match[]={{.compatible="samsung,t110-gps-control"},{}};
+static struct platform_driver gps_driver={.probe=gps_probe,.shutdown=gps_shutdown,.driver={.name="t110-gps",.of_match_table=gps_match,.pm=pm_sleep_ptr(&gps_pm)}};
+builtin_platform_driver(gps_driver);
diff --git a/arch/arm/mach-mmp/pxa98x-gpu-power.c b/arch/arm/mach-mmp/pxa98x-gpu-power.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-gpu-power.c
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T110 bounded GC power/clock bring-up, derived from Marvell PXA988. */
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/clk-provider.h>
+#include <linux/mutex.h>
+
+extern int t110_gpu_voltage_ready(void);
+
+struct t110_gpu_power {
+	struct generic_pm_domain domain;
+	void __iomem *clock, *control, *timer, *status;
+	struct clk_hw hw;
+	struct mutex lock;
+	unsigned long rate;
+	unsigned int transitions;
+	bool fault;
+};
+
+/* Vendor A0 operating points: core/bus MHz = 156/156, 312/312,
+ * 416/312, 624/416. PLL1 sources are retained, never reprogrammed.
+ */
+static const unsigned long rates[] = {156000000,312000000,416000000,624000000};
+static const u32 core_bits[] = {BIT(6)|(3<<12),BIT(6)|(1<<12),0,BIT(6)};
+static const u32 bus_bits[] = {BIT(20)|(3<<17),BIT(20)|(1<<17),BIT(20)|(1<<17),0};
+static int gc_program(struct t110_gpu_power *p, unsigned long rate)
+{
+	u32 value, mask = GENMASK(7,6)|GENMASK(14,12)|GENMASK(21,20)|GENMASK(19,17);
+	int i,ret;
+	for(i=0;i<ARRAY_SIZE(rates);i++) if(rates[i]==rate) break;
+	if(i==ARRAY_SIZE(rates)) return -EINVAL;
+	value=readl(p->clock);
+	value=(value & ~mask)|core_bits[i]|bus_bits[i];
+	writel(value|BIT(15)|BIT(16),p->clock);
+	ret=readl_poll_timeout(p->clock,value,!(value&(BIT(15)|BIT(16))),1,10000);
+	if(!ret && (value&mask)!=(core_bits[i]|bus_bits[i])) ret=-EIO;
+	if(ret) p->fault=true;
+	return ret;
+}
+static unsigned long gc_recalc(struct clk_hw *hw,unsigned long parent)
+{
+	return READ_ONCE(container_of(hw,struct t110_gpu_power,hw)->rate);
+}
+static int gc_determine(struct clk_hw *hw,struct clk_rate_request *req)
+{
+	int i;
+	for(i=0;i<ARRAY_SIZE(rates)-1;i++) if(req->rate<=rates[i]) break;
+	req->rate=rates[i];return 0;
+}
+static int gc_set(struct clk_hw *hw,unsigned long rate,unsigned long parent)
+{
+	struct t110_gpu_power *p=container_of(hw,struct t110_gpu_power,hw);
+	int i,ret=0;
+	for(i=0;i<ARRAY_SIZE(rates);i++) if(rate==rates[i]) break;
+	if(i==ARRAY_SIZE(rates)) return -EINVAL;
+	mutex_lock(&p->lock);
+	if(p->fault){ret=-EIO;goto out;}
+	if(rate>p->rate){ret=t110_gpu_voltage_ready();if(ret)goto out;}
+	if(readl(p->status)&BIT(0)) ret=gc_program(p,rate);
+	if(!ret && rate!=p->rate){WRITE_ONCE(p->rate,rate);p->transitions++;}
+out:
+	mutex_unlock(&p->lock);return ret;
+}
+static const struct clk_ops gc_ops={.recalc_rate=gc_recalc,.determine_rate=gc_determine,.set_rate=gc_set};
+static ssize_t clocks_show(struct device *dev,struct device_attribute *attr,char *buf)
+{
+	struct t110_gpu_power *p=dev_get_drvdata(dev);
+	int n;
+	mutex_lock(&p->lock);
+	n=sysfs_emit(buf,"requested_hz=%lu register=%08x powered=%u transitions=%u fault=%u\n",p->rate,readl(p->clock),!!(readl(p->status)&1),p->transitions,p->fault);
+	mutex_unlock(&p->lock);return n;
+}
+static DEVICE_ATTR_RO(clocks);
+
+static int t110_gpu_on(struct generic_pm_domain *domain)
+{
+	struct t110_gpu_power *p = container_of(domain, struct t110_gpu_power, domain);
+	u32 value;
+	int ret;
+	mutex_lock(&p->lock);
+	if(p->fault){ret=-EIO;goto out;}
+	/* PLL1_624 / (3+1) = 156 MHz, for both core and AXI bus.
+	 * Only the GC clock/reset register is changed; CPU/DDR PLLs stay put.
+	 */
+	if(p->rate>156000000){ret=t110_gpu_voltage_ready();if(ret)goto out;}
+	writel(readl(p->clock)|BIT(3)|BIT(4)|BIT(5)|BIT(11),p->clock);
+	ret=gc_program(p,p->rate);
+	if(ret) goto out;
+	/* Vendor's hardware power sequencer handles isolation and resets. */
+	writel(0x20001fff, p->timer);
+	writel(readl(p->control) | BIT(0), p->control);
+	ret = readl_poll_timeout(p->status, value, value & BIT(0), 200, 10000);
+	if (ret) {
+		pr_err("T110_GPU_R: GC power-on timed out\n");
+		goto out;
+	}
+out:
+	mutex_unlock(&p->lock);return ret;
+}
+
+static int t110_gpu_off(struct generic_pm_domain *domain)
+{
+	struct t110_gpu_power *p = container_of(domain, struct t110_gpu_power, domain);
+	u32 value;
+	int ret;
+	mutex_lock(&p->lock);
+	writel(readl(p->control) & ~BIT(0), p->control);
+	ret = readl_poll_timeout(p->status, value, !(value & BIT(0)), 200, 10000);
+	if (!ret) writel(readl(p->clock) & ~(BIT(3) | BIT(4) | BIT(5)), p->clock);
+	mutex_unlock(&p->lock);return ret;
+}
+
+static int t110_gpu_power_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct t110_gpu_power *p;
+	struct clk_init_data init={.name="t110-gc-core",.ops=&gc_ops,.flags=CLK_GET_RATE_NOCACHE};
+	int ret;
+	if (!of_machine_is_compatible("samsung,goyawifi")) return -ENODEV;
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p) return -ENOMEM;
+	p->clock = devm_platform_ioremap_resource(pdev, 0);
+	p->control = devm_platform_ioremap_resource(pdev, 1);
+	p->timer = devm_platform_ioremap_resource(pdev, 2);
+	p->status = devm_platform_ioremap_resource(pdev, 3);
+	if (IS_ERR(p->clock)) return PTR_ERR(p->clock);
+	if (IS_ERR(p->control)) return PTR_ERR(p->control);
+	if (IS_ERR(p->timer)) return PTR_ERR(p->timer);
+	if (IS_ERR(p->status)) return PTR_ERR(p->status);
+	mutex_init(&p->lock);p->rate=156000000;
+	p->hw.init=&init;
+	ret=devm_clk_hw_register(dev,&p->hw);if(ret)return ret;
+	ret=devm_of_clk_add_hw_provider(dev,of_clk_hw_simple_get,&p->hw);if(ret)return ret;
+	dev_set_drvdata(dev,p);
+	ret=device_create_file(dev,&dev_attr_clocks);if(ret)return ret;
+	p->domain.name = "t110-gc";
+	p->domain.power_on = t110_gpu_on;
+	p->domain.power_off = t110_gpu_off;
+	ret = pm_genpd_init(&p->domain, NULL, true);
+	if (ret) return ret;
+	ret = of_genpd_add_provider_simple(dev->of_node, &p->domain);
+	if (ret) { pm_genpd_remove(&p->domain); return ret; }
+	dev_info(dev, "GC provider ready; GPU remains off until driver use, clock=%08x status=%08x\n",
+		readl(p->clock), readl(p->status));
+	return 0;
+}
+
+static const struct of_device_id t110_gpu_power_match[] = {
+	{ .compatible = "samsung,t110-gpu-power" }, { }
+};
+static struct platform_driver t110_gpu_power_driver = {
+	.probe = t110_gpu_power_probe,
+	.driver = { .name = "t110-gpu-power", .of_match_table = t110_gpu_power_match },
+};
+builtin_platform_driver(t110_gpu_power_driver);
diff --git a/arch/arm/mach-mmp/pxa98x-pm822-monitor.c b/arch/arm/mach-mmp/pxa98x-pm822-monitor.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-pm822-monitor.c
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T110 voltage/NTC monitor and delegated charger state. RTC, ONKEY wake and PM822 IRQ support. */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/property.h>
+#include <linux/regmap.h>
+#include <linux/reboot.h>
+#include <linux/workqueue.h>
+#include <linux/ktime.h>
+#include "t110-ntc.h"
+#include "t110-fuel-model.h"
+
+struct t110_monitor {
+ struct regmap *base,*adc;
+ struct mutex lock;
+ struct power_supply_desc battery_desc,usb_desc;
+ struct power_supply *battery;
+ struct delayed_work fuel_work;
+ struct t110_fuel_model fuel;
+ unsigned long last_store;
+ u64 last_fuel_ms;
+ int seed_percent;
+ struct rtc_device *rtc;
+ int irq;
+ unsigned int saved_int_en,saved_irq_cfg;
+ bool suppress_power,owns_wakeup;
+};
+#include "t110-pm822-rtc.h"
+static int adc_raw(struct t110_monitor *m,unsigned int reg)
+{
+ u8 b[2];int ret=regmap_bulk_read(m->adc,reg,b,2);
+ return ret?ret:(b[0]<<4)|(b[1]&15);
+}
+static int battery_temperature(struct t110_monitor *m,int *temperature)
+{
+ static const u8 biases[]={6,12,3,2,1};
+ int ret=-ENODATA,raw,mv,resistance,i,j;unsigned int old;
+ mutex_lock(&m->lock);
+ for(i=0;i<ARRAY_SIZE(biases);i++) {
+  ret=regmap_read(m->adc,0x0d,&old);if(ret)goto out;
+  if((old&15)!=biases[i]) {
+   ret=regmap_update_bits(m->adc,0x0d,15,biases[i]);if(ret)goto out;
+   msleep(50);
+  }
+  raw=adc_raw(m,0x58);if(raw<0){ret=raw;goto out;}
+  mv=(raw*700)>>11;
+  if(mv<=300||mv>=1250)continue;
+  resistance=mv*10000/(biases[i]*5+1);
+  if(resistance>t110_ntc[0] || resistance<t110_ntc[ARRAY_SIZE(t110_ntc)-1])continue;
+  for(j=0;j<ARRAY_SIZE(t110_ntc);j++)if(resistance>=t110_ntc[j])break;
+  ret=j-25;
+  /* Same GOYA thermistor calibration offset as the vendor driver. */
+  if(ret<50)ret-=3;
+  *temperature=ret*10;
+  ret=0;
+  goto out;
+ }
+ ret=-ENODATA;
+out:
+ mutex_unlock(&m->lock);
+ return ret;
+}
+static enum power_supply_property battery_props[]={
+ POWER_SUPPLY_PROP_STATUS,POWER_SUPPLY_PROP_PRESENT,
+ POWER_SUPPLY_PROP_TECHNOLOGY,POWER_SUPPLY_PROP_VOLTAGE_NOW,
+ POWER_SUPPLY_PROP_VOLTAGE_AVG,POWER_SUPPLY_PROP_TEMP,
+ POWER_SUPPLY_PROP_MODEL_NAME,
+ POWER_SUPPLY_PROP_HEALTH,POWER_SUPPLY_PROP_CAPACITY,
+};
+static int battery_get(struct power_supply *psy,enum power_supply_property prop,
+ union power_supply_propval *v)
+{
+ struct t110_monitor *m=power_supply_get_drvdata(psy);int raw,ret;
+ switch(prop) {
+ case POWER_SUPPLY_PROP_STATUS:
+ case POWER_SUPPLY_PROP_HEALTH: {
+  struct power_supply *charger=power_supply_get_by_name("t110-charger");
+  if(!charger){v->intval=prop==POWER_SUPPLY_PROP_STATUS?POWER_SUPPLY_STATUS_UNKNOWN:POWER_SUPPLY_HEALTH_UNKNOWN;return 0;}
+  ret=power_supply_get_property(charger,prop,v);power_supply_put(charger);return ret;
+ }
+ case POWER_SUPPLY_PROP_CAPACITY: {
+  mutex_lock(&m->lock);v->intval=fg_percent(&m->fuel);mutex_unlock(&m->lock);return 0;
+ }
+ case POWER_SUPPLY_PROP_PRESENT:v->intval=1;return 0; /* internal, non-removable */
+ case POWER_SUPPLY_PROP_TECHNOLOGY:v->intval=POWER_SUPPLY_TECHNOLOGY_LION;return 0;
+ case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+ case POWER_SUPPLY_PROP_VOLTAGE_AVG:
+  raw=adc_raw(m,prop==POWER_SUPPLY_PROP_VOLTAGE_NOW?0x42:0xa0);
+  if(raw<0)return raw;
+  if(!raw || raw==4095)return -ENODATA;
+  v->intval=DIV_ROUND_CLOSEST(raw*5600000LL,4096);return 0;
+ case POWER_SUPPLY_PROP_TEMP:
+  ret=battery_temperature(m,&v->intval);
+  return ret;
+ case POWER_SUPPLY_PROP_MODEL_NAME:v->strval="SM-T110 PM822 (GOYA software fuel model)";return 0;
+ default:return -EINVAL;
+ }
+}
+static enum power_supply_property usb_props[]={POWER_SUPPLY_PROP_ONLINE};
+static int usb_get(struct power_supply *psy,enum power_supply_property prop,
+ union power_supply_propval *v)
+{
+ struct t110_monitor *m=power_supply_get_drvdata(psy);unsigned int status;
+ int ret=regmap_read(m->base,1,&status);if(ret)return ret;
+ v->intval=!!(status&BIT(2));return 0;
+}
+static void onkey_poll(struct input_dev *input)
+{
+ struct t110_monitor *m=input_get_drvdata(input);unsigned int status;
+ if(regmap_read(m->base,1,&status))return;
+ if(READ_ONCE(m->suppress_power)){if(status&1)return;WRITE_ONCE(m->suppress_power,false);}
+ input_report_key(input,KEY_POWER,!!(status&1));input_sync(input);
+}
+static int fuel_store(struct t110_monitor *m)
+{
+ int ret;unsigned int old;int p=fg_div(m->fuel.soc,1000000);
+ ret=regmap_read(m->base,0xee,&old);if(ret)return ret;
+ ret=regmap_write(m->base,0xdd,fg_clamp(m->fuel.v1_uv/3000,-32,31)&0x3f);if(ret)return ret;
+ ret=regmap_write(m->base,0xde,fg_clamp(m->fuel.v2_uv/3000,-32,31)&0x3f);if(ret)return ret;
+ ret=regmap_write(m->base,0xe0,fg_div(m->fuel.soc-(long long)p*1000000,100000));if(ret)return ret;
+ return regmap_write(m->base,0xee,(old&0x80)|p);
+}
+static void fuel_update(struct work_struct *work)
+{
+ struct t110_monitor *m=container_of(to_delayed_work(work),struct t110_monitor,fuel_work);
+ struct power_supply *charger=power_supply_get_by_name("t110-charger");
+ union power_supply_propval status={.intval=POWER_SUPPLY_STATUS_UNKNOWN};
+ int raw,temp,old,ret;u64 now;
+ /* Never take the charger mutex while holding the monitor mutex. */
+ if(charger){power_supply_get_property(charger,POWER_SUPPLY_PROP_STATUS,&status);power_supply_put(charger);}
+ raw=adc_raw(m,0xa0);ret=battery_temperature(m,&temp);
+ if(raw>0&&raw<4095&&!ret) {
+  mutex_lock(&m->lock);now=div_u64(ktime_get_boottime_ns(),NSEC_PER_MSEC);
+  old=fg_percent(&m->fuel);
+  fg_step(&m->fuel,DIV_ROUND_CLOSEST(raw*5600000LL,4096),temp,
+   min_t(u64,5000,now-m->last_fuel_ms),status.intval==POWER_SUPPLY_STATUS_FULL);
+  m->last_fuel_ms=now;
+  if(time_after(jiffies,m->last_store+60*HZ)) {
+   ret=fuel_store(m);if(!ret)m->last_store=jiffies;
+  }
+  ret=old!=fg_percent(&m->fuel);mutex_unlock(&m->lock);
+  if(ret)power_supply_changed(m->battery);
+ }
+ schedule_delayed_work(&m->fuel_work,5*HZ);
+}
+static void fuel_stop(void *data)
+{
+ struct t110_monitor *m=data;cancel_delayed_work_sync(&m->fuel_work);
+ mutex_lock(&m->lock);fuel_store(m);mutex_unlock(&m->lock);
+}
+static ssize_t fuel_model_show(struct device *dev,struct device_attribute *a,char *buf)
+{
+ struct t110_monitor *m=dev_get_drvdata(dev);int n;
+ mutex_lock(&m->lock);
+ n=sysfs_emit(buf,"seed_percent=%d estimated_percent=%d soc_micro_percent=%lld v1_uV=%d v2_uV=%d modeled_current_uA=%d rs_milliohm=%d\n",
+ m->seed_percent,fg_percent(&m->fuel),m->fuel.soc,m->fuel.v1_uv,m->fuel.v2_uv,m->fuel.current_ua,m->fuel.rs_mohm);
+ mutex_unlock(&m->lock);return n;
+}
+static DEVICE_ATTR_RO(fuel_model);
+static struct attribute *fuel_attrs[]={&dev_attr_fuel_model.attr,NULL};
+static const struct attribute_group fuel_group={.attrs=fuel_attrs};
+/* The restart2 command is consumed while PMIC I2C can still sleep.
+ * This replaces the userspace /dev/i2c recovery-flag writer.
+ */
+static int monitor_restart_prepare(struct sys_off_data *data)
+{
+ struct t110_monitor *m=data->cb_data;
+ unsigned int value=data->cmd && !strcmp(data->cmd,"recovery") ? 6 : 0;
+ unsigned int check;
+ int ret=regmap_update_bits(m->base,0xef,0x1f,value);
+ if(!ret)ret=regmap_read(m->base,0xef,&check);
+ if(!ret && (check&0x1f)!=value)ret=-EIO;
+ if(ret)dev_err(data->dev,"PM822 restart reason failed: %d\n",ret);
+ return NOTIFY_DONE;
+}
+/* Sleepable shutdown phase: exact vendor PM822 power-down sequence. */
+static int monitor_poweroff(struct sys_off_data *data)
+{
+ struct t110_monitor *m=data->cb_data;
+ int ret=regmap_write(m->base,0xef,0xa0);
+ if(!ret)ret=regmap_update_bits(m->base,0x0d,BIT(5),BIT(5));
+ if(ret)pr_err("t110: PM822 power-off failed: %d\n",ret);
+ msleep(500);
+ return NOTIFY_DONE;
+}
+static int monitor_poweroff_failed(struct sys_off_data *data)
+{
+ pr_emerg("t110: PM822 power-off did not remove power\n");
+ return NOTIFY_DONE;
+}
+static int monitor_probe(struct i2c_client *client)
+{
+ struct device *dev=&client->dev;struct t110_monitor *m;
+ struct i2c_client *adc;struct input_dev *input;struct power_supply *psy;
+ struct regmap_config mapcfg={.reg_bits=8,.val_bits=8,.max_register=0xff};
+ struct power_supply_config cfg={.fwnode=dev_fwnode(dev)};
+ unsigned int id,saved,v1,v2,fraction;int ret,initial;
+ m=devm_kzalloc(dev,sizeof(*m),GFP_KERNEL);if(!m)return -ENOMEM;
+ mutex_init(&m->lock);
+ INIT_DELAYED_WORK(&m->fuel_work,fuel_update);
+ i2c_set_clientdata(client,m);
+ m->base=devm_regmap_init_i2c(client,&mapcfg);if(IS_ERR(m->base))return PTR_ERR(m->base);
+ ret=regmap_read(m->base,0,&id);if(ret)return ret;
+ if(id!=0x82)return dev_err_probe(dev,-ENODEV,"Expected PM822 ID82, got %02x\n",id);
+ adc=devm_i2c_new_dummy_device(dev,client->adapter,0x32);if(IS_ERR(adc))return PTR_ERR(adc);
+ m->adc=devm_regmap_init_i2c(adc,&mapcfg);if(IS_ERR(m->adc))return PTR_ERR(m->adc);
+ /* Enable only voltage and NTC measurements, preserving other ADC users. */
+ ret=regmap_update_bits(m->adc,1,BIT(2),BIT(2));if(ret)return ret;
+ ret=regmap_update_bits(m->adc,2,BIT(4),BIT(4));if(ret)return ret;
+ ret=regmap_update_bits(m->adc,6,3,3);if(ret)return ret;
+ ret=regmap_update_bits(m->adc,0x0d,15,6);if(ret)return ret;
+ ret=regmap_update_bits(m->adc,0x14,0x44,0x44);if(ret)return ret;
+ msleep(100);
+ /* Exact stock fuel-state slots. Preserve unrelated PMIC/RTC registers. */
+ ret=regmap_read(m->base,0xee,&saved);if(ret)return ret;
+ ret=regmap_read(m->base,0xdd,&v1);if(ret)return ret;
+ ret=regmap_read(m->base,0xde,&v2);if(ret)return ret;
+ ret=regmap_read(m->base,0xe0,&fraction);if(ret)return ret;
+ initial=saved&0x7f;
+ if((saved&0x80)||initial>100) {
+  int raw=adc_raw(m,0xa0),mv;if(raw<=0||raw>=4095)return -ENODATA;
+  mv=DIV_ROUND_CLOSEST(raw*5600,4096);
+  for(initial=0;initial<100&&mv>=t110_ocv[initial+1];initial++);
+  v1=v2=fraction=0;
+ }
+ m->seed_percent=initial;
+ fg_seed(&m->fuel,initial,sign_extend32(v1&0x3f,5)*3000,sign_extend32(v2&0x3f,5)*3000);
+ if(initial<100&&fraction<10)m->fuel.soc+=fraction*100000;
+ m->last_fuel_ms=div_u64(ktime_get_boottime_ns(),NSEC_PER_MSEC);m->last_store=jiffies;
+ cfg.drv_data=m;
+ m->battery_desc=(struct power_supply_desc){.name="t110-battery",.type=POWER_SUPPLY_TYPE_BATTERY,.properties=battery_props,.num_properties=ARRAY_SIZE(battery_props),.get_property=battery_get};
+ psy=devm_power_supply_register(dev,&m->battery_desc,&cfg);if(IS_ERR(psy))return PTR_ERR(psy);
+ m->battery=psy;
+ m->usb_desc=(struct power_supply_desc){.name="t110-usb",.type=POWER_SUPPLY_TYPE_USB,.properties=usb_props,.num_properties=ARRAY_SIZE(usb_props),.get_property=usb_get};
+ psy=devm_power_supply_register(dev,&m->usb_desc,&cfg);if(IS_ERR(psy))return PTR_ERR(psy);
+ input=devm_input_allocate_device(dev);if(!input)return -ENOMEM;
+ input->name="PM822 Power Button";input->id.bustype=BUS_I2C;
+ input_set_drvdata(input,m);input_set_capability(input,EV_KEY,KEY_POWER);
+ ret=input_setup_polling(input,onkey_poll);if(ret)return ret;
+ input_set_poll_interval(input,40);
+ ret=input_register_device(input);if(ret)return ret;
+ ret=t110_rtc_setup(client,m);if(ret)return ret;
+ ret=devm_register_sys_off_handler(dev,SYS_OFF_MODE_RESTART_PREPARE,
+  SYS_OFF_PRIO_DEFAULT,monitor_restart_prepare,m);if(ret)return ret;
+ ret=devm_register_sys_off_handler(dev,SYS_OFF_MODE_POWER_OFF_PREPARE,
+  SYS_OFF_PRIO_DEFAULT,monitor_poweroff,m);if(ret)return ret;
+ ret=devm_register_sys_off_handler(dev,SYS_OFF_MODE_POWER_OFF,
+  SYS_OFF_PRIO_DEFAULT,monitor_poweroff_failed,m);if(ret)return ret;
+ ret=devm_device_add_group(dev,&fuel_group);if(ret)return ret;
+ ret=devm_add_action_or_reset(dev,fuel_stop,m);if(ret)return ret;
+ schedule_delayed_work(&m->fuel_work,5*HZ);
+ dev_info(dev,"VBAT/NTC, GOYA RC fuel model seeded at %d%%, charger state, ONKEY and PM822 power-off\n",initial);
+ return 0;
+}
+static const struct of_device_id monitor_match[]={{.compatible="samsung,t110-pm822-monitor"},{}};
+MODULE_DEVICE_TABLE(of,monitor_match);
+static void monitor_shutdown(struct i2c_client *client){fuel_stop(i2c_get_clientdata(client));}
+static struct i2c_driver monitor_driver={.probe=monitor_probe,.shutdown=monitor_shutdown,.driver={.name="t110-pm822-monitor",.of_match_table=monitor_match,.pm=pm_sleep_ptr(&t110_monitor_pm)}};
+module_i2c_driver(monitor_driver);
+MODULE_LICENSE("GPL");
diff --git a/arch/arm/mach-mmp/pxa98x-pm822-touch.c b/arch/arm/mach-mmp/pxa98x-pm822-touch.c
new file mode 100644
--- /dev/null
+++ b/arch/arm/mach-mmp/pxa98x-pm822-touch.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Bounded SM-T110 bring-up: PM822 power-page LDO1, touch analog rail only. */
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+static const unsigned int voltages[] = {
+ 1700000,1800000,1900000,2500000,2800000,2900000,3100000,3300000
+};
+static const struct regulator_ops touch_ops = {
+ .list_voltage=regulator_list_voltage_table,
+ .map_voltage=regulator_map_voltage_iterate,
+ .get_voltage_sel=regulator_get_voltage_sel_regmap,
+ .set_voltage_sel=regulator_set_voltage_sel_regmap,
+ .enable=regulator_enable_regmap,
+ .disable=regulator_disable_regmap,
+ .is_enabled=regulator_is_enabled_regmap,
+};
+static const struct regulator_desc touch_desc = {
+ .name="pm822-tsp-ldo1", .type=REGULATOR_VOLTAGE, .owner=THIS_MODULE,
+ .ops=&touch_ops, .volt_table=voltages, .n_voltages=ARRAY_SIZE(voltages),
+ .vsel_reg=0x08, .vsel_mask=0x0f, .enable_reg=0x51, .enable_mask=1,
+ .enable_time=15000,
+};
+static const unsigned int wifi_voltages[] = {
+ 1200000,1250000,1700000,1800000,1850000,1900000,2500000,2600000,
+ 2700000,2750000,2800000,2850000,2900000,3000000,3100000,3300000
+};
+static const struct regulator_desc wifi_desc = {
+ .name="pm822-wifi-ldo10", .type=REGULATOR_VOLTAGE, .owner=THIS_MODULE,
+ .ops=&touch_ops, .volt_table=wifi_voltages, .n_voltages=ARRAY_SIZE(wifi_voltages),
+ .vsel_reg=0x13, .vsel_mask=0x0f, .enable_reg=0x52, .enable_mask=BIT(1),
+ .enable_time=15000,
+};
+static const struct regulator_desc sensor_desc = {
+ .name="pm822-sensor-ldo11", .type=REGULATOR_VOLTAGE, .owner=THIS_MODULE,
+ .ops=&touch_ops, .volt_table=wifi_voltages, .n_voltages=ARRAY_SIZE(wifi_voltages),
+ .vsel_reg=0x14, .vsel_mask=0x0f, .enable_reg=0x52, .enable_mask=BIT(2),
+ .enable_time=15000,
+};
+static const struct regulator_desc gps_desc = {
+ .name="pm822-gps-ldo13",.type=REGULATOR_VOLTAGE,.owner=THIS_MODULE,
+ .ops=&touch_ops,.volt_table=voltages,.n_voltages=ARRAY_SIZE(voltages),
+ .vsel_reg=0x16,.vsel_mask=0x0f,.enable_reg=0x52,.enable_mask=BIT(4),.enable_time=15000,
+};
+static const unsigned int core_voltages[]={
+ 600000,650000,700000,750000,800000,850000,900000,950000,
+ 1000000,1050000,1100000,1150000,1200000,1300000,1400000,1500000
+};
+static const struct regulator_desc bridge_desc[]={
+ {.name="pm822-lvds-ldo9",.type=REGULATOR_VOLTAGE,.owner=THIS_MODULE,
+  .ops=&touch_ops,.volt_table=wifi_voltages,.n_voltages=ARRAY_SIZE(wifi_voltages),
+  .vsel_reg=0x12,.vsel_mask=0x0f,.enable_reg=0x52,.enable_mask=BIT(0),.enable_time=5000},
+ {.name="pm822-lvds-ldo12",.type=REGULATOR_VOLTAGE,.owner=THIS_MODULE,
+  .ops=&touch_ops,.volt_table=core_voltages,.n_voltages=ARRAY_SIZE(core_voltages),
+  .vsel_reg=0x15,.vsel_mask=0x0f,.enable_reg=0x52,.enable_mask=BIT(3),.enable_time=5000}
+};
+static const struct regulator_desc sd_desc[]={
+ {.name="pm822-sd-ldo4",.type=REGULATOR_VOLTAGE,.owner=THIS_MODULE,
+  .ops=&touch_ops,.volt_table=wifi_voltages,.n_voltages=ARRAY_SIZE(wifi_voltages),
+  .vsel_reg=0x0d,.vsel_mask=0x0f,.enable_reg=0x51,.enable_mask=BIT(3),.enable_time=15000},
+ {.name="pm822-sd-ldo5",.type=REGULATOR_VOLTAGE,.owner=THIS_MODULE,
+  .ops=&touch_ops,.volt_table=wifi_voltages,.n_voltages=ARRAY_SIZE(wifi_voltages),
+  .vsel_reg=0x0e,.vsel_mask=0x0f,.enable_reg=0x51,.enable_mask=BIT(4),.enable_time=15000}
+};
+static int touch_power_probe(struct i2c_client *client)
+{
+ struct regulator_config cfg={.dev=&client->dev,.of_node=client->dev.of_node};
+ struct regmap_config mapcfg={.reg_bits=8,.val_bits=8,.max_register=0xd8};
+ struct regulator_dev *rdev;
+ u8 reg=0,id=0;
+ struct i2c_msg msgs[]={{.addr=0x30,.len=1,.buf=&reg},
+  {.addr=0x30,.flags=I2C_M_RD,.len=1,.buf=&id}};
+ int ret=i2c_transfer(client->adapter,msgs,2);
+ if(ret!=2)return ret<0?ret:-EIO;
+ if(id!=0x82)return dev_err_probe(&client->dev,-ENODEV,"PM822 ID mismatch: %02x\n",id);
+ cfg.regmap=devm_regmap_init_i2c(client,&mapcfg);
+ if(IS_ERR(cfg.regmap))return PTR_ERR(cfg.regmap);
+ cfg.init_data=of_get_regulator_init_data(&client->dev,client->dev.of_node,&touch_desc);
+ rdev=devm_regulator_register(&client->dev,&touch_desc,&cfg);
+ if(IS_ERR(rdev))return PTR_ERR(rdev);
+ cfg.of_node=of_get_child_by_name(client->dev.of_node,"wifi-regulator");
+ if(cfg.of_node) {
+  cfg.init_data=of_get_regulator_init_data(&client->dev,cfg.of_node,&wifi_desc);
+  rdev=devm_regulator_register(&client->dev,&wifi_desc,&cfg);
+  of_node_put(cfg.of_node);
+  if(IS_ERR(rdev))return PTR_ERR(rdev);
+ }
+ for(int i=0;i<2;i++) {
+  unsigned int selector;
+  cfg.of_node=of_get_child_by_name(client->dev.of_node,i?"bridge-core-regulator":"bridge-io-regulator");
+  if(!cfg.of_node)continue;
+  ret=regmap_read(cfg.regmap,bridge_desc[i].vsel_reg,&selector);
+  if(ret||(selector&15)!=(i?12:3)) {
+   of_node_put(cfg.of_node);return dev_err_probe(&client->dev,ret?:-EINVAL,"Unexpected bridge LDO selector\n");
+  }
+  cfg.init_data=of_get_regulator_init_data(&client->dev,cfg.of_node,&bridge_desc[i]);
+  rdev=devm_regulator_register(&client->dev,&bridge_desc[i],&cfg);
+  of_node_put(cfg.of_node);if(IS_ERR(rdev))return PTR_ERR(rdev);
+ }
+ for(int i=0;i<2;i++) {
+  cfg.of_node=of_get_child_by_name(client->dev.of_node,i?"sd-io-regulator":"sd-card-regulator");
+  if(!cfg.of_node)continue;
+  cfg.init_data=of_get_regulator_init_data(&client->dev,cfg.of_node,&sd_desc[i]);
+  rdev=devm_regulator_register(&client->dev,&sd_desc[i],&cfg);
+  of_node_put(cfg.of_node);if(IS_ERR(rdev))return PTR_ERR(rdev);
+ }
+ cfg.of_node=of_get_child_by_name(client->dev.of_node,"sensor-regulator");
+ if(cfg.of_node) {
+  cfg.init_data=of_get_regulator_init_data(&client->dev,cfg.of_node,&sensor_desc);
+  rdev=devm_regulator_register(&client->dev,&sensor_desc,&cfg);
+  of_node_put(cfg.of_node);if(IS_ERR(rdev))return PTR_ERR(rdev);
+ }
+ cfg.of_node=of_get_child_by_name(client->dev.of_node,"gps-regulator");
+ if(cfg.of_node) {
+  cfg.init_data=of_get_regulator_init_data(&client->dev,cfg.of_node,&gps_desc);
+  rdev=devm_regulator_register(&client->dev,&gps_desc,&cfg);
+  of_node_put(cfg.of_node);if(IS_ERR(rdev))return PTR_ERR(rdev);
+ }
+ dev_info(&client->dev,"PM822 ID82: touch, Wi-Fi, bridge and SD LDO4/LDO5 registered\n");
+ return 0;
+}
+static const struct of_device_id touch_power_match[] = {
+ {.compatible="samsung,t110-pm822-touch-ldo1"},{}
+};
+MODULE_DEVICE_TABLE(of,touch_power_match);
+static struct i2c_driver touch_power_driver={
+ .probe=touch_power_probe,
+ .driver={.name="t110-pm822-touch",.of_match_table=touch_power_match},
+};
+module_i2c_driver(touch_power_driver);
+MODULE_LICENSE("GPL");
