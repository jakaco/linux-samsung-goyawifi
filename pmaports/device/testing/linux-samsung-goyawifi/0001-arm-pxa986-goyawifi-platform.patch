Subject: [PATCH 1/4] SM-T110 local port: arm-pxa986-goyawifi-platform

diff --git a/arch/arm/Makefile b/arch/arm/Makefile
--- a/arch/arm/Makefile
+++ b/arch/arm/Makefile
@@ -160,6 +160,7 @@
 # during boot, and this offset is critical to the functioning of
 # kexec-tools.
 textofs-y	:= 0x00008000
+textofs-$(CONFIG_MACH_PXA98X_DT) := 0x00108000
 # RTD1195 has Boot ROM at start of address space
 textofs-$(CONFIG_ARCH_REALTEK)  := 0x00108000
 # SA1111 DMA bug: we don't want the kernel to live in precious DMA-able memory
diff --git a/arch/arm/boot/compressed/head.S b/arch/arm/boot/compressed/head.S
--- a/arch/arm/boot/compressed/head.S
+++ b/arch/arm/boot/compressed/head.S
@@ -308,6 +308,10 @@
 		bl	fdt_check_mem_start
 1:
 #endif /* CONFIG_USE_OF */
+		/* SM-T110 loader puts zImage at 0x10008000; low RAM starts at 0. */
+#ifdef CONFIG_MACH_PXA98X_DT
+		mov	r0, #0
+#endif
 		/* Determine final kernel image address. */
 		add	r4, r0, #TEXT_OFFSET
 #else
@@ -1021,7 +1025,7 @@
 		W(b)	__armv3_mpu_cache_on
 		W(b)	__armv3_mpu_cache_off
 		W(b)	__armv3_mpu_cache_flush
-		
+
 		.word	0x41009400		@ ARM94x
 		.word	0xff00ff00
 		W(b)	__armv4_mpu_cache_on
@@ -1237,7 +1241,7 @@
 		mcrne	p15, 0, ip, c7, c5, 0	@ invalidate I cache
 		mcr	p15, 0, ip, c7, c10, 4	@ drain WB
 		mov	pc, lr
-		
+
 __fa526_cache_flush:
 		tst	r4, #1
 		movne	pc, lr
diff --git a/arch/arm/boot/dts/marvell/Makefile b/arch/arm/boot/dts/marvell/Makefile
--- a/arch/arm/boot/dts/marvell/Makefile
+++ b/arch/arm/boot/dts/marvell/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+dtb-$(CONFIG_MACH_PXA98X_DT) += pxa986-samsung-goyawifi.dtb
 dtb-$(CONFIG_ARCH_MMP) += \
 	pxa168-aspenite.dtb \
 	pxa910-dkb.dtb \
diff --git a/arch/arm/boot/dts/marvell/pxa986-samsung-goyawifi.dts b/arch/arm/boot/dts/marvell/pxa986-samsung-goyawifi.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm/boot/dts/marvell/pxa986-samsung-goyawifi.dts
@@ -0,0 +1,371 @@
+/dts-v1/;
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+/ {
+	model = "Samsung Galaxy Tab 3 Lite SM-T110";
+	compatible = "samsung,goyawifi", "marvell,pxa986";
+	#address-cells = <1>;
+	#size-cells = <1>;
+	interrupt-parent = <&gic>;
+	aliases { i2c0 = &camera_i2c; serial2 = &gps_uart; i2c5 = &sensor_i2c; i2c6 = &charger_i2c; i2c7 = &muic_i2c; i2c1 = &touch_i2c; i2c2 = &pmic_i2c; mmc0 = &emmc; mmc1 = &wifi; mmc2 = &microsd; };
+
+	gpio_clock: gpio-clock { compatible = "fixed-clock"; #clock-cells = <0>; clock-frequency = <13000000>; };
+	gpio: gpio@d4019000 {
+		compatible = "marvell,mmp-gpio";
+        samsung,goyawifi-s2idle-wake-parent;
+		reg = <0xd4019000 0x1000>;
+		gpio-controller; #gpio-cells = <2>;
+		interrupt-controller; #interrupt-cells = <2>; #address-cells = <0>;
+		interrupts = <GIC_SPI 49 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "gpio_mux";
+		clocks = <&gpio_clock>;
+	};
+
+ camera_clock: camera-clock@d4282850 {
+  compatible="samsung,t110-camera-clock";
+  reg=<0xd4282850 4>,<0xd4282888 4>,<0xd428284c 4>;
+  #clock-cells=<0>;
+ };
+ ccic: camera@d420a000 {
+  compatible="samsung,t110-ccic","marvell,mmp2-ccic";
+  reg=<0xd420a000 0x1000>;interrupts=<GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
+  clocks=<&camera_clock>,<&camera_clock>,<&camera_clock>;
+  clock-names="axi","func","phy";
+  #clock-cells=<0>;clock-output-names="t110-camera-mclk";
+  port { ccic_in: endpoint {remote-endpoint=<&sensor_out>;bus-type=<4>;clock-lanes=<0>;data-lanes=<1>;}; };
+ };
+ camera_i2c: i2c-camera {
+  compatible="i2c-gpio";
+  sda-gpios=<&gpio 54 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
+  scl-gpios=<&gpio 53 (GPIO_ACTIVE_HIGH|GPIO_OPEN_DRAIN)>;
+  i2c-gpio,delay-us=<5>;i2c-gpio,timeout-ms=<100>;
+  #address-cells=<1>;#size-cells=<0>;
+  sensor@20 {
+   compatible="siliconfile,sr200pc20m";reg=<0x20>;clocks=<&ccic>;
+   io-enable-gpios=<&gpio 79 GPIO_ACTIVE_HIGH>;
+   analog-enable-gpios=<&gpio 80 GPIO_ACTIVE_HIGH>;
+   standby-gpios=<&gpio 14 GPIO_ACTIVE_HIGH>;
+   reset-gpios=<&gpio 15 GPIO_ACTIVE_LOW>;
+   port {sensor_out: endpoint {remote-endpoint=<&ccic_in>;bus-type=<4>;clock-lanes=<0>;data-lanes=<1>;};};
+  };
+ };
+ gps_uart_clock: gps-uart-clock { compatible="fixed-clock"; #clock-cells=<0>; clock-frequency=<14745600>; };
+ gps_uart: serial@d4018000 {
+  compatible="mrvl,mmp-uart"; reg=<0xd4018000 0x1000>;
+  interrupts=<GIC_SPI 28 IRQ_TYPE_LEVEL_HIGH>;
+  reg-shift=<2>; reg-io-width=<4>; clocks=<&gps_uart_clock>;
+ };
+ gps-control {
+  compatible="samsung,t110-gps-control";
+  vcc-supply=<&gps_ldo>;
+  reset-gpios=<&gpio 5 GPIO_ACTIVE_LOW>;
+  onoff-gpios=<&gpio 52 GPIO_ACTIVE_HIGH>;
+  clock-gpios=<&gpio 89 GPIO_ACTIVE_HIGH>;
+ };
+ sensor_i2c: i2c-sensors {
+  compatible = "i2c-gpio";
+  sda-gpios = <&gpio 36 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  scl-gpios = <&gpio 35 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  i2c-gpio,delay-us = <5>; i2c-gpio,timeout-ms = <100>;
+  #address-cells = <1>; #size-cells = <0>;
+  accelerometer@18 {
+   compatible = "bosch,bma255"; reg = <0x18>;
+   vdd-supply = <&sensor_ldo>;
+   /* VDDIO remains supplied by the existing board setup. */
+   interrupt-parent = <&gpio>; interrupts = <10 IRQ_TYPE_EDGE_RISING>;
+   interrupt-names = "INT1";
+   mount-matrix = "-1", "0", "0", "0", "1", "0", "0", "0", "-1";
+  };
+ };
+ charger_i2c: i2c-charger {
+  compatible = "i2c-gpio";
+  sda-gpios = <&gpio 17 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  scl-gpios = <&gpio 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  i2c-gpio,delay-us = <10>; i2c-gpio,timeout-ms = <100>;
+  #address-cells = <1>; #size-cells = <0>;
+  charger@34 { compatible = "samsung,t110-smb328"; reg = <0x34>; };
+ };
+ muic_i2c: i2c-muic {
+  compatible = "i2c-gpio";
+  sda-gpios = <&gpio 50 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  scl-gpios = <&gpio 49 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+  i2c-gpio,delay-us = <10>; i2c-gpio,timeout-ms = <100>;
+  #address-cells = <1>; #size-cells = <0>;
+ };
+	keys {
+		compatible = "gpio-keys";
+		volume-up { label = "Volume Up"; linux,code = <KEY_VOLUMEUP>; gpios = <&gpio 1 GPIO_ACTIVE_LOW>; debounce-interval = <30>; };
+		volume-down { label = "Volume Down"; linux,code = <KEY_VOLUMEDOWN>; gpios = <&gpio 2 GPIO_ACTIVE_LOW>; debounce-interval = <30>; };
+		home { label = "Home"; wakeup-source; linux,code = <KEY_HOME>; gpios = <&gpio 13 GPIO_ACTIVE_LOW>; debounce-interval = <30>; };
+	};
+	touch_i2c: i2c@d4010800 {
+        samsung,goyawifi-shared-bus;
+        sleep-scl-gpios = <&gpio 87 GPIO_ACTIVE_HIGH>;
+        sleep-sda-gpios = <&gpio 88 GPIO_ACTIVE_HIGH>;
+		compatible = "mrvl,mmp-twsi";
+		reg = <0xd4010800 0x60>;
+		interrupts = <GIC_SPI 33 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&pmic_clock>;
+		#address-cells = <1>; #size-cells = <0>;
+		backlight@64 {
+			compatible = "samsung,t110-vx5b3d-backlight";
+            bridge-core-supply = <&bridge_core>;
+            bridge-io-supply = <&bridge_io>;
+            panel-enable-gpios = <&gpio 9 GPIO_ACTIVE_HIGH>;
+            led-enable-gpios = <&gpio 12 GPIO_ACTIVE_HIGH>;
+            bridge-enable-gpios = <&gpio 19 GPIO_ACTIVE_HIGH>;
+            bridge-reset-gpios = <&gpio 20 GPIO_ACTIVE_HIGH>;
+
+			reg = <0x64>;
+		};
+		touchscreen@20 {
+			compatible = "zinitix,bt532";
+			reg = <0x20>;
+			interrupt-parent = <&gpio>;
+			interrupts = <94 IRQ_TYPE_EDGE_FALLING>;
+			vcca-supply = <&touch_ldo>;
+			/* Digital IO rail remains supplied by the existing board setup. */
+			touchscreen-size-x = <600>;
+			touchscreen-size-y = <1024>;
+			touchscreen-inverted-x;
+			touchscreen-swapped-x-y;
+			zinitix,mode = <0>;
+		};
+	};
+
+	soc_thermal: thermal-sensor@d4013200 {
+		compatible = "samsung,t110-pxa986-thermal";
+		reg = <0xd4013200 0x34>;
+		#thermal-sensor-cells = <0>;
+	};
+	thermal-zones {
+		pxa986-hot {
+			polling-delay = <2000>;
+			polling-delay-passive = <2000>;
+			thermal-sensors = <&soc_thermal>;
+			cooling-maps { cpu-limit { trip = <&passive>; cooling-device = <&cpu0 0 3>; }; gpu-limit { trip = <&passive>; cooling-device = <&gc_gpu 0 3>; }; };
+			trips {
+				passive: passive { temperature = <95000>; hysteresis = <5000>; type = "passive"; };
+				critical { temperature = <110000>; hysteresis = <5000>; type = "critical"; };
+			};
+		};
+	};
+	emmc_clock: emmc-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <52000000>;
+	};
+
+	wifi_pwrseq: wifi-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		reset-gpios = <&gpio 51 GPIO_ACTIVE_LOW>;
+		post-power-on-delay-ms = <20>;
+	};
+	wifi: mmc@d4280800 {
+		compatible = "mrvl,pxav3-mmc";
+		reg = <0xd4280800 0x120>;
+		interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&emmc_clock>;
+		clock-names = "io";
+		bus-width = <4>;
+		max-frequency = <26000000>;
+		non-removable;
+		no-sd; no-mmc; no-1-8-v;
+		cap-sdio-irq;
+        keep-power-in-suspend;
+		vmmc-supply = <&wifi_ldo>;
+		mmc-pwrseq = <&wifi_pwrseq>;
+		mrvl,clk-delay-cycles = <15>;
+	};
+	microsd: mmc@d4280000 {
+		compatible = "mrvl,pxav3-mmc";
+		reg = <0xd4280000 0x120>;
+		interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&emmc_clock>;
+		clock-names = "io";
+		bus-width = <4>;
+		max-frequency = <26000000>;
+		cd-gpios = <&gpio 11 GPIO_ACTIVE_LOW>;
+		cd-debounce-delay-ms = <200>;
+		disable-wp;
+		no-mmc; no-sdio; no-1-8-v;
+		vmmc-supply = <&sd_vmmc>;
+		vqmmc-supply = <&sd_vqmmc>;
+	};
+	emmc: mmc@d4281000 {
+		compatible = "mrvl,pxav3-mmc";
+		reg = <0xd4281000 0x120>;
+		interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&emmc_clock>;
+		clock-names = "io";
+		bus-width = <8>;
+		max-frequency = <26000000>;
+		non-removable;
+		no-sd;
+		no-sdio;
+		no-1-8-v;
+		mrvl,clk-delay-cycles = <15>;
+	};
+	pmic_clock: pmic-clock {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <33000000>;
+	};
+	pmic_i2c: i2c@d4037000 {
+		compatible = "mrvl,mmp-twsi";
+		reg = <0xd4037000 0x60>;
+		interrupts = <GIC_SPI 54 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&pmic_clock>;
+		mrvl,i2c-polling;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		pm805: codec@38 { compatible = "samsung,t110-pm805-audio"; reg = <0x38>; };
+
+		pmic_monitor: monitor@30 { compatible = "samsung,t110-pm822-monitor"; reg = <0x30>; interrupts = <GIC_SPI 4 IRQ_TYPE_LEVEL_HIGH>; wakeup-source; };
+		touch_ldo: regulator@31 {
+			compatible = "samsung,t110-pm822-touch-ldo1";
+			reg = <0x31>;
+			regulator-name = "v_tsp_2v8";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+			regulator-boot-on;
+			regulator-always-on;
+
+            bridge_io: bridge-io-regulator {
+                regulator-name = "v_lvds_1v8";
+                regulator-min-microvolt = <1800000>;
+                regulator-max-microvolt = <1800000>;
+                regulator-boot-on;
+            };
+            bridge_core: bridge-core-regulator {
+                regulator-name = "v_lvds_1v2";
+                regulator-min-microvolt = <1200000>;
+                regulator-max-microvolt = <1200000>;
+                regulator-boot-on;
+            };
+			sd_vmmc: sd-card-regulator {
+				regulator-name = "v_sd_3v3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+			};
+			sd_vqmmc: sd-io-regulator {
+				regulator-name = "v_mmc_3v3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+			};
+gps_ldo: gps-regulator {
+                regulator-name="v_gps_1v8";
+                regulator-min-microvolt=<1800000>;
+                regulator-max-microvolt=<1800000>;
+                regulator-boot-on;
+                regulator-always-on;
+            };
+sensor_ldo: sensor-regulator {
+                regulator-name = "v_sensor_2v8";
+                regulator-min-microvolt = <2800000>;
+                regulator-max-microvolt = <2800000>;
+                regulator-boot-on;
+                regulator-always-on;
+            };
+wifi_ldo: wifi-regulator {
+				regulator-name = "v_wib_3v3";
+				regulator-min-microvolt = <3300000>;
+				regulator-max-microvolt = <3300000>;
+			};
+		};
+	};
+	lcd@d420b000 {
+		compatible = "samsung,t110-lcd-handoff";
+		reg = <0xd420b000 0x200>;
+		interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
+	};
+	gc_power: gpu-power@d42828cc {
+		compatible = "samsung,t110-gpu-power";
+		reg = <0xd42828cc 4>, <0xd42828d8 4>, <0xd42828dc 4>, <0xd42828f0 4>;
+		#power-domain-cells = <0>;
+		#clock-cells = <0>;
+	};
+	gc_gpu: gpu@c0400000 {
+		compatible = "vivante,gc";
+		reg = <0xc0400000 0x2000>;
+		interrupts = <GIC_SPI 8 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gc_power>;
+		clock-names = "core";
+		samsung,t110-gpu-scaling;
+		#cooling-cells = <2>;
+		power-domains = <&gc_power>;
+	};
+	audio_sram: sram@d1004000 {
+		compatible = "mmio-sram";
+		reg = <0xd1004000 0xaa00>;
+	};
+	audio_dma: dma-controller@d42a0800 {
+		compatible = "marvell,pxa910-squ";
+		reg = <0xd42a0800 0x100>;
+		interrupts = <GIC_SPI 46 IRQ_TYPE_LEVEL_HIGH>;
+		#dma-cells = <1>;
+		asram = <&audio_sram>;
+	};
+	audio@d42a0c00 {
+		compatible = "samsung,t110-audio";
+		reg = <0xd42a0c00 0x90>, <0xd4015020 4>, <0xd4050044 4>, <0xd428281c 4>;
+		codec = <&pm805>;
+		asram = <&audio_sram>;
+		dmas = <&audio_dma 0>, <&audio_dma 1>;
+		dma-names = "tx", "rx";
+	};
+	/* 1 GiB verified from TWRP's physical RAM banks. */
+	memory@0 { device_type = "memory"; reg = <0 0x40000000>; };
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		obm@0 { reg = <0 0x00100000>; no-map; };
+		/* Preserve all vendor carveouts during bring-up. */
+		cp-pm@6000000 { reg = <0x06000000 0x02100000>; no-map; };
+		diagnostics@8100000 { reg = <0x08100000 0x00f00000>; no-map; };
+		ion@9000000 { reg = <0x09000000 0x05000000>; no-map; };
+		framebuffer@17000000 { reg = <0x17000000 0x00800000>; no-map; };
+		gpu@2c000000 { reg = <0x2c000000 0x04000000>; no-map; };
+	};
+	cpus {
+		enable-method = "marvell,pxa986-smp";
+		#address-cells = <1>;
+		#size-cells = <0>;
+		cpu0: cpu@0 { #cooling-cells = <2>; device_type = "cpu"; compatible = "arm,cortex-a9"; reg = <0>; };
+		cpu@1 { device_type = "cpu"; compatible = "arm,cortex-a9"; reg = <1>; };
+	};
+	gic: interrupt-controller@d1dff000 {
+		compatible = "arm,cortex-a9-gic";
+		#interrupt-cells = <3>;
+		#address-cells = <0>;
+		interrupt-controller;
+		reg = <0xd1dff000 0x1000>, <0xd1dfe100 0x100>;
+	};
+	l2-cache@d1dfb000 {
+		compatible = "arm,pl310-cache";
+		reg = <0xd1dfb000 0x1000>;
+		cache-unified;
+		cache-level = <2>;
+		arm,data-latency = <2 1 1>;
+		arm,tag-latency = <2 1 1>;
+	};
+	timer@d1dfe600 {
+		compatible = "arm,cortex-a9-twd-timer";
+		reg = <0xd1dfe600 0x20>;
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_EDGE_RISING)>;
+	};
+	timer@d4014000 {
+		compatible = "mrvl,mmp-timer";
+		reg = <0xd4014000 0x100>;
+		interrupts = <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>;
+	};
+	usb@d4208000 {
+		compatible = "marvell,pxa986-usb";
+		reg = <0xd4208000 0x1000>, <0xd4207000 0x200>, <0xd428285c 0x4>;
+		reg-names = "controller", "phy", "clock";
+		interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
+		dr_mode = "peripheral";
+	};
+};
diff --git a/arch/arm/configs/goyawifi_defconfig b/arch/arm/configs/goyawifi_defconfig
new file mode 100644
--- /dev/null
+++ b/arch/arm/configs/goyawifi_defconfig
@@ -0,0 +1,310 @@
+CONFIG_LOCALVERSION="-goyawifi"
+# CONFIG_LOCALVERSION_AUTO is not set
+CONFIG_KERNEL_XZ=y
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+# CONFIG_CROSS_MEMORY_ATTACH is not set
+CONFIG_NO_HZ_IDLE=y
+CONFIG_HIGH_RES_TIMERS=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_BPF_JIT=y
+CONFIG_BPF_LSM=y
+CONFIG_PSI=y
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+# CONFIG_SCHED_CACHE is not set
+CONFIG_CGROUPS=y
+CONFIG_MEMCG=y
+CONFIG_CGROUP_SCHED=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CPUSETS=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_NAMESPACES=y
+CONFIG_USER_NS=y
+CONFIG_CHECKPOINT_RESTORE=y
+CONFIG_BLK_DEV_INITRD=y
+# CONFIG_RD_BZIP2 is not set
+# CONFIG_RD_LZMA is not set
+# CONFIG_RD_LZO is not set
+# CONFIG_INITRAMFS_PRESERVE_MTIME is not set
+CONFIG_EXPERT=y
+# CONFIG_UID16 is not set
+# CONFIG_FHANDLE is not set
+# CONFIG_AIO is not set
+# CONFIG_IO_URING is not set
+# CONFIG_ADVISE_SYSCALLS is not set
+# CONFIG_MEMBARRIER is not set
+# CONFIG_RSEQ is not set
+# CONFIG_CACHESTAT_SYSCALL is not set
+CONFIG_KALLSYMS_ALL=y
+CONFIG_PERF_EVENTS=y
+# CONFIG_ARCH_MULTIPLATFORM is not set
+CONFIG_ARCH_MMP=y
+CONFIG_MACH_PXA98X_DT=y
+CONFIG_T110_INPUT_POWER=y
+CONFIG_T110_MONITOR=y
+CONFIG_T110_CPUFREQ=y
+CONFIG_T110_GPU_POWER=y
+CONFIG_T110_CAMERA_CLK=m
+# CONFIG_HARDEN_BRANCH_PREDICTOR is not set
+# CONFIG_HARDEN_BRANCH_HISTORY is not set
+# CONFIG_ARM_ERRATA_643719 is not set
+CONFIG_ARM_ERRATA_754322=y
+CONFIG_SMP=y
+# CONFIG_ARM_CPU_TOPOLOGY is not set
+CONFIG_NR_CPUS=2
+# CONFIG_ARM_PATCH_IDIV is not set
+CONFIG_HIGHMEM=y
+# CONFIG_HIGHPTE is not set
