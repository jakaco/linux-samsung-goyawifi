+		"cpu0_resumes=%u cpu0_aborts=%u ddr_level=%u ddr_cycles=%u mc_ctrl=%08x mc_status=%08x last_awucrs=%08x core_status=%08x core0=%08x core1=%08x mp0=%08x mp1=%08x apcr=%08x awucrm=%08x awucrs=%08x scu=%08x scu_power=%08x cpcr=%08x mc_sleep=%08x pwr_timer=%08x\n",
+		cpu0_resumes,cpu0_aborts,ddr_level,ddr_cycles,readl(sleep_mc+0x440),readl(sleep_mc+8),last_awucrs,readl(APMU_REG(0x90)), readl(APMU_REG(0x124)),
+		readl(APMU_REG(0x128)), readl(APMU_REG(0x120)),
+		readl(APMU_REG(0xe4)), readl(MPMU_REG(0x1000)),
+		readl(MPMU_REG(0x104c)), readl(MPMU_REG(0x1048)),
+		readl(t110_scu), readl(t110_scu+8),readl(MPMU_REG(0)),readl(APMU_REG(0xb0)),readl(APMU_REG(0x84)));
+}
