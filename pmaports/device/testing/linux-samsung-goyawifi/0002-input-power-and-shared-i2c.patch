+/* GOYA shares I2C1 with BT532 and VX5B3D. Call only after clients quiesce.
+ * GPIO87/88 MFPR offsets follow the PXA988 GPIO67..98 address map.
+ * Pins remain inputs, preserving pull/drive/sleep configuration. */
+static int goya_bus_init(struct platform_device *pdev, struct pxa_i2c *i2c)
+{
+ int ret;
+ if (!of_machine_is_compatible("samsung,goyawifi") ||
+     !device_property_read_bool(&pdev->dev,"samsung,goyawifi-shared-bus"))return 0;
+ if(i2c->iobase!=0xd4010800)return -EINVAL;
+ i2c->goya_scl=devm_gpiod_get(&pdev->dev,"sleep-scl",GPIOD_IN);
+ if(IS_ERR(i2c->goya_scl))return PTR_ERR(i2c->goya_scl);
+ i2c->goya_sda=devm_gpiod_get(&pdev->dev,"sleep-sda",GPIOD_IN);
+ if(IS_ERR(i2c->goya_sda))return PTR_ERR(i2c->goya_sda);
+ i2c->goya_mfp=devm_ioremap(&pdev->dev,0xd401e208,8);
+ if(!i2c->goya_mfp)return -ENOMEM;
+ for(int i=0;i<2;i++) {
+  i2c->goya_pins[i]=readl(i2c->goya_mfp+i*4);
+  if((i2c->goya_pins[i]&7)!=5)return -EINVAL;
+ }
+ ret=gpiod_get_value_cansleep(i2c->goya_scl);
+ if(ret<0)return ret;
+ dev_info(&pdev->dev,"GOYA bus sleep pins: %08x %08x, IBMR=%x\n",
+  i2c->goya_pins[0],i2c->goya_pins[1],readl(_IBMR(i2c)));
+ return 0;
+}
+static void goya_bus_park(struct pxa_i2c *i2c)
+{
+ if(!i2c->goya_mfp)return;
+ writel(readl(_ICR(i2c))&~ICR_IUE,_ICR(i2c));
+ for(int i=0;i<2;i++)writel(i2c->goya_pins[i]&~7,i2c->goya_mfp+i*4);
+ readl(i2c->goya_mfp);i2c->goya_parked=true;
+}
+static void goya_bus_restore(struct pxa_i2c *i2c)
+{
+ if(!i2c->goya_mfp)return;
+ for(int i=0;i<2;i++)writel(i2c->goya_pins[i],i2c->goya_mfp+i*4);
+ readl(i2c->goya_mfp);i2c->goya_parked=false;
+}
+static int goya_recovery_scl(struct i2c_adapter *adap)
+{
+ struct pxa_i2c *i2c=adap->algo_data;
+ return gpiod_get_value_cansleep(i2c->goya_scl);
+}
+static int goya_recovery_sda(struct i2c_adapter *adap)
+{
+ struct pxa_i2c *i2c=adap->algo_data;
+ return gpiod_get_value_cansleep(i2c->goya_sda);
+}
+static void goya_recovery_set_scl(struct i2c_adapter *adap,int value)
+{
+ struct pxa_i2c *i2c=adap->algo_data;
+ if(value)gpiod_direction_input(i2c->goya_scl);
+ else gpiod_direction_output(i2c->goya_scl,0);
+}
+static void goya_recovery_set_sda(struct i2c_adapter *adap,int value)
+{
+ struct pxa_i2c *i2c=adap->algo_data;
+ if(value)gpiod_direction_input(i2c->goya_sda);
+ else gpiod_direction_output(i2c->goya_sda,0);
+}
+static void goya_recovery_prepare(struct i2c_adapter *adap)
+{
+ struct pxa_i2c *i2c=adap->algo_data;
+ u32 before=readl(_IBMR(i2c)),icr=readl(_ICR(i2c)),isr=readl(_ISR(i2c));
+ i2c->goya_recovery_start=ktime_get_ns();i2c->goya_recoveries++;
+ goya_bus_park(i2c);udelay(10);
+ dev_warn(adap->dev.parent,"T110_BUS_RECOVERY: before IBMR=%x ICR=%x ISR=%x parked SCL=%d SDA=%d\n",
+          before,icr,isr,goya_recovery_scl(adap),goya_recovery_sda(adap));
+}
+static void goya_recovery_unprepare(struct i2c_adapter *adap)
+{
+ struct pxa_i2c *i2c=adap->algo_data;
+ int scl,sda;
+ gpiod_direction_input(i2c->goya_scl);gpiod_direction_input(i2c->goya_sda);
+ scl=goya_recovery_scl(adap);sda=goya_recovery_sda(adap);
+ if(scl!=1 || sda!=1)i2c->goya_recovery_failed++;
+ i2c_pxa_reset(i2c);goya_bus_restore(i2c);
+ i2c->goya_max_recovery_us=max_t(u32,i2c->goya_max_recovery_us,div_u64(ktime_get_ns()-i2c->goya_recovery_start,1000));
+ dev_warn(adap->dev.parent,"T110_BUS_RECOVERY: after GPIO SCL=%d SDA=%d IBMR=%x\n",
+          scl,sda,readl(_IBMR(i2c)));
+}
+static void goya_recovery_init(struct pxa_i2c *i2c)
+{
+ struct i2c_bus_recovery_info *bri=&i2c->recovery;
+ if(!i2c->goya_mfp || i2c->adap.bus_recovery_info)return;
+ bri->recover_bus=i2c_generic_scl_recovery;
+ bri->prepare_recovery=goya_recovery_prepare;
+ bri->unprepare_recovery=goya_recovery_unprepare;
+ bri->get_scl=goya_recovery_scl;bri->get_sda=goya_recovery_sda;
+ bri->set_scl=goya_recovery_set_scl;bri->set_sda=goya_recovery_set_sda;
+ i2c->adap.bus_recovery_info=bri;
+ dev_info(i2c->adap.dev.parent,"T110_BUS_RECOVERY: GPIO87/88 open-drain bus clear enabled\n");
+}
+
+/* Bounded component test, called by BT532 with IRQ disabled and IC asleep.
+ * Hold the adapter lock for the entire interval so other users cannot send
+ * traffic through parked pins. This never attempts CPU/system suspend. */
+int i2c_pxa_goya_sleep_test(struct i2c_adapter *adap,unsigned int seconds)
+{
+ struct pxa_i2c *i2c;int ret=0;
+ if(adap->algo!=&i2c_pxa_algorithm || seconds<1 || seconds>5)return -EINVAL;
+ i2c=adap->algo_data;if(!i2c->goya_mfp)return -EOPNOTSUPP;
+ i2c_lock_bus(adap,I2C_LOCK_ROOT_ADAPTER);
+ if(i2c->goya_parked){ret=-EBUSY;goto out;}
+ if((readl(_IBMR(i2c))&3)!=3){ret=-EBUSY;goto out;}
+ goya_bus_park(i2c);
+ if((readl(i2c->goya_mfp)&7)||(readl(i2c->goya_mfp+4)&7))ret=-EIO;
+ clk_disable(i2c->clk);
+ dev_info(adap->dev.parent,"GOYA sleep test: pins parked, clock off for %us\n",seconds);
+ msleep(seconds*1000);
+ {int error=clk_enable(i2c->clk);if(error){ret=error;goto restore;}}
+ i2c_pxa_reset(i2c);
+restore:
+ goya_bus_restore(i2c);
+ if(!ret&&(readl(_IBMR(i2c))&3)!=3)ret=-EIO;
+ dev_info(adap->dev.parent,"GOYA sleep test: restored pins=%08x,%08x IBMR=%x result=%d\n",
+  readl(i2c->goya_mfp),readl(i2c->goya_mfp+4),readl(_IBMR(i2c)),ret);
+out:
+ i2c_unlock_bus(adap,I2C_LOCK_ROOT_ADAPTER);return ret;
+}
+EXPORT_SYMBOL_GPL(i2c_pxa_goya_sleep_test);
+
+/* Cold bridge reset is serialized with every I2C client. The board callback
+ * uses PMIC I2C2 and DSI only while I2C1 pins are parked. */
+int i2c_pxa_goya_bridge_bootstrap(struct i2c_adapter *adap,
+                                int (*action)(void *),void *data)
+{
+ struct pxa_i2c *i2c;int ret,restore;
+ if(!of_machine_is_compatible("samsung,goyawifi") ||
+    adap->algo!=&i2c_pxa_algorithm || !action)return -EINVAL;
+ i2c=adap->algo_data;if(!i2c->goya_mfp)return -EOPNOTSUPP;
+ i2c_lock_bus(adap,I2C_LOCK_ROOT_ADAPTER);
+ if(i2c->goya_parked || (readl(_IBMR(i2c))&3)!=3){ret=-EBUSY;goto out;}
+ goya_bus_park(i2c);clk_disable(i2c->clk);
+ dev_info(adap->dev.parent,"T110_BRIDGE: I2C parked %08x/%08x\n",
+          readl(i2c->goya_mfp),readl(i2c->goya_mfp+4));
+ ret=action(data);
+ restore=clk_enable(i2c->clk);
+ if(!restore)i2c_pxa_reset(i2c);
+ goya_bus_restore(i2c);
+ if(restore)ret=restore;
+ if(!ret&&(readl(_IBMR(i2c))&3)!=3)ret=-EIO;
+ dev_info(adap->dev.parent,"T110_BRIDGE: I2C restored %08x/%08x IBMR=%x result=%d\n",
+          readl(i2c->goya_mfp),readl(i2c->goya_mfp+4),readl(_IBMR(i2c)),ret);
+out:
+ i2c_unlock_bus(adap,I2C_LOCK_ROOT_ADAPTER);return ret;
+}
+EXPORT_SYMBOL_GPL(i2c_pxa_goya_bridge_bootstrap);
+
+/* Called in the bridge's late-suspend phase, after all regular client
+ * callbacks stopped touch and scanout. Pins remain parked across CPU sleep. */
+int i2c_pxa_goya_bridge_suspend(struct i2c_adapter *adap,
+                              int (*off)(void *),int (*on)(void *),
+                              void *data,struct module *owner)
+{
+ struct pxa_i2c *i2c;int ret,repair;
+ if(!of_machine_is_compatible("samsung,goyawifi") ||
+    adap->algo!=&i2c_pxa_algorithm || !off || !on)return -EINVAL;
+ i2c=adap->algo_data;if(!i2c->goya_mfp)return -EOPNOTSUPP;
+ if(!try_module_get(owner))return -ENODEV;
+ i2c_lock_bus(adap,I2C_LOCK_ROOT_ADAPTER);
+ if(i2c->goya_parked || i2c->goya_bridge_held ||
+    (readl(_IBMR(i2c))&3)!=3){ret=-EBUSY;goto release;}
+ goya_bus_park(i2c);
+ ret=off(data);
+ if(ret){
+  /* Restore a powered/programmed slave before reconnecting its pins. */
+  repair=on(data);
+  if(!repair){i2c_pxa_reset(i2c);goya_bus_restore(i2c);goto release;}
+  dev_err(adap->dev.parent,"T110_BRIDGE_PM: off rollback failed %d\n",repair);
+ }
+ i2c->goya_bridge_held=true;i2c->goya_bridge_on=on;
+ i2c->goya_bridge_data=data;i2c->goya_bridge_owner=owner;
+ /* The root adapter lock is already held. The public mark helper would
+  * recursively acquire it; update its protected flag directly here. */
+ set_bit(I2C_ALF_IS_SUSPENDED,&adap->locked_flags);
+ dev_info(adap->dev.parent,"T110_BRIDGE_PM: pins held parked across suspend, off_result=%d\n",ret);
+ i2c_unlock_bus(adap,I2C_LOCK_ROOT_ADAPTER);return ret;
+release:
+ i2c_unlock_bus(adap,I2C_LOCK_ROOT_ADAPTER);module_put(owner);return ret;
+}
+EXPORT_SYMBOL_GPL(i2c_pxa_goya_bridge_suspend);
+
+static int goya_bridge_resume_early(struct pxa_i2c *i2c)
+{
+ int ret;struct module *owner;
+ if(!i2c->goya_bridge_held)return 0;
+ i2c_lock_bus(&i2c->adap,I2C_LOCK_ROOT_ADAPTER);
+ ret=i2c->goya_bridge_on(i2c->goya_bridge_data);
+ if(!ret){
+  i2c_pxa_reset(i2c);goya_bus_restore(i2c);
+  if((readl(_IBMR(i2c))&3)!=3)ret=-EIO;
+ }
+ if(ret){
+  goya_bus_park(i2c);
+  dev_err(i2c->adap.dev.parent,"T110_BRIDGE_PM: resume failed %d; bus kept parked\n",ret);
+  i2c_unlock_bus(&i2c->adap,I2C_LOCK_ROOT_ADAPTER);return ret;
+ }
+ owner=i2c->goya_bridge_owner;i2c->goya_bridge_held=false;
+ i2c->goya_bridge_on=NULL;i2c->goya_bridge_data=NULL;i2c->goya_bridge_owner=NULL;
+ dev_info(i2c->adap.dev.parent,"T110_BRIDGE_PM: bridge ready, pins restored %08x/%08x IBMR=%x\n",
+          readl(i2c->goya_mfp),readl(i2c->goya_mfp+4),readl(_IBMR(i2c)));
+ i2c_unlock_bus(&i2c->adap,I2C_LOCK_ROOT_ADAPTER);module_put(owner);return 0;
+}
