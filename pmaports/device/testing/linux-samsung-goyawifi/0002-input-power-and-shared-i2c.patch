diff --git a/drivers/power/supply/t110-smb328.c b/drivers/power/supply/t110-smb328.c
new file mode 100644
--- /dev/null
+++ b/drivers/power/supply/t110-smb328.c
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Board-scoped SM-T110 SMB328 control, from pinned Samsung vendor programming.
+ * RT8973 is read-only here: do not change its USB routing/interrupts.
+ * The PM822 measures voltage/temperature, not battery current/coulombs.
+ */
+#include <linux/module.h>
+#include <linux/i2c.h>
+#include <linux/mutex.h>
+#include <linux/power_supply.h>
+#include <linux/workqueue.h>
+#include <linux/jiffies.h>
+struct t110_charger {
+ struct i2c_client *client,*muic;
+ struct power_supply *battery,*psy;
+ struct mutex lock;
+ struct delayed_work poll;
+ bool online,hot,cold,inhibit,limit_hold,expired,charge_on,configured;
+ int status,health,usb_type,input_ua,fast_ua,temp,voltage,capacity,limit;
+ int command,stat_c,fault,source,last_error,watchdog_recoveries;
+ unsigned long session_start;
+};
+static int rd(struct i2c_client *c,u8 reg)
+{ return i2c_smbus_read_byte_data(c,reg); }
+static int wr(struct t110_charger *c,u8 reg,u8 value)
+{
+ int ret=i2c_smbus_write_byte_data(c->client,reg,value),r;
+ if(ret<0)return ret;
+ r=rd(c->client,reg);
+ return r<0?r:(r==value?0:-EIO);
+}
+/* Called under lock. Disable first; close configuration write gate last. */
+static int configure(struct t110_charger *c,bool dedicated)
+{
+ int ret,cmd=rd(c->client,0x31),v;
+ if(cmd<0)return cmd;
+ cmd=(cmd|0x90)&~0x0c; /* writable, disabled, no boost request */
+ ret=wr(c,0x31,cmd);if(ret)return ret;
+ ret=wr(c,5,0);if(ret)goto close; /* command controls charge enable */
+ ret=wr(c,4,0x6e);if(ret)goto close; /* vendor polled/IRQ-disabled setup */
+ ret=wr(c,3,0xda);if(ret)goto close; /* vendor function control A */
+ v=rd(c->client,2);if(v<0){ret=v;goto close;}
+ ret=wr(c,2,(v&~0x7e)|(43<<1));if(ret)goto close; /* 4320mV <= vendor 4330mV */
+ v=rd(c->client,0);if(v<0){ret=v;goto close;}
+ /* USB: lowest 450mA setting; DCP: 1000mA, below vendor1550mA. Term200mA. */
+ ret=wr(c,0,(v&0x18)|(dedicated?0xa0:0)|7);if(ret)goto close;
+ v=rd(c->client,1);if(v<0){ret=v;goto close;}
+ ret=wr(c,1,(v&0x18)|(dedicated?0xa0:0));if(ret)goto close; /* AICL on,4.25V */
+ v=rd(c->client,7);if(v<0){ret=v;goto close;}
+ ret=wr(c,7,(v&0x1f)|0xe0);if(ret)goto close;
+ v=rd(c->client,6);if(v<0){ret=v;goto close;}
+ ret=wr(c,6,v&~0x20);if(ret)goto close; /* never source VBUS */
+ cmd|=dedicated?0x0c:0x08; /* AC mode only on positively identified DCP */
+close:
+ {
+  int r=wr(c,0x31,cmd&~0x80);
+  if(!ret)ret=r;
+ }
+ c->charge_on=false;
+ if(!ret){c->configured=true;c->input_ua=dedicated?1000000:500000;c->fast_ua=dedicated?1000000:450000;}
+ return ret;
+}
+static int enable(struct t110_charger *c,bool on)
+{
+ int cmd=rd(c->client,0x31),ret;
+ if(cmd<0)return cmd;
+ cmd&=~0x80;
+ if(on)cmd&=~0x10;else cmd|=0x10;
+ ret=wr(c,0x31,cmd);
+ if(!ret){c->charge_on=on;c->command=cmd;}
+ return ret;
+}
+static int battery_value(struct t110_charger *c,enum power_supply_property p,int *out)
+{
+ union power_supply_propval v;int ret=power_supply_get_property(c->battery,p,&v);
+ if(!ret)*out=v.intval;
+ return ret;
+}
+static void update(struct t110_charger *c)
+{
+ union power_supply_propval v;
+ struct power_supply *usb=power_supply_get_by_name("t110-usb");
+ bool online,dcp,on;int ret,src,stat,fault,voltage,temp;
+ if(!usb){ret=-ENODEV;goto fail;}
+ ret=power_supply_get_property(usb,POWER_SUPPLY_PROP_ONLINE,&v);
+ power_supply_put(usb);if(ret)goto fail;
+ online=!!v.intval;
+ ret=battery_value(c,POWER_SUPPLY_PROP_TEMP,&temp);if(ret)goto fail;
+ ret=battery_value(c,POWER_SUPPLY_PROP_VOLTAGE_AVG,&voltage);if(ret)goto fail;
+ src=rd(c->muic,0x0a);if(src<0){ret=src;goto fail;}
+ /* Strict single DCP flag; unknown/CDP/SDP all get USB500mA ceiling. */
+ dcp=online&&src==0x40;
+ if(online&&!c->online){
+  c->session_start=jiffies;c->expired=false;
+  ret=enable(c,false);if(ret)goto fail;
+  /* Discard the previous cable session's latched input/watchdog IRQs. */
+  ret=i2c_smbus_write_byte_data(c->client,0x30,0xff);if(ret<0)goto fail;
+  c->configured=false;
+ }
+ if(!online){c->expired=false;c->session_start=0;}
+ c->online=online;c->source=src;c->temp=temp;c->voltage=voltage;
+ ret=battery_value(c,POWER_SUPPLY_PROP_CAPACITY,&c->capacity);if(ret)goto fail;
+ c->usb_type=dcp?POWER_SUPPLY_USB_TYPE_DCP:
+  (src==4?POWER_SUPPLY_USB_TYPE_SDP:(src==0x20?POWER_SUPPLY_USB_TYPE_CDP:POWER_SUPPLY_USB_TYPE_UNKNOWN));
+ if(!c->configured||c->input_ua!=(dcp?1000000:500000)) {
+  ret=configure(c,dcp);if(ret)goto fail;
+ }
+ if(temp>=450)c->hot=true;else if(temp<=420)c->hot=false;
+ if(temp<=0)c->cold=true;else if(temp>=30)c->cold=false;
+ if(online&&time_after(jiffies,c->session_start+6*60*60*HZ))c->expired=true;
+ if(c->limit<100&&c->capacity>=c->limit)c->limit_hold=true;
+ if(c->limit==100||c->capacity<=c->limit-5)c->limit_hold=false;
+ fault=rd(c->client,0x37);if(fault<0){ret=fault;goto fail;}
+ /* Samsung's SMB328 watchdog recovery: stop, acknowledge IRQ, reapply
+  * the bounded profile. This does not restart our six-hour session timer. */
+ if(online&&(fault&0x80)) {
+  ret=enable(c,false);if(ret)goto fail;
+  ret=i2c_smbus_write_byte_data(c->client,0x30,0xff);if(ret<0)goto fail;
+  ret=configure(c,dcp);if(ret)goto fail;
+  c->watchdog_recoveries++;
+  fault=rd(c->client,0x37);if(fault<0){ret=fault;goto fail;}
+ }
+ c->fault=fault;
+ c->health=c->hot?POWER_SUPPLY_HEALTH_OVERHEAT:
+  c->cold?POWER_SUPPLY_HEALTH_COLD:
+  (online&&(fault&6))?POWER_SUPPLY_HEALTH_UNSPEC_FAILURE:
+  c->expired?POWER_SUPPLY_HEALTH_SAFETY_TIMER_EXPIRE:
+  (online&&(fault&0x80))?POWER_SUPPLY_HEALTH_WATCHDOG_TIMER_EXPIRE:POWER_SUPPLY_HEALTH_GOOD;
+ on=online&&!c->inhibit&&!c->limit_hold&&c->health==POWER_SUPPLY_HEALTH_GOOD&&voltage<4400000;
+ ret=enable(c,on);if(ret)goto fail;
+ stat=rd(c->client,0x36);if(stat<0){ret=stat;goto fail;}
+ c->stat_c=stat;
+ c->status=!online?POWER_SUPPLY_STATUS_DISCHARGING:
+  !on?POWER_SUPPLY_STATUS_NOT_CHARGING:
+  (stat&0xc0)?POWER_SUPPLY_STATUS_FULL:
+  ((stat&1)&&!(stat&0x30)&&(stat&6))?POWER_SUPPLY_STATUS_CHARGING:POWER_SUPPLY_STATUS_NOT_CHARGING;
+ if(voltage>=4400000)c->health=POWER_SUPPLY_HEALTH_OVERVOLTAGE;
+ c->last_error=0;return;
+fail:
+ enable(c,false);c->configured=false;c->last_error=ret;
+ c->status=POWER_SUPPLY_STATUS_UNKNOWN;c->health=POWER_SUPPLY_HEALTH_UNSPEC_FAILURE;
+}
+static void poll(struct work_struct *work)
+{
+ struct t110_charger *c=container_of(to_delayed_work(work),struct t110_charger,poll);
+ int status,health,cap,source;
+ mutex_lock(&c->lock);
+ status=c->status;health=c->health;cap=c->capacity;source=c->source;
+ update(c);
+ if(status!=c->status||health!=c->health||cap!=c->capacity||source!=c->source) {
+  power_supply_changed(c->psy);power_supply_changed(c->battery);
+ }
+ mutex_unlock(&c->lock);
+ schedule_delayed_work(&c->poll,2*HZ);
+}
+static enum power_supply_property props[]={POWER_SUPPLY_PROP_ONLINE,POWER_SUPPLY_PROP_USB_TYPE,
+ POWER_SUPPLY_PROP_STATUS,POWER_SUPPLY_PROP_HEALTH,POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT,
+ POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT,POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE,
+ POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR};
+static int get(struct power_supply *psy,enum power_supply_property p,union power_supply_propval *v)
+{
+ struct t110_charger *c=power_supply_get_drvdata(psy);int ret=0;
+ mutex_lock(&c->lock);
+ switch(p) {
+ case POWER_SUPPLY_PROP_ONLINE:v->intval=c->online;break;
+ case POWER_SUPPLY_PROP_USB_TYPE:v->intval=c->usb_type;break;
+ case POWER_SUPPLY_PROP_STATUS:v->intval=c->status;break;
+ case POWER_SUPPLY_PROP_HEALTH:v->intval=c->health;break;
+ case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:v->intval=c->input_ua;break;
+ case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:v->intval=c->fast_ua;break;
+ case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE:v->intval=4320000;break;
+ case POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR:v->intval=c->inhibit?POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE:POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;break;
+ default:ret=-EINVAL;
+ }
+ mutex_unlock(&c->lock);return ret;
+}
+static int set(struct power_supply *psy,enum power_supply_property p,const union power_supply_propval *v)
+{
+ struct t110_charger *c=power_supply_get_drvdata(psy);
+ if(p!=POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR)return -EINVAL;
+ if(v->intval!=POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO&&v->intval!=POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)return -EINVAL;
+ mutex_lock(&c->lock);c->inhibit=v->intval==POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+ update(c);mutex_unlock(&c->lock);power_supply_changed(psy);return c->last_error;
+}
+static int writable(struct power_supply *psy,enum power_supply_property p)
+{ return p==POWER_SUPPLY_PROP_CHARGE_BEHAVIOUR; }
+static ssize_t state_show(struct device *dev,struct device_attribute *a,char *buf)
+{
+ struct t110_charger *c=dev_get_drvdata(dev);int n;
+ mutex_lock(&c->lock);
+ n=sysfs_emit(buf,"online=%d source=%02x command=%02x status_c=%02x fault=%02x enabled=%d temp_deciC=%d voltage_uV=%d estimated_percent=%d limit=%d limit_hold=%d hot=%d cold=%d timeout=%d error=%d watchdog_recoveries=%d\n",
+ c->online,c->source,c->command,c->stat_c,c->fault,c->charge_on,c->temp,c->voltage,c->capacity,c->limit,c->limit_hold,c->hot,c->cold,c->expired,c->last_error,c->watchdog_recoveries);
+ mutex_unlock(&c->lock);return n;
+}
+static DEVICE_ATTR_RO(state);
+static ssize_t charge_limit_show(struct device *dev,struct device_attribute *a,char *buf)
+{ struct t110_charger *c=dev_get_drvdata(dev);return sysfs_emit(buf,"%d\n",c->limit); }
+static ssize_t charge_limit_store(struct device *dev,struct device_attribute *a,const char *buf,size_t count)
+{
+ struct t110_charger *c=dev_get_drvdata(dev);int limit,ret=kstrtoint(buf,10,&limit);
+ if(ret)return ret;
+ if(limit<50||limit>100)return -EINVAL;
+ mutex_lock(&c->lock);c->limit=limit;update(c);ret=c->last_error;mutex_unlock(&c->lock);
+ power_supply_changed(c->psy);return ret?ret:count;
+}
+static DEVICE_ATTR_RW(charge_limit);
+static struct attribute *charger_attrs[]={&dev_attr_state.attr,&dev_attr_charge_limit.attr,NULL};
+static const struct attribute_group charger_group={.attrs=charger_attrs};
+static const struct power_supply_desc desc={.name="t110-charger",.type=POWER_SUPPLY_TYPE_USB,
+ .properties=props,.num_properties=ARRAY_SIZE(props),.get_property=get,.set_property=set,
+ .property_is_writeable=writable,.usb_types=BIT(POWER_SUPPLY_USB_TYPE_UNKNOWN)|BIT(POWER_SUPPLY_USB_TYPE_SDP)|BIT(POWER_SUPPLY_USB_TYPE_CDP)|BIT(POWER_SUPPLY_USB_TYPE_DCP),
+ .charge_behaviours=BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO)|BIT(POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE)};
+static void put_battery(void *data){power_supply_put(data);}
+static void unregister_muic(void *data){i2c_unregister_device(data);}
+static void stop(void *data)
+{
+ struct t110_charger *c=data;cancel_delayed_work_sync(&c->poll);
+ mutex_lock(&c->lock);enable(c,false);mutex_unlock(&c->lock);
+}
+static int probe(struct i2c_client *client)
+{
+ struct t110_charger *c;struct i2c_adapter *bus;struct power_supply_config cfg={};int ret,id;
+ if(!of_machine_is_compatible("samsung,goyawifi"))return -ENODEV;
+ c=devm_kzalloc(&client->dev,sizeof(*c),GFP_KERNEL);if(!c)return -ENOMEM;
+ c->client=client;c->limit=100;mutex_init(&c->lock);INIT_DELAYED_WORK(&c->poll,poll);
+ c->battery=power_supply_get_by_name("t110-battery");if(!c->battery)return -EPROBE_DEFER;
+ ret=devm_add_action_or_reset(&client->dev,put_battery,c->battery);if(ret)return ret;
+ bus=i2c_get_adapter(7);if(!bus)return -EPROBE_DEFER;
+ c->muic=i2c_new_dummy_device(bus,0x14);i2c_put_adapter(bus);
+ if(IS_ERR(c->muic))return PTR_ERR(c->muic);
+ ret=devm_add_action_or_reset(&client->dev,unregister_muic,c->muic);if(ret)return ret;
+ id=rd(c->muic,1);if(id!=0x0a)return dev_err_probe(&client->dev,id<0?id:-ENODEV,"Expected board RT8973 ID0a\n");
+ i2c_set_clientdata(client,c);cfg.drv_data=c;
+ c->psy=devm_power_supply_register(&client->dev,&desc,&cfg);if(IS_ERR(c->psy))return PTR_ERR(c->psy);
+ ret=devm_add_action_or_reset(&client->dev,stop,c);if(ret)return ret;
+ ret=devm_device_add_group(&client->dev,&charger_group);if(ret)return ret;
+ schedule_delayed_work(&c->poll,0);
+ dev_info(&client->dev,"SM-T110 SMB328 + read-only RT8973; USB500/DCP1000mA; float4320mV; thermal0..45C\n");
+ return 0;
+}
+static void shutdown(struct i2c_client *client){stop(i2c_get_clientdata(client));}
+static const struct i2c_device_id ids[]={{"t110-smb328"},{}};
+MODULE_DEVICE_TABLE(i2c,ids);
+static const struct of_device_id match[]={{.compatible="samsung,t110-smb328"},{}};
+MODULE_DEVICE_TABLE(of,match);
+static struct i2c_driver charger_driver={.probe=probe,.shutdown=shutdown,.id_table=ids,
+ .driver={.name="t110-smb328",.of_match_table=match}};
+module_i2c_driver(charger_driver);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("SM-T110 SMB328 charging and battery policy");
