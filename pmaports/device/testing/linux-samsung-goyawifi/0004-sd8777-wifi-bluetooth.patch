 #include "btmrvl_sdio.h"
 
 #define VERSION "1.0"
+
+/* Optional per-device provisioning, applied before the normal HCI init reads
+ * the public address. No post-registration down/reset management race.
+ */
+static char *bdaddr;
+module_param(bdaddr, charp, 0400);
+MODULE_PARM_DESC(bdaddr, "Provisioned public Bluetooth address (XX:XX:XX:XX:XX:XX)");
+static int btmrvl_set_bdaddr(struct hci_dev *hdev, const bdaddr_t *address);
+
 
 /*
  * This function is called by interface specific interrupt handler.
@@ -557,11 +569,29 @@
 
 	btmrvl_pscan_window_reporting(priv, 0x01);
 
-	priv->btmrvl_dev.psmode = 1;
+	/* SD8777 shares card sleep with WLAN. Keep autonomous BT sleep disabled
+	 * until its interaction with cfg80211 interface-down is validated.
+	 */
+	priv->btmrvl_dev.psmode =
+		((struct btmrvl_sdio_card *)priv->btmrvl_dev.card)->func->device !=
+		SDIO_DEVICE_ID_MARVELL_8777_BT;
 	btmrvl_enable_ps(priv);
 
 	btmrvl_send_hscfg_cmd(priv);
 
+	if (bdaddr) {
+		bdaddr_t address;
+		u8 mac[6];
+		int i;
+
+		if (!mac_pton(bdaddr, mac) || !is_valid_ether_addr(mac))
+			return -EINVAL;
+		for (i = 0; i < 6; i++)
+			address.b[i] = mac[5 - i];
+		ret = btmrvl_set_bdaddr(hdev, &address);
+		if (ret)
+			return ret;
+	}
 	return 0;
 }
 
