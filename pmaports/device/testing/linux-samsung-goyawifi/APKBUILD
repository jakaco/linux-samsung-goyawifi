# Local overlay. Set a real maintainer before submitting upstream.
maintainer=""
_flavor=samsung-goyawifi
pkgname=linux-$_flavor
pkgver=7.3_rc7
pkgrel=10
pkgdesc="Samsung SM-T110 PXA986 close-to-mainline kernel"
arch="armv7"
_carch="arm"
url="https://kernel.org"
license="GPL-2.0-only"
options="!check !strip !tracedeps pmb:cross-native pmb:kconfigcheck-default pmb:kconfigcheck-nftables pmb:kconfigcheck-usb pmb:kconfigcheck-usb_gadgets pmb:kconfigcheck-zram pmb:kconfigcheck-iwd pmb:kconfigcheck-wireguard"
makedepends="bc bison clang dtc elfutils-dev findutils flex linux-headers lld llvm openssl-dev pahole>=1.26 perl postmarketos-installkernel python3 zstd"
_commit=f909e534f5e34feb2ea2701d54df63e21aa506fc
_config=config-$_flavor.$arch
source="
 linux-$_commit.tar.gz::https://github.com/torvalds/linux/archive/$_commit.tar.gz
 $_config
 0001-arm-pxa986-goyawifi-platform.patch
 0002-input-power-and-shared-i2c.patch
 0003-display-gpu-audio-camera-and-vpu.patch
 0004-sd8777-wifi-bluetooth.patch
"
builddir="$srcdir/linux-$_commit"
prepare() {
 default_prepare
 cp "$srcdir/$_config" "$builddir/.config"
}
build() {
 unset LDFLAGS
 make ARCH="$_carch" LLVM=1 KBUILD_BUILD_VERSION="$((pkgrel+1))-$_flavor" olddefconfig
 make ARCH="$_carch" LLVM=1 KBUILD_BUILD_VERSION="$((pkgrel+1))-$_flavor" zImage modules marvell/pxa986-samsung-goyawifi.dtb
}
package() {
 make ARCH="$_carch" LLVM=1 INSTALL_MOD_STRIP=1 INSTALL_MOD_PATH="$pkgdir/usr" modules_install
 install -Dm644 arch/arm/boot/zImage "$pkgdir/boot/vmlinuz"
 install -Dm644 System.map "$pkgdir/boot/System.map"
 install -Dm644 .config "$pkgdir/boot/config"
 install -Dm644 arch/arm/boot/dts/marvell/pxa986-samsung-goyawifi.dtb "$pkgdir/boot/dtbs/marvell/pxa986-samsung-goyawifi.dtb"
 install -Dm644 include/config/kernel.release "$pkgdir/usr/share/kernel/$_flavor/kernel.release"
 rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
}

