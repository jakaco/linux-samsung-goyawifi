# Local board-specific packer using the standard boot-deploy PXA interface.
maintainer=""
pkgname=goyawifi-mkbootimg
pkgver=1
pkgrel=0
pkgdesc="SM-T110 distro initramfs/DT handoff for Samsung's legacy loader"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
depends="python3 dtc"
checkdepends="python3 dtc"
provides="pxa-mkbootimg=1"
source="goyawifi-mkbootimg test-image-layout.py"
builddir="$srcdir"
check() { python3 test-image-layout.py; }
package() {
 install -Dm755 goyawifi-mkbootimg "$pkgdir/usr/bin/goyawifi-mkbootimg"
 ln -s goyawifi-mkbootimg "$pkgdir/usr/bin/pxa-mkbootimg"
}

